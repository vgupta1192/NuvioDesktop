+package com.nuvio.app.features.player
+
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/**
+ * English subtitles generated on the device from the audio (speech recognition + translation), for
+ * titles without usable subtitles. Offered as one extra entry in the subtitle list; the platform
+ * that can generate them sets [supported] and does the work when that entry is attached.
+ */
+object GeneratedSubtitles {
+    /** Pseudo address of the generated subtitle; the ".srt" ending lets it use the sidecar path. */
+    const val URL = "nuvio-generated://subtitles/english.srt"
+    /** The online variant: Whisper large-v3 on Groq (the user's key). */
+    const val ONLINE_URL = "nuvio-generated://groq/english.srt"
+    private const val SCHEME = "nuvio-generated://"
+
+    /** Spoken languages the recogniser can be told to expect; [AUTO] follows the audio track's tag. */
+    const val AUTO = "auto"
+    val spokenLanguages: List<Pair<String, String>> = listOf(
+        AUTO to "Auto (audio track tag, else detected)",
+        "zh" to "Chinese",
+        "yue" to "Cantonese",
+        "ja" to "Japanese",
+        "ko" to "Korean",
+        "en" to "English",
+        "hi" to "Hindi",
+        "ur" to "Urdu",
+        "bn" to "Bengali",
+        "ta" to "Tamil",
+        "te" to "Telugu",
+        "ml" to "Malayalam",
+        "kn" to "Kannada",
+        "mr" to "Marathi",
+        "gu" to "Gujarati",
+        "pa" to "Punjabi",
+        "th" to "Thai",
+        "id" to "Indonesian",
+        "ms" to "Malay",
+        "tl" to "Filipino (Tagalog)",
+        "vi" to "Vietnamese",
+        "tr" to "Turkish",
+        "ar" to "Arabic",
+        "fa" to "Persian",
+        "ru" to "Russian",
+        "uk" to "Ukrainian",
+        "pl" to "Polish",
+        "es" to "Spanish",
+        "pt" to "Portuguese",
+        "fr" to "French",
+        "de" to "German",
+        "it" to "Italian",
+        "nl" to "Dutch",
+        "sv" to "Swedish",
+        "el" to "Greek",
+        "he" to "Hebrew",
+    )
+
+    /** When Nuvio picks the generated subtitle by itself. */
+    const val MODE_OFF = "off"
+    const val MODE_MISSING = "missing"
+    const val MODE_ALWAYS = "always"
+    val modes: List<Pair<String, String>> = listOf(
+        MODE_OFF to "Never (pick it by hand from the subtitle list)",
+        MODE_MISSING to "When no subtitle in your language is found",
+        MODE_ALWAYS to "Always, even when subtitles exist",
+    )
+
+    /** The playing title/episode (e.g. "tt2907640:1:3"); generated lines are saved per title. */
+    var contentId: String? = null
+
+    /** Set by a platform that can generate subtitles (Android). */
+    var supported: Boolean = false
+
+    /** Model download/delete, registered by the platform. */
+    var modelActions: GeneratedSubtitleModelActions? = null
+
+    private val _mode = MutableStateFlow(MODE_OFF)
+    /** When the generated subtitle is picked automatically (see [modes]). */
+    val mode: StateFlow<String> = _mode.asStateFlow()
+
+    private val _spokenLanguage = MutableStateFlow(AUTO)
+    val spokenLanguage: StateFlow<String> = _spokenLanguage.asStateFlow()
+
+    private val _fastAsianModel = MutableStateFlow(false)
+    /**
+     * For Indian, South-East Asian, Arabic, Persian and Russian audio with a known language: the
+     * faster Dolphin model plus translation (true) or Whisper, slower but often more accurate.
+     */
+    val fastAsianModel: StateFlow<Boolean> = _fastAsianModel.asStateFlow()
+
+    fun setFastAsianModel(value: Boolean) {
+        _fastAsianModel.value = value
+        save?.invoke(KEY_FAST_ASIAN, value.toString())
+    }
+
+    private val _highQuality = MutableStateFlow(true)
+    /** Whisper medium (more accurate, about twice as slow) instead of Whisper small. */
+    val highQuality: StateFlow<Boolean> = _highQuality.asStateFlow()
+
+    fun setHighQuality(value: Boolean) {
+        _highQuality.value = value
+        save?.invoke(KEY_HIGH_QUALITY, value.toString())
+    }
+
+    private val _groqKey = MutableStateFlow("")
+    /** The user's Groq API key; when set, the subtitle list also offers the online generated subtitle. */
+    val groqKey: StateFlow<String> = _groqKey.asStateFlow()
+
+    fun setGroqKey(value: String) {
+        _groqKey.value = value.trim()
+        save?.invoke(KEY_GROQ, value.trim())
+    }
+
+    private val _deeplKey = MutableStateFlow("")
+    /** The user's DeepL API key; when set, Whisper writes the spoken language down and DeepL translates. */
+    val deeplKey: StateFlow<String> = _deeplKey.asStateFlow()
+
+    fun setDeeplKey(value: String) {
+        _deeplKey.value = value.trim()
+        save?.invoke(KEY_DEEPL, value.trim())
+    }
+
+    private val _models = MutableStateFlow("")
+    /** One-line summary of the downloaded models, for Settings. */
+    val models: StateFlow<String> = _models.asStateFlow()
+
+    private var save: ((key: String, value: String) -> Unit)? = null
+
+    fun installPersistence(load: (key: String) -> String?, save: (key: String, value: String) -> Unit) {
+        this.save = save
+        _mode.value = load(KEY_MODE)?.takeIf { code -> modes.any { it.first == code } }
+            ?: if (load(KEY_AUTO) == "true") MODE_MISSING else MODE_OFF
+        _fastAsianModel.value = load(KEY_FAST_ASIAN) == "true"
+        _highQuality.value = load(KEY_HIGH_QUALITY) != "false"
+        _deeplKey.value = load(KEY_DEEPL).orEmpty()
+        _groqKey.value = load(KEY_GROQ).orEmpty()
+        _spokenLanguage.value = load(KEY_LANGUAGE)?.takeIf { code -> spokenLanguages.any { it.first == code } } ?: AUTO
+    }
+
+    fun cycleMode() {
+        val index = modes.indexOfFirst { it.first == _mode.value }
+        _mode.value = modes[(index + 1) % modes.size].first
+        save?.invoke(KEY_MODE, _mode.value)
+    }
+
+    fun modeLabel(code: String = _mode.value): String = modes.firstOrNull { it.first == code }?.second ?: code
+
+    fun setSpokenLanguage(code: String) {
+        _spokenLanguage.value = code
+        save?.invoke(KEY_LANGUAGE, code)
+    }
+
+    /** The next spoken language in [spokenLanguages], for a row that cycles through them. */
+    fun cycleSpokenLanguage() {
+        val index = spokenLanguages.indexOfFirst { it.first == _spokenLanguage.value }
+        setSpokenLanguage(spokenLanguages[(index + 1) % spokenLanguages.size].first)
+    }
+
+    fun spokenLanguageLabel(code: String = _spokenLanguage.value): String =
+        spokenLanguages.firstOrNull { it.first == code }?.second ?: code
+
+    fun publishModels(summary: String) {
+        _models.value = summary
+    }
+
+    fun isGenerated(url: String?): Boolean = url?.startsWith(SCHEME) == true
+
+    val entry: AddonSubtitle
+        get() = AddonSubtitle(
+            id = "nuvio-generated-english",
+            url = URL,
+            language = "en",
+            display = "English · Generated from the audio (on this device)",
+            addonName = "Nuvio",
+        )
+
+    val onlineEntry: AddonSubtitle
+        get() = AddonSubtitle(
+            id = "nuvio-generated-english-online",
+            url = ONLINE_URL,
+            language = "en",
+            display = "English · Generated online (Groq Whisper large-v3)",
+            addonName = "Nuvio",
+        )
+
+    /**
+     * [subtitles] plus the generated entries, last so a real subtitle always comes first; the
+     * online one (only with a Groq key) before the on-device one.
+     */
+    fun withEntry(subtitles: List<AddonSubtitle>): List<AddonSubtitle> {
+        if (!supported) return subtitles
+        val real = subtitles.filterNot { isGenerated(it.url) }
+        val online = if (_groqKey.value.isNotBlank()) listOf(onlineEntry) else emptyList()
+        return real + online + entry
+    }
+
+    private const val KEY_AUTO = "auto_generate"
+    private const val KEY_MODE = "auto_mode"
+    private const val KEY_LANGUAGE = "spoken_language"
+    private const val KEY_FAST_ASIAN = "fast_asian_model"
+    private const val KEY_HIGH_QUALITY = "high_quality"
+    private const val KEY_DEEPL = "deepl_key"
+    private const val KEY_GROQ = "groq_key"
+}
+
+interface GeneratedSubtitleModelActions {
+    fun deleteModels()
+}
