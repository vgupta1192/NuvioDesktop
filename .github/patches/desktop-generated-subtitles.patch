+// the calling thread - Kotlin dispatches it to IO.
+extern "C" JNIEXPORT jboolean JNICALL
+Java_com_nuvio_app_features_player_desktop_NativePlayerBridge_dumpAudioWav(
+    JNIEnv *env,
+    jobject /* bridge */,
+    jstring jurl,
+    jobjectArray jheaders,
+    jstring jout,
+    jdouble startSec,
+    jdouble endSec
+) {
