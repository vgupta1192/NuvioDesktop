--- /dev/null
+++ b/composeApp/src/desktopMain/kotlin/com/nuvio/app/features/player/SubtitleFontStore.kt
@@ -0,0 +1,154 @@
+package com.nuvio.app.features.player
+
+import com.nuvio.app.core.storage.DesktopStorage
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.withContext
+import java.io.File
+import java.io.RandomAccessFile
+
+/**
+ * Keeps at most one user-imported subtitle font in app storage. The font file itself is the
+ * persisted setting; the family name (parsed from the font's name table) is what mpv/libass
+ * matches fonts by.
+ */
+internal class CustomSubtitleFont(
+    val file: File,
+    /** Family name from the font's `name` table; libass (mpv) matches fonts by it. */
+    val familyName: String,
+)
+
+internal object SubtitleFontStore {
+    private const val MAX_FONT_BYTES = 30L * 1024 * 1024
+
+    private val _font = MutableStateFlow<CustomSubtitleFont?>(null)
+    val font: StateFlow<CustomSubtitleFont?> = _font.asStateFlow()
+
+    @Volatile
+    private var loaded = false
+
+    fun fontsDir(): File =
+        File(DesktopStorage.rootDir.toFile(), "subtitle_fonts").apply { mkdirs() }
+
+    /** Returns the imported font, loading it from disk on first use. */
+    fun current(): CustomSubtitleFont? {
+        if (!loaded) {
+            synchronized(this) {
+                if (!loaded) {
+                    _font.value = fontsDir().listFiles()
+                        ?.firstOrNull { it.isFile }
+                        ?.let(::loadFont)
+                    loaded = true
+                }
+            }
+        }
+        return _font.value
+    }
+
+    suspend fun import(source: File): Boolean = withContext(Dispatchers.IO) {
+        val extension = source.name.substringAfterLast('.', "").lowercase()
+            ?.takeIf { it == "ttf" || it == "otf" } ?: "ttf"
+        val dir = fontsDir()
+        val staging = File(dir, ".import.tmp")
+        val copied = runCatching {
+            source.inputStream().use { input ->
+                staging.outputStream().use { output ->
+                    val buffer = ByteArray(64 * 1024)
+                    var total = 0L
+                    while (true) {
+                        val read = input.read(buffer)
+                        if (read < 0) break
+                        total += read
+                        if (total > MAX_FONT_BYTES) error("font too large")
+                        output.write(buffer, 0, read)
+                    }
+                }
+            } != null
+        }.getOrElse {
+            false
+        }
+        val stagedFont = if (copied) loadFont(staging) else null
+        if (stagedFont == null) {
+            staging.delete()
+            return@withContext false
+        }
+        dir.listFiles()?.filter { it != staging }?.forEach { it.delete() }
+        val target = File(dir, "subtitle_font.$extension")
+        if (!staging.renameTo(target)) {
+            staging.delete()
+            return@withContext false
+        }
+        synchronized(this@SubtitleFontStore) {
+            _font.value = loadFont(target)
+            loaded = true
+        }
+        _font.value != null
+    }
+
+    fun clear() {
+        synchronized(this) {
+            fontsDir().listFiles()?.forEach { it.delete() }
+            _font.value = null
+            loaded = true
+        }
+    }
+
+    private fun loadFont(file: File): CustomSubtitleFont? = runCatching {
+        val family = readFontFamilyName(file) ?: return@runCatching null
+        CustomSubtitleFont(file = file, familyName = family)
+    }.getOrElse {
+        null
+    }
+}
+
+/** Reads name ID 1 (font family) from a TrueType/OpenType `name` table. Pure JVM. */
+private fun readFontFamilyName(file: File): String? = runCatching {
+    RandomAccessFile(file, "r").use { raf ->
+        val version = raf.readInt()
+        if (version != 0x00010000 && version != 0x4F54544F && version != 0x74727565) return@use null
+        val numTables = raf.readUnsignedShort()
+        raf.skipBytes(6)
+        var nameOffset = -1L
+        repeat(numTables) {
+            val tag = raf.readInt()
+            raf.skipBytes(4)
+            val offset = raf.readInt()
+            val length = raf.readInt()
+            if (tag == 0x6e616d65) nameOffset = offset.toLong() and 0xFFFFFFFFL
+            raf.skipBytes(4)
+        }
+        if (nameOffset < 0) return@use null
+        raf.seek(nameOffset)
+        val format = raf.readUnsignedShort()
+        val count = raf.readUnsignedShort()
+        val stringOffset = nameOffset + raf.readUnsignedShort()
+        var family: String? = null
+        repeat(count) {
+            val platformId = raf.readUnsignedShort()
+            raf.skipBytes(2) // encoding
+            val languageId = raf.readUnsignedShort()
+            val nameId = raf.readUnsignedShort()
+            val length = raf.readUnsignedShort()
+            val offset = raf.readUnsignedShort()
+            if (nameId == 1 && family == null) {
+                val pos = raf.filePointer
+                raf.seek(stringOffset + offset)
+                val bytes = ByteArray(length).also { raf.readFully(it) }
+                family = when (platformId) {
+                    3 -> String(bytes, Charsets.UTF_16BE)
+                    else -> String(bytes, Charsets.ISO_8859_1)
+                }
+                raf.seek(pos)
+                if (format != 1) return@use family
+                // format 1 tables carry a language-tag record first: only Windows-platform
+                // entries live after it, so keep scanning Windows/Unicode ones.
+                if (platformId == 3 && languageId >= 0) family = family
+            } else {
+                raf.skipBytes(2)
+            }
+        }
+        family
+    }
+}.getOrNull()
