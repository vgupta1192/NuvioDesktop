@@ -0,0 +1,246 @@
+package com.nuvio.app.features.player.generated
+
+import com.nuvio.app.core.storage.DesktopStorage
+import com.nuvio.app.features.player.GeneratedSubtitles
+import com.nuvio.app.features.player.GeneratedSubtitleSync
+import com.nuvio.app.features.player.audiosync.SyncLog
+import com.nuvio.app.features.player.desktop.NativePlayerBridge
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.cancelChildren
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import java.io.File
+import java.security.MessageDigest
+
+/**
+ * Generated subtitles for the desktop player (Groq-online phase): the stream's audio is dumped
+ * to 16 kHz mono WAV windows by the native player bridge (a headless mpv), recognised by Groq
+ * Whisper large-v3, and written to an SRT file that is attached to the playing mpv window by
+ * window, so lines appear while later windows are still being recognised. The finished SRT is
+ * cached under the content key and pushed to the user's account (shared with mobile).
+ */
+internal object GeneratedSubtitlesDesktop {
+    private const val WINDOW_SECONDS = 600.0
+    private const val MAX_WINDOWS = 24
+    private const val SAMPLE_RATE = 16_000
+
+    private val store by lazy { DesktopStorage.store("nuvio_generated_subtitles") }
+    @Volatile private var initialized = false
+
+    /** Idempotent; safe to call from any entry point (main, settings, subtitle attach). */
+    fun ensureInitialized() {
+        if (initialized) return
+        synchronized(this) {
+            if (initialized) return
+            GeneratedSubtitles.installPersistence(
+                load = { key -> store.getString(key) },
+                save = { key, value -> store.putString(key, value) },
+            )
+            GeneratedSubtitles.supported = true
+            initialized = true
+        }
+    }
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    @Volatile private var job: Job? = null
+    @Volatile var running: Boolean = false
+        private set
+
+    /** Called when playback moves to a real subtitle/title: the background dump loses its purpose. */
+    fun stopGeneration() {
+        job?.cancel()
+        job = null
+        running = false
+    }
+
+    /**
+     * Returns true when [url] is a generated-subtitle entry and generation started (or the
+     * cached file attached). The caller then skips attaching the pseudo URL to the player.
+     */
+    fun maybeGenerate(
+        handle: Long,
+        streamUrl: String?,
+        headers: Map<String, String>,
+        url: String,
+    ): Boolean {
+        ensureInitialized()
+        if (!GeneratedSubtitles.isGenerated(url)) return false
+        val online = url == GeneratedSubtitles.ONLINE_URL
+        if (GeneratedSubtitles.groqKey.value.isBlank()) {
+            SyncLog.w("generated subtitles: pick again after setting the Groq key in Settings")
+            return true
+        }
+        if (running) {
+            SyncLog.w("generated subtitles: already running for this title")
+            return true
+        }
+        val contentId = GeneratedSubtitles.contentId
+        val spoken = GeneratedSubtitles.spokenLanguage.value
+        val deeplKey = GeneratedSubtitles.deeplKey.value
+        val key = cacheKey(contentId, spoken, online)
+        job?.cancel()
+        running = true
+        job = scope.launch {
+            try {
+                runGeneration(handle, streamUrl.orEmpty(), headers, contentId, spoken, online, deeplKey, key)
+            } catch (failure: kotlinx.coroutines.CancellationException) {
+                throw failure
+            } catch (error: Throwable) {
+                SyncLog.w("generated subtitles: failed: ${error.message}")
+            } finally {
+                running = false
+            }
+        }
+        return true
+    }
+
+    private suspend fun runGeneration(
+        handle: Long,
+        streamUrl: String,
+        headers: Map<String, String>,
+        contentId: String?,
+        spoken: String,
+        online: Boolean,
+        deeplKey: String,
+        key: String,
+    ) {
+        val cacheDir = File(System.getProperty("java.io.tmpdir"), "nuvio-gensubs").apply { mkdirs() }
+        val srtFile = File(cacheDir, "$key.srt")
+        if (!srtFile.exists() || srtFile.length() < 64L) {
+            // Account copy first (another device may have generated this title already).
+            GeneratedSubtitleSync.pull(key)?.let { saved ->
+                srtFile.writeText(saved)
+                SyncLog.i("generated subtitles: restored from the account")
+            }
+        }
+        if (srtFile.exists() && srtFile.length() > 64L) {
+            attach(handle, srtFile)
+            return
+        }
+        if (streamUrl.isBlank()) {
+            SyncLog.w("generated subtitles: no stream URL to read audio from")
+            return
+        }
+
+        srtFile.delete()
+        var cueIndex = 0
+        var windowsWithAudio = 0
+        for (window in 0 until MAX_WINDOWS) {
+            if (handle == 0L) break // player closed; stop dumping
+            val startSec = window * WINDOW_SECONDS
+            val wavFile = File(cacheDir, "$key-$window.wav")
+            val ok = withContext(Dispatchers.IO) {
+                runCatching {
+                    NativePlayerBridge.dumpAudioWav(
+                        streamUrl,
+                        headers.map { (name, value) -> "$name: $value" }.toTypedArray(),
+                        wavFile.absolutePath,
+                        startSec,
+                        startSec + WINDOW_SECONDS,
+                    )
+                }.getOrDefault(false)
+            }
+            if (!ok || !wavFile.exists() || wavFile.length() <= 44L) {
+                wavFile.delete()
+                break // end of audio
+            }
+            val samples = readWavMono16(wavFile)
+            wavFile.delete()
+            if (samples.size < SAMPLE_RATE * 2) break // window is (almost) silent: end of audio
+            windowsWithAudio += 1
+
+            val translate = spoken == GeneratedSubtitles.AUTO || spoken == "en"
+            val key0 = GeneratedSubtitles.groqKey.value
+            val groqLines = withContext(Dispatchers.IO) {
+                GroqWhisperClient(key0).recognize(samples, SAMPLE_RATE, translate, spoken.takeUnless { it == GeneratedSubtitles.AUTO }.orEmpty())
+            }
+            var lines = groqLines.map { it.text }
+            if (!translate && deeplKey.isNotBlank()) {
+                lines = withContext(Dispatchers.IO) {
+                    DeepLTranslator(deeplKey).translate(
+                        lines,
+                        DeepLTranslator.sourceCode(spoken),
+                        context = null,
+                    )
+                }
+            }
+            if (lines.isEmpty()) continue
+            srtFile.appendText(
+                buildSrt(groqLines.map { it.startSec to it.endSec }, lines, startSec, cueIndex),
+            )
+            cueIndex += lines.size
+            attach(handle, srtFile) // grows every window: lines show up while later windows run
+        }
+        if (windowsWithAudio == 0) {
+            SyncLog.w("generated subtitles: no audio could be read from this stream")
+            srtFile.delete()
+            return
+        }
+        GeneratedSubtitleSync.push(key, contentId, srtFile.readText())
+        SyncLog.i("generated subtitles: finished ($windowsWithAudio windows)")
+    }
+
+    private fun attach(handle: Long, srtFile: File) {
+        if (handle == 0L) return
+        NativePlayerBridge.addSubtitleUrl(handle, srtFile.absolutePath)
+    }
+
+    /** Parses the mono 16-bit PCM window the native dumper wrote into a FloatArray. */
+    private fun readWavMono16(file: File): FloatArray = runCatching {
+        val bytes = file.readBytes()
+        if (bytes.size <= 44) return@runCatching FloatArray(0)
+        val dataStart = indexOfDataChunk(bytes).takeIf { it > 0 } ?: 44
+        val count = (bytes.size - dataStart) / 2
+        FloatArray(count) { index ->
+            val lo = bytes[dataStart + index * 2].toInt() and 0xFF
+            val hi = bytes[dataStart + index * 2 + 1].toInt()
+            (((hi shl 8) or lo).toShort().toInt()) / 32_767f
+        }
+    }.getOrDefault(FloatArray(0))
+
+    private fun indexOfDataChunk(bytes: ByteArray): Int {
+        var index = 12
+        while (index + 8 <= bytes.size) {
+            val id = String(bytes, index, 4, Charsets.US_ASCII)
+            val size = (bytes[index + 4].toInt() and 0xFF) or ((bytes[index + 5].toInt() and 0xFF) shl 8) or
+                ((bytes[index + 6].toInt() and 0xFF) shl 16) or ((bytes[index + 7].toInt() and 0xFF) shl 24)
+            if (id == "data") return index + 8
+            index += 8 + size + (size and 1)
+        }
+        return -1
+    }
+
+    /** SRT blocks for one window; [lines] pairs are seconds relative to the window start. */
+    private fun buildSrt(
+        spans: List<Pair<Double, Double>>,
+        lines: List<String>,
+        offsetSec: Double,
+        firstIndex: Int,
+    ): String = buildString {
+        spans.zip(lines).forEachIndexed { index, (span, line) ->
+            val (start, end) = span
+            val number = firstIndex + index + 1
+            append(number).append('\n')
+            append(formatSrtTime(offsetSec + start)).append(" --> ").append(formatSrtTime(offsetSec + end)).append('\n')
+            append(line.trim()).append("\n\n")
+        }
+    }
+
+    private fun formatSrtTime(seconds: Double): String {
+        val total = (seconds.coerceAtLeast(0.0) * 1000).toLong()
+        val h = total / 3_600_000
+        val m = (total / 60_000) % 60
+        val s = (total / 1_000) % 60
+        val ms = total % 1_000
+        return "%02d:%02d:%02d,%03d".format(h, m, s, ms)
+    }
+
+    private fun cacheKey(contentId: String?, spoken: String, online: Boolean): String {
+        val raw = "${contentId.orEmpty()}|$spoken|${if (online) "groq-online" else "groq"}"
+        val digest = MessageDigest.getInstance("SHA-1").digest(raw.encodeToByteArray())
+        return digest.joinToString("") { "%02x".format(it) }
+    }
+}
diff --git a/composeApp/src/desktopMain/kotlin/com/nuvio/app/features/player/generated/GroqWhisperClient.kt b/composeApp/src/desktopMain/kotlin/com/nuvio/app/features/player/generated/GroqWhisperClient.kt
new file mode 100644
index 000000000..c74c81c30
--- /dev/null
+++ b/composeApp/src/desktopMain/kotlin/com/nuvio/app/features/player/generated/GroqWhisperClient.kt
@@ -0,0 +1,116 @@
+package com.nuvio.app.features.player.generated
+
+import com.nuvio.app.features.player.audiosync.SyncLog
+import java.io.ByteArrayOutputStream
+import java.net.HttpURLConnection
+import java.net.URL
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import java.util.UUID
+import org.json.JSONObject
+
+/**
+ * Whisper large-v3 on Groq's servers (the user's own API key): speech audio of one window is
+ * uploaded as a 16 kHz WAV and comes back as timed lines, translated to English or (for DeepL)
+ * written down in the spoken language. Blocking.
+ */
+internal class GroqWhisperClient(private val key: String) {
+    /** A line Groq heard, in seconds from the start of the uploaded audio. */
+    class Line(val startSec: Double, val endSec: Double, val text: String, val language: String)
+
+    class Failure(message: String, val permanent: Boolean, val retryAfterMs: Long = 0L) : Exception(message)
+
+    /** [translate]: English; else the spoken language ([language] hint, or detected when blank). */
+    fun recognize(samples: FloatArray, sampleRate: Int, translate: Boolean, language: String): List<Line> {
+        var attempt = 0
+        while (true) {
+            try {
+                return request(samples, sampleRate, translate, language)
+            } catch (failure: Failure) {
+                if (failure.permanent || ++attempt >= RETRIES) throw failure
+                Thread.sleep(maxOf(failure.retryAfterMs, RETRY_DELAY_MS * attempt))
+            }
+        }
+    }
+
+    private fun request(samples: FloatArray, sampleRate: Int, translate: Boolean, language: String): List<Line> {
+        val boundary = "nuvio-" + UUID.randomUUID().toString()
+        val body = ByteArrayOutputStream()
+        fun field(name: String, value: String) {
+            body.write("--$boundary\r\nContent-Disposition: form-data; name=\"$name\"\r\n\r\n$value\r\n".toByteArray())
+        }
+        field("model", MODEL)
+        field("response_format", "verbose_json")
+        field("temperature", "0")
+        if (!translate && language.isNotBlank()) field("language", language)
+        body.write(
+            ("--$boundary\r\nContent-Disposition: form-data; name=\"file\"; filename=\"speech.wav\"\r\n" +
+                "Content-Type: audio/wav\r\n\r\n").toByteArray(),
+        )
+        body.write(wav(samples, sampleRate))
+        body.write("\r\n--$boundary--\r\n".toByteArray())
+        val endpoint = if (translate) TRANSLATIONS else TRANSCRIPTIONS
+        val connection = (URL(endpoint).openConnection() as HttpURLConnection).apply {
+            requestMethod = "POST"
+            connectTimeout = 15_000
+            readTimeout = 60_000
+            doOutput = true
+            setRequestProperty("Authorization", "Bearer $key")
+            setRequestProperty("Content-Type", "multipart/form-data; boundary=$boundary")
+        }
+        try {
+            connection.outputStream.use { body.writeTo(it) }
+            val code = try {
+                connection.responseCode
+            } catch (error: Exception) {
+                throw Failure("Groq unreachable: ${error.message}", permanent = false)
+            }
+            when (code) {
+                200 -> Unit
+                401, 403 -> throw Failure("Groq key rejected", permanent = true)
+                413 -> throw Failure("Groq refused the audio size", permanent = false)
+                429 -> {
+                    val wait = connection.getHeaderField("retry-after")?.toDoubleOrNull()?.let { (it * 1_000).toLong() } ?: 20_000L
+                    throw Failure("Groq rate limit reached", permanent = false, retryAfterMs = wait.coerceAtMost(120_000L))
+                }
+                else -> throw Failure("Groq HTTP $code", permanent = code in 400..499)
+            }
+            val json = JSONObject(connection.inputStream.bufferedReader(Charsets.UTF_8).use { it.readText() })
+            val language = json.optString("language").lowercase()
+            val segments = json.optJSONArray("segments") ?: return emptyList()
+            return List(segments.length()) { index -> segments.getJSONObject(index) }
+                .filter { it.optDouble("no_speech_prob", 0.0) < NO_SPEECH_LIMIT }
+                .map { Line(it.optDouble("start"), it.optDouble("end"), it.optString("text").trim(), language) }
+                .filter { it.text.isNotEmpty() }
+        } catch (failure: Failure) {
+            SyncLog.w("generated subtitles: ${failure.message}")
+            throw failure
+        } catch (error: Exception) {
+            SyncLog.w("generated subtitles: Groq failed: ${error.message}")
+            throw Failure("Groq failed: ${error.message}", permanent = false)
+        } finally {
+            connection.disconnect()
+        }
+    }
+
+    private fun wav(samples: FloatArray, sampleRate: Int): ByteArray {
+        val data = ByteBuffer.allocate(samples.size * 2).order(ByteOrder.LITTLE_ENDIAN)
+        for (sample in samples) data.putShort((sample.coerceIn(-1f, 1f) * 32_767f).toInt().toShort())
+        val header = ByteBuffer.allocate(44).order(ByteOrder.LITTLE_ENDIAN).apply {
+            put("RIFF".toByteArray()); putInt(36 + samples.size * 2); put("WAVE".toByteArray())
+            put("fmt ".toByteArray()); putInt(16); putShort(1); putShort(1); putInt(sampleRate)
+            putInt(sampleRate * 2); putShort(2); putShort(16)
+            put("data".toByteArray()); putInt(samples.size * 2)
+        }
+        return header.array() + data.array()
+    }
+
+    companion object {
+        private const val MODEL = "whisper-large-v3"
+        private const val TRANSLATIONS = "https://api.groq.com/openai/v1/audio/translations"
+        private const val TRANSCRIPTIONS = "https://api.groq.com/openai/v1/audio/transcriptions"
+        private const val RETRIES = 3
