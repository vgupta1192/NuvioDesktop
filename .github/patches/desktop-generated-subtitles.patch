+package com.nuvio.app.features.streams
+
+import com.nuvio.app.core.storage.DesktopStorage
+import java.net.NetworkInterface
+
+internal enum class NetworkKind {
+    WIFI,
+    CELLULAR,
+    OTHER,
+}
+
+/** The current default network, or null when offline or unknown. Best-effort on desktop. */
+internal actual fun currentNetworkKind(): NetworkKind? = runCatching {
+    val interfaces = NetworkInterface.getNetworkInterfaces()?.asSequence()?.filter { it.isUp && !it.isLoopback }?.toList()
+    if (interfaces.isNullOrEmpty()) return@runCatching null
+    val names = interfaces.joinToString(" ") { it.name + " " + (it.displayName ?: "") }.lowercase()
+    when {
+        "wi-fi" in names || "wlan" in names || "wifi" in names || "airport" in names -> NetworkKind.WIFI
+        "ethernet" in names || "eth" in names || "enp" in names -> NetworkKind.OTHER
+        else -> NetworkKind.WIFI
+    }
+}.getOrNull()
+
+/** Cellular generation has no meaning on desktop. */
+internal actual fun currentNetworkGeneration(): Int = 0
+
+internal actual object ConnectionSpeedStorage {
+    private val store by lazy { DesktopStorage.store("connection_speed") }
+
+    actual fun load(): String? = store.getString("samples")
+    actual fun save(value: String) = store.putString("samples", value)
+    actual fun loadEnabled(): Boolean? = store.getBoolean("enabled")
+    actual fun saveEnabled(enabled: Boolean) = store.putBoolean("enabled", enabled)
+}
