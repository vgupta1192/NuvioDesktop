+package com.nuvio.app.features.player
+
+import com.nuvio.app.features.player.desktop.NativePlayerBridge
+
+/**
+ * Applies the user-imported subtitle font to the live native mpv instance. sub-fonts-dir must
+ * be set before libass initialises, so the controller also re-applies both options on every
+ * attach - the calls are idempotent and cheap.
+ */
+internal object NativePlayerBridgeSubtitleFont {
+    @Volatile var activeHandle: Long = 0
+
+    fun applyToPlayer() {
+        val handle = activeHandle
+        if (handle == 0L) return
+        runCatching {
+            val font = SubtitleFontStore.current()
+            NativePlayerBridge.command(
+                handle,
+                arrayOf("set", "sub-fonts-dir", SubtitleFontStore.fontsDir().absolutePath),
+            )
+            NativePlayerBridge.command(
+                handle,
+                arrayOf("set", "sub-font", font?.familyName ?: "sans-serif"),
+            )
+        }
+    }
+}
