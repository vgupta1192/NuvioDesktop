+    mpv_set_option_string(mpv, "mute", "yes"); // never audible, even if ao=pcm is missing and mpv falls back
+    mpv_set_option_string(mpv, "audio-samplerate", "16000");
+    mpv_set_option_string(mpv, "audio-channels", "mono");
+    mpv_set_option_string(mpv, "audio-format", "s16");
+    mpv_set_option_string(mpv, "untimed", "yes");
+    mpv_set_option_string(mpv, "video", "no");
+    mpv_set_option_string(mpv, "terminal", "no");
+    if (startSec > 0) mpv_set_option_string(mpv, "start", std::to_string(startSec).c_str());
+    if (endSec > 0) mpv_set_option_string(mpv, "end", std::to_string(endSec).c_str());
+    if (jheaders) {
+        jsize count = env->GetArrayLength(jheaders);
+        std::string joined;
+        for (jsize i = 0; i < count; ++i) {
+            jstring jheader = (jstring)env->GetObjectArrayElement(jheaders, i);
+            if (!jheader) continue;
+            const char *header = env->GetStringUTFChars(jheader, nullptr);
+            if (i > 0) joined += ",";
+            joined += header;
+            env->ReleaseStringUTFChars(jheader, header);
+            env->DeleteLocalRef(jheader);
+        }
+        if (!joined.empty()) mpv_set_option_string(mpv, "http-header-fields", joined.c_str());
+    }
+    bool ok = mpv_initialize(mpv) >= 0;
+    if (ok) {
+        const char *loadfile[] = {"loadfile", url, nullptr};
+        mpv_command(mpv, loadfile);
+        bool done = false;
+        while (!done) {
+            mpv_event *event = mpv_wait_event(mpv, 30.0);
+            switch (event->event_id) {
+                case MPV_EVENT_END_FILE:
+                case MPV_EVENT_IDLE:
+                case MPV_EVENT_SHUTDOWN:
+                    done = true;
+                    break;
+                default:
+                    break;
+            }
+        }
+        mpv_terminate_destroy(mpv); // finalises the WAV header
+    } else {
+        mpv_terminate_destroy(mpv);
+    }
+    env->ReleaseStringUTFChars(jurl, url);
+    env->ReleaseStringUTFChars(jout, outPath);
+    FILE *check = fopen(outPath, "rb");
+    if (!check) return JNI_FALSE;
+    fseek(check, 0, SEEK_END);
+    long size = ftell(check);
+    fclose(check);
+    return (size > 44) ? JNI_TRUE : JNI_FALSE;
+}
