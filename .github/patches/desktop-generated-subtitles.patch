+package com.nuvio.app.features.player
+
+import com.nuvio.app.core.network.SupabaseProvider
+import io.github.jan.supabase.postgrest.postgrest
+import io.github.jan.supabase.postgrest.rpc
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.put
+
+/**
+ * Generated subtitles saved to the user's Nuvio account (table generated_subtitles on the
+ * self-hosted backend, one row per title key), so every device signed in to the account reuses
+ * them. Payloads are the same JSON the device keeps locally. Failures (signed out, offline)
+ * return null / false; the local copy still works.
+ */
+object GeneratedSubtitleSync {
+    suspend fun pull(key: String): String? = runCatching {
+        val result = SupabaseProvider.client.postgrest.rpc(
+            "generated_subtitles_pull",
+            buildJsonObject { put("p_key", key) },
+        )
+        result.data.trim().takeUnless { it.isEmpty() || it == "null" }
+    }.getOrNull()
+
+    suspend fun push(key: String, contentId: String?, payload: String): Boolean = runCatching {
+        SupabaseProvider.client.postgrest.rpc(
+            "generated_subtitles_push",
+            buildJsonObject {
+                put("p_key", key)
+                put("p_content_id", contentId)
+                put("p_payload", Json.parseToJsonElement(payload))
+            },
+        )
+        true
+    }.getOrDefault(false)
+}
diff --git a/composeApp/src/commonMain/kotlin/com/nuvio/app/features/player/GeneratedSubtitles.kt b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/player/GeneratedSubtitles.kt
