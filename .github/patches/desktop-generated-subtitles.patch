+package com.nuvio.app.features.player
+
+import com.nuvio.app.features.streams.ConnectionSpeedEstimator
+import com.nuvio.app.features.streams.NetworkKind
+import com.nuvio.app.features.streams.currentNetworkKind
+import com.nuvio.app.features.player.desktop.NativePlayerBridge
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.isActive
+import kotlinx.coroutines.launch
+
+/**
+ * Feeds the connection-fit estimator from the native player's network read rate (mpv's
+ * cache-speed, bytes/s) while a title is playing. Passive: nothing is measured on stream load.
+ */
+internal object ConnectionFitDesktopFeed {
+    @Volatile private var handle: Long = 0
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.IO)
+    private var loop: Job? = null
+
+    fun start(handle: Long) {
+        this.handle = handle
+        loop ?: run { loop = scope.launch { pollLoop() } }
+    }
+
+    fun stop() {
+        handle = 0
+    }
+
+    private suspend fun pollLoop() {
+        while (scope.isActive) {
+            delay(5_000)
+            val current = handle
+            if (current == 0L) continue
+            val bytesPerSecond = runCatching {
+                NativePlayerBridge.propGetString(current, "cache-speed")?.toDoubleOrNull()
+            }.getOrNull() ?: continue
+            if (bytesPerSecond > 0.0) {
+                val kind = currentNetworkKind() ?: NetworkKind.WIFI
+                ConnectionSpeedEstimator.record(kind, bytesPerSecond * 8.0 / 1_000_000.0)
+            }
+        }
+    }
+}
