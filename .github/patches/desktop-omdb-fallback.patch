@@ -0,0 +1,65 @@
+package com.nuvio.app.features.details
+
+import co.touchlab.kermit.Logger
+import com.nuvio.app.features.addons.httpGetText
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.SerialName
+import kotlinx.serialization.json.Json
+
+@Serializable
+private data class OmdbHeadResponse(
+    @SerialName("totalSeasons") val totalSeasons: String? = null,
+    @SerialName("Response") val response: String = "False",
+)
+
+@Serializable
+private data class OmdbEpisodeEntry(
+    @SerialName("Episode") val episode: String? = null,
+    @SerialName("imdbRating") val imdbRating: String? = null,
+)
+
+@Serializable
+private data class OmdbSeasonResponse(
+    @SerialName("Episodes") val episodes: List<OmdbEpisodeEntry> = emptyList(),
+)
+
+/**
+ * Nuvio fork: the user's own OMDb API key as a fallback source for episode ratings, used only
+ * when IMDb (Tapframe) and SeriesGraph have nothing for a series.
+ */
+internal object OmdbEpisodeRatings {
+    private val log = Logger.withTag("OmdbEpisodeRatings")
+    private val json = Json { ignoreUnknownKeys = true; isLenient = true }
+
+    suspend fun fetch(imdbId: String, apiKey: String): Map<Pair<Int, Int>, Double> = withContext(Dispatchers.Default) {
+        if (apiKey.isBlank()) return@withContext emptyMap()
+        val out = mutableMapOf<Pair<Int, Int>, Double>()
+        try {
+            val head = json.decodeFromString<OmdbHeadResponse>(
+                httpGetText("https://www.omdbapi.com/?i=$imdbId&apikey=$apiKey"),
+            )
+            val totalSeasons = head.totalSeasons?.toIntOrNull()
+                ?.takeIf { head.response.equals("True", ignoreCase = true) }
+                ?: return@withContext emptyMap()
+            for (season in 1..minOf(totalSeasons, 40)) {
+                val root = runCatching {
+                    json.decodeFromString<OmdbSeasonResponse>(
+                        httpGetText("https://www.omdbapi.com/?i=$imdbId&Season=$season&apikey=$apiKey"),
+                    )
+                }.getOrNull() ?: continue
+                root.episodes.forEach { ep ->
+                    val number = ep.episode?.toIntOrNull() ?: return@forEach
+                    val rating = ep.imdbRating?.toDoubleOrNull() ?: return@forEach
+                    if (rating > 0.0) out[season to number] = rating
+                }
+            }
+        } catch (cancelled: kotlinx.coroutines.CancellationException) {
+            throw cancelled
+        } catch (e: Exception) {
+            log.w { "OMDb episode ratings failed for $imdbId: ${e.message}" }
+        }
+        out
+    }
+}
