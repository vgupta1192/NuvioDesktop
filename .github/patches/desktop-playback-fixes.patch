+    private fun serveSegment(exchange: HttpExchange, session: Session, id: String) {
+        val kind = id.substringBeforeLast('-')
+        val number = id.substringAfterLast('-').toLongOrNull()
+        val url = session.segmentUrls[id]
+        if (url == null) {
+            exchange.sendResponseHeaders(404, -1)
+            return
+        }
+        val range = exchange.requestHeaders.getFirst("Range")
+        val bytes = if (range != null) {
+            fetch(url, range) // a byte-range read goes straight through, uncached
+        } else {
+            if (number != null) {
+                session.reading.merge(kind, number) { a, b -> maxOf(a, b) }
+                download(session, id) // the segment being read goes first in the queue
+                for (ahead in 1..PrefetchAhead) download(session, "$kind-${number + ahead}")
+                // Drop what the player is already past.
+                session.downloads.keys.removeIf { key ->
+                    key.startsWith("$kind-") && key.substringAfterLast('-').toLongOrNull()?.let { it < number - 1 } == true
