+    private fun download(session: Session, id: String): CompletableFuture<ByteArray>? {
+        val url = session.segmentUrls[id] ?: return null
+        return session.downloads.computeIfAbsent(id) {
+            val future = CompletableFuture<ByteArray>()
+            prefetchPool.execute {
+                try {
+                    future.complete(fetch(url))
+                } catch (error: Throwable) {
+                    session.downloads.remove(id, future)
+                    future.completeExceptionally(error)
+                }
+            }
+            future
+        }
+    }
