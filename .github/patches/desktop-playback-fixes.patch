+            }
+            val pending = download(session, id)
+            if (pending == null) {
+                exchange.sendResponseHeaders(404, -1)
+                return
+            }
+            pending.get(40, java.util.concurrent.TimeUnit.SECONDS)
+        }
+        exchange.responseHeaders.add("Content-Type", "application/octet-stream")
+        exchange.sendResponseHeaders(if (range != null) 206 else 200, bytes.size.toLong())
+        exchange.responseBody.use { it.write(bytes) }
+    }
+
+    @Synchronized
+    private fun ensureServer(): HttpServer {
+        server?.let { return it }
+        val created = HttpServer.create(InetSocketAddress(InetAddress.getLoopbackAddress(), 0), 0)
+        created.createContext("/") { exchange ->
+            try {
+                val parts = exchange.requestURI.path.split('/').filter { it.isNotEmpty() }
+                val session = parts.getOrNull(1)?.let { sessions[it] }
+                val port = created.address.port
+                if (session == null || parts.size != 3) {
+                    exchange.sendResponseHeaders(404, -1)
+                } else if (parts[0] == "m") {
+                    val variant = parts[2].removeSuffix(".m3u8").toIntOrNull()
+                    if (variant == null || variant !in session.variants.indices) {
+                        exchange.sendResponseHeaders(404, -1)
+                    } else {
+                        sendPage(exchange, masterPage(session, variant, port))
+                    }
+                } else if (parts[0] == "p") {
+                    val kind = parts[2].removeSuffix(".m3u8")
+                    val source = if (kind == "a") {
+                        session.audioUri
+                    } else {
+                        kind.removePrefix("v").toIntOrNull()?.let { session.variants.getOrNull(it)?.uri }
+                    }
+                    if (source == null) {
+                        exchange.sendResponseHeaders(404, -1)
+                    } else {
+                        sendPage(exchange, mediaPage(session, kind, source, port))
+                    }
+                } else if (parts[0] == "s") {
+                    serveSegment(exchange, session, parts[2])
+                } else {
+                    exchange.sendResponseHeaders(404, -1)
+                }
+            } catch (_: Throwable) {
+                runCatching { exchange.sendResponseHeaders(502, -1) }
+            } finally {
+                exchange.close()
+            }
+        }
+        created.executor = Executors.newFixedThreadPool(12) { runnable ->
+            Thread(runnable, "youtube-hls-local").apply { isDaemon = true }
+        }
+        created.start()
+        server = created
+        return created
+    }
+
+    private fun sendPage(exchange: HttpExchange, page: String) {
+        val bytes = page.toByteArray()
+        exchange.responseHeaders.add("Content-Type", "application/vnd.apple.mpegurl")
+        exchange.sendResponseHeaders(200, bytes.size.toLong())
+        exchange.responseBody.use { it.write(bytes) }
+    }
+}
