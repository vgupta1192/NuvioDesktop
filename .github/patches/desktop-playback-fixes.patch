@@ -0,0 +1,138 @@
+package com.nuvio.app.features.player
+
+import com.nuvio.app.features.streams.YouTubeStreamResolver
+import com.sun.net.httpserver.HttpServer
+import java.net.HttpURLConnection
+import java.net.InetAddress
+import java.net.InetSocketAddress
+import java.net.URI
+import java.util.UUID
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.Executors
+
+/**
+ * Makes YouTube's HLS master playable by mpv.
+ *
+ * The master lists around 17 variants plus several audio renditions. ffmpeg's HLS demuxer opens
+ * every playlist of the master and probes each of them before the first frame, and mpv cannot
+ * adapt afterwards, so the video sits on "buffering" for minutes (nothing plays within 15 s on
+ * Desktop while the same stream starts in seconds on Mobile, whose player only loads what it
+ * plays). This rewrites the master to one H.264 variant at or under [MaxBandwidth] and its
+ * default audio, serves that page from a loopback server, and hands mpv the loopback address.
+ * The playlists and segments are still fetched from YouTube.
+ */
+internal object DesktopYouTubeHls {
+    private const val MaxBandwidth = 2_800_000L
+    private const val MaxHeight = 720
+
+    class Rewrite(val url: String, val summary: String)
+
+    private val pages = ConcurrentHashMap<String, String>()
+    @Volatile private var server: HttpServer? = null
+
+    /** Blocking (network); call off the UI thread. Null leaves the original address in use. */
+    fun rewrite(masterUrl: String): Rewrite? {
+        if (!YouTubeStreamResolver.isYouTubeMedia(masterUrl)) return null
+        if (!masterUrl.contains("hls_variant") && !masterUrl.substringBefore('?').endsWith(".m3u8")) return null
+        return runCatching {
+            val body = fetch(masterUrl)
+            val page = buildPage(masterUrl, body) ?: return null
+            val id = UUID.randomUUID().toString().replace("-", "")
+            pages[id] = page.first
+            if (pages.size > 8) pages.keys.firstOrNull { it != id }?.let(pages::remove)
+            val port = ensureServer().address.port
+            Rewrite("http://127.0.0.1:$port/m/$id.m3u8", page.second)
+        }.getOrNull()
+    }
+
+    private fun fetch(url: String): String {
+        val connection = URI(url).toURL().openConnection() as HttpURLConnection
+        connection.connectTimeout = 10_000
+        connection.readTimeout = 10_000
+        return connection.inputStream.use { it.readNBytes(1024 * 1024) }.decodeToString()
+    }
+
+    private class Variant(val info: String, val uri: String, val bandwidth: Long, val height: Int, val avc: Boolean, val audio: String?)
+
+    private val attribute = Regex("""([A-Z0-9-]+)=("[^"]*"|[^,]*)""")
+
+    private fun attributes(line: String): Map<String, String> =
+        attribute.findAll(line.substringAfter(':')).associate { it.groupValues[1] to it.groupValues[2].trim('"') }
+
+    private fun buildPage(masterUrl: String, body: String): Pair<String, String>? {
+        val base = URI(masterUrl)
+        val lines = body.lines().map { it.trim() }
+        val variants = mutableListOf<Variant>()
+        val media = mutableListOf<String>()
+        val header = mutableListOf<String>()
+        var index = 0
+        while (index < lines.size) {
+            val line = lines[index]
+            when {
+                line.startsWith("#EXT-X-STREAM-INF") -> {
+                    val uri = lines.drop(index + 1).firstOrNull { it.isNotEmpty() && !it.startsWith("#") }
+                    if (uri != null) {
+                        val attrs = attributes(line)
+                        variants += Variant(
+                            info = line,
+                            uri = base.resolve(uri).toString(),
+                            bandwidth = attrs["BANDWIDTH"]?.toLongOrNull() ?: Long.MAX_VALUE,
+                            height = attrs["RESOLUTION"]?.substringAfter('x')?.toIntOrNull() ?: 0,
+                            avc = attrs["CODECS"].orEmpty().contains("avc1"),
+                            audio = attrs["AUDIO"],
+                        )
+                    }
+                }
+                line.startsWith("#EXT-X-MEDIA") -> media += line
+                line.startsWith("#EXT-X-VERSION") || line.startsWith("#EXT-X-INDEPENDENT-SEGMENTS") -> header += line
+            }
+            index++
+        }
+        if (variants.isEmpty()) return null
+        val h264 = variants.filter { it.avc }.ifEmpty { variants }
+        val capped = h264.filter { it.bandwidth <= MaxBandwidth && (it.height == 0 || it.height <= MaxHeight) }
+        val chosen = capped.maxByOrNull { it.bandwidth } ?: h264.minBy { it.bandwidth }
+        val audioLine = chosen.audio?.let { group ->
+            val ofGroup = media.filter { attributes(it)["TYPE"] == "AUDIO" && attributes(it)["GROUP-ID"] == group }
+            ofGroup.firstOrNull { attributes(it)["DEFAULT"] == "YES" } ?: ofGroup.firstOrNull()
+        }
+        val page = buildString {
+            append("#EXTM3U\n")
+            header.forEach { append(it).append('\n') }
+            if (audioLine != null) {
+                append(Regex("""URI="([^"]*)"""").replace(audioLine) { match ->
+                    "URI=\"" + base.resolve(match.groupValues[1]) + "\""
+                }).append('\n')
+            }
+            append(chosen.info.replace(Regex(""",SUBTITLES="[^"]*""""), "")).append('\n')
+            append(chosen.uri).append('\n')
+        }
+        val summary = "variants=${variants.size} chose=${chosen.height}p ${chosen.bandwidth / 1000}kbps avc=${chosen.avc} audio=${audioLine != null}"
+        return page to summary
+    }
+
+    @Synchronized
+    private fun ensureServer(): HttpServer {
+        server?.let { return it }
+        val created = HttpServer.create(InetSocketAddress(InetAddress.getLoopbackAddress(), 0), 0)
+        created.createContext("/m/") { exchange ->
+            val id = exchange.requestURI.path.substringAfterLast('/').removeSuffix(".m3u8")
+            val page = pages[id]
+            if (page == null) {
+                exchange.sendResponseHeaders(404, -1)
+            } else {
+                val bytes = page.toByteArray()
+                exchange.responseHeaders.add("Content-Type", "application/vnd.apple.mpegurl")
+                exchange.sendResponseHeaders(200, bytes.size.toLong())
+                exchange.responseBody.use { it.write(bytes) }
+            }
+            exchange.close()
+        }
+        created.executor = Executors.newSingleThreadExecutor { runnable ->
+            Thread(runnable, "youtube-hls-local").apply { isDaemon = true }
+        }
+        created.start()
+        server = created
+        return created
+    }
+}
