+package com.nuvio.app.features.settings
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.nuvio.app.features.player.PlayerEnhancePrefs
+
+/**
+ * Nuvio fork: "Picture & sound" for the Desktop player, the same controls as the in-player
+ * Video & sound panel (and as Mobile/TV): picture adjustments, volume boost, night mode and an
+ * equalizer preset. Hidden on platforms that do not install [PlayerEnhancePrefs].
+ */
+@Composable
+internal fun PlayerEnhanceSettingsSection(isTablet: Boolean) {
+    if (!PlayerEnhancePrefs.available) return
+    val values by PlayerEnhancePrefs.values.collectAsStateWithLifecycle()
+    SettingsSection(title = "Picture & sound", isTablet = isTablet) {
+        SettingsGroup(isTablet = isTablet) {
+            SettingsSliderRow("Brightness", values.brightness, { it.toString() }, -100..100, 1, isTablet) { v ->
+                PlayerEnhancePrefs.update { it.copy(brightness = v) }
+            }
+            SettingsGroupDivider(isTablet = isTablet)
+            SettingsSliderRow("Contrast", values.contrast, { it.toString() }, -100..100, 1, isTablet) { v ->
+                PlayerEnhancePrefs.update { it.copy(contrast = v) }
+            }
+            SettingsGroupDivider(isTablet = isTablet)
+            SettingsSliderRow("Saturation", values.saturation, { it.toString() }, -100..100, 1, isTablet) { v ->
+                PlayerEnhancePrefs.update { it.copy(saturation = v) }
+            }
+            SettingsGroupDivider(isTablet = isTablet)
+            SettingsSliderRow("Gamma", values.gamma, { it.toString() }, -100..100, 1, isTablet) { v ->
+                PlayerEnhancePrefs.update { it.copy(gamma = v) }
+            }
+            SettingsGroupDivider(isTablet = isTablet)
+            SettingsSliderRow("Hue", values.hue, { it.toString() }, -100..100, 1, isTablet) { v ->
+                PlayerEnhancePrefs.update { it.copy(hue = v) }
+            }
+            SettingsGroupDivider(isTablet = isTablet)
+            SettingsSwitchRow(
+                title = "Deband",
+                description = "Smooth colour gradients and remove banding.",
+                checked = values.deband,
+                isTablet = isTablet,
+                onCheckedChange = { on -> PlayerEnhancePrefs.update { it.copy(deband = on) } },
+            )
+            SettingsGroupDivider(isTablet = isTablet)
+            SettingsSliderRow("Volume boost", values.gainDb, { "+$it dB" }, 0..20, 1, isTablet) { v ->
+                PlayerEnhancePrefs.update { it.copy(gainDb = v) }
+            }
+            SettingsGroupDivider(isTablet = isTablet)
+            SettingsSwitchRow(
+                title = "Night mode",
+                description = "Even out loud and quiet parts so dialogue stays clear at low volume.",
+                checked = values.normalize,
+                isTablet = isTablet,
+                onCheckedChange = { on -> PlayerEnhancePrefs.update { it.copy(normalize = on) } },
+            )
+            SettingsGroupDivider(isTablet = isTablet)
+            SettingsNavigationRow(
+                title = "Equalizer",
+                description = PlayerEnhancePrefs.eqNames[values.eq.coerceIn(0, PlayerEnhancePrefs.eqNames.lastIndex)],
+                isTablet = isTablet,
+                onClick = {
+                    PlayerEnhancePrefs.update { it.copy(eq = (it.eq + 1) % PlayerEnhancePrefs.eqNames.size) }
+                },
+            )
+            SettingsGroupDivider(isTablet = isTablet)
+            SettingsNavigationRow(
+                title = "Reset picture and sound",
+                description = null,
+                isTablet = isTablet,
+                onClick = { PlayerEnhancePrefs.reset() },
+            )
+        }
+    }
+}
