@@ -0,0 +1,93 @@
+package com.nuvio.app.features.player
+
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/**
+ * Picture, sound and quality-cap preferences of the Desktop player (Nuvio fork). The overlay
+ * panel and the Settings > Playback section both edit this one holder; the desktop engine
+ * installs [Storage] and a change listener, other platforms leave [available] false and the
+ * settings section stays hidden.
+ */
+object PlayerEnhancePrefs {
+    interface Storage {
+        fun getInt(key: String): Int?
+        fun putInt(key: String, value: Int)
+        fun getBoolean(key: String): Boolean?
+        fun putBoolean(key: String, value: Boolean)
+    }
+
+    data class Values(
+        val brightness: Int = 0,
+        val contrast: Int = 0,
+        val saturation: Int = 0,
+        val gamma: Int = 0,
+        val hue: Int = 0,
+        val deband: Boolean = false,
+        val gainDb: Int = 0,
+        val normalize: Boolean = false,
+        val eq: Int = 0,
+    )
+
+    val eqNames: List<String> = listOf("Flat", "Bass boost", "Voice clarity", "Treble boost")
+
+    private val _values = MutableStateFlow(Values())
+    val values: StateFlow<Values> = _values.asStateFlow()
+
+    private var storage: Storage? = null
+
+    /** Called after a change so the live player can apply it. */
+    var onChanged: ((Values) -> Unit)? = null
+
+    var available: Boolean = false
+        private set
+
+    fun install(storage: Storage) {
+        this.storage = storage
+        available = true
+        _values.value = Values(
+            brightness = storage.getInt("pic_brightness").clampPercent(),
+            contrast = storage.getInt("pic_contrast").clampPercent(),
+            saturation = storage.getInt("pic_saturation").clampPercent(),
+            gamma = storage.getInt("pic_gamma").clampPercent(),
+            hue = storage.getInt("pic_hue").clampPercent(),
+            deband = storage.getBoolean("deband") ?: false,
+            gainDb = (storage.getInt("gain_db") ?: 0).coerceIn(0, 20),
+            normalize = storage.getBoolean("normalize") ?: false,
+            eq = (storage.getInt("eq") ?: 0).coerceIn(0, eqNames.lastIndex),
+        )
+    }
+
+    fun update(transform: (Values) -> Values) {
+        val next = transform(_values.value).let {
+            it.copy(
+                brightness = it.brightness.coerceIn(-100, 100),
+                contrast = it.contrast.coerceIn(-100, 100),
+                saturation = it.saturation.coerceIn(-100, 100),
+                gamma = it.gamma.coerceIn(-100, 100),
+                hue = it.hue.coerceIn(-100, 100),
+                gainDb = it.gainDb.coerceIn(0, 20),
+                eq = it.eq.coerceIn(0, eqNames.lastIndex),
+            )
+        }
+        if (next == _values.value) return
+        _values.value = next
+        storage?.run {
+            putInt("pic_brightness", next.brightness)
+            putInt("pic_contrast", next.contrast)
+            putInt("pic_saturation", next.saturation)
+            putInt("pic_gamma", next.gamma)
+            putInt("pic_hue", next.hue)
+            putBoolean("deband", next.deband)
+            putInt("gain_db", next.gainDb)
+            putBoolean("normalize", next.normalize)
+            putInt("eq", next.eq)
+        }
+        onChanged?.invoke(next)
+    }
+
+    fun reset() = update { Values() }
+
+    private fun Int?.clampPercent(): Int = (this ?: 0).coerceIn(-100, 100)
+}
