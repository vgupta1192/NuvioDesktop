index 00000000..3b147ac3
--- /dev/null
+++ b/composeApp/src/desktopMain/kotlin/com/nuvio/app/features/player/DesktopPlayerEnhance.kt
@@ -0,0 +1,237 @@
+package com.nuvio.app.features.player
+
+import com.nuvio.app.core.storage.DesktopStorage
+import com.nuvio.app.features.player.desktop.NativePlayerBridge
+import com.nuvio.app.features.streams.YouTubeStreamResolver
+
+/**
+ * Picture, sound and video-quality controls for the native (mpv) player, matching the
+ * Picture & Sound / Volume boost / quality chooser that Mobile and TV have.
+ *
+ * Every mpv property touch happens under [gate]; [stop] is called by the controller before the
+ * native instance is destroyed and returns only once no call is in flight (a property call on a
+ * disposed player aborts the process, see ConnectionFitDesktopFeed).
+ *
+ * The overlay talks to this object with `enh.*` events (name, number) and reads the panel state
+ * from [panelJson], which the controller embeds in the controls JSON as `enhance`.
+ */
+internal object DesktopPlayerEnhance {
+    private val gate = Any()
+    private val store = DesktopStorage.store("nuvio_player_enhance")
+    @Volatile private var handle: Long = 0
+    @Volatile var version: Int = 0
+        private set
+
+    private var sourceUrl: String = ""
+    private var qualityId: Int = AUTO
+    private var qualityOptions: List<QualityOption> = emptyList()
+
+    private data class QualityOption(val id: Int, val label: String, val height: Int, val bitrate: Long)
+
+    private val eqPresets = listOf(
+        PlayerEnhancePrefs.eqNames[0] to "",
+        PlayerEnhancePrefs.eqNames[1] to "equalizer=f=80:t=q:w=1:g=5,equalizer=f=200:t=q:w=1:g=3",
+        PlayerEnhancePrefs.eqNames[2] to "equalizer=f=300:t=q:w=1:g=-2,equalizer=f=2500:t=q:w=1:g=4,equalizer=f=4000:t=q:w=1:g=2",
+        PlayerEnhancePrefs.eqNames[3] to "equalizer=f=6000:t=q:w=1:g=4,equalizer=f=10000:t=q:w=1:g=4",
+    )
+
+    /** Loads the saved values and makes Settings > Playback show the Picture & sound section. */
+    fun install() {
+        PlayerEnhancePrefs.install(object : PlayerEnhancePrefs.Storage {
+            override fun getInt(key: String) = store.getInt(key)
+            override fun putInt(key: String, value: Int) = store.putInt(key, value)
+            override fun getBoolean(key: String) = store.getBoolean(key)
+            override fun putBoolean(key: String, value: Boolean) = store.putBoolean(key, value)
+        })
+        PlayerEnhancePrefs.onChanged = {
+            synchronized(gate) {
+                applyPictureLocked()
+                applyAudioLocked()
+            }
+            bump()
+        }
+    }
+
+    /** Called once the native player exists: reapplies saved settings and caps YouTube HLS. */
+    fun start(newHandle: Long, url: String) {
+        synchronized(gate) {
+            handle = newHandle
+            sourceUrl = url
+            qualityId = AUTO
+            qualityOptions = emptyList()
+            applyAllLocked()
+        }
+        if (hlsBitrateCapFor(url) != null) pinYouTubeVariantAsync(newHandle)
+        bump()
+    }
+
+    /**
+     * hls-bitrate is read when the stream opens, which is before this object gets the handle, so
+     * pick the variant by track id once the track list has appeared.
+     */
+    private fun pinYouTubeVariantAsync(forHandle: Long) {
+        Thread({
+            repeat(40) {
+                Thread.sleep(500)
+                val done = synchronized(gate) {
+                    if (handle != forHandle || qualityId != AUTO) return@Thread
+                    refreshQualityLocked()
+                    pinWithinCapLocked()
+                }
+                if (done) {
+                    bump()
+                    return@Thread
+                }
+            }
+        }, "enhance-pin-variant").apply { isDaemon = true }.start()
+    }
+
+    fun stop() {
+        synchronized(gate) { handle = 0 }
+    }
+
+    /**
+     * mpv never adapts between HLS variants, it plays the highest one. YouTube's master lists
+     * 1080p near 4.4 Mbps, which stalls on most links; cap at about 720p unless the viewer
+     * picks a variant by hand.
+     */
+    fun hlsBitrateCapFor(url: String): String? =
+        if (YouTubeStreamResolver.isYouTubeMedia(url)) YOUTUBE_HLS_CAP_BPS.toString() else null
+
+    fun handleEvent(type: String, value: Double): Boolean {
+        if (!type.startsWith("enh.")) return false
+        val key = type.removePrefix("enh.")
+        val level = value.toInt()
+        synchronized(gate) {
+            if (handle == 0L) return true
+            when {
+                key == "open" -> refreshQualityLocked()
+                key == "reset" -> PlayerEnhancePrefs.reset()
+                key.startsWith("pic.") -> {
+                    val name = key.removePrefix("pic.")
+                    PlayerEnhancePrefs.update {
+                        when (name) {
+                            "brightness" -> it.copy(brightness = level)
+                            "contrast" -> it.copy(contrast = level)
+                            "saturation" -> it.copy(saturation = level)
+                            "gamma" -> it.copy(gamma = level)
+                            "hue" -> it.copy(hue = level)
+                            "deband" -> it.copy(deband = level != 0)
+                            else -> it
+                        }
+                    }
+                }
+                key == "audio.gain" -> PlayerEnhancePrefs.update { it.copy(gainDb = level) }
+                key == "audio.norm" -> PlayerEnhancePrefs.update { it.copy(normalize = level != 0) }
+                key == "audio.eq" -> PlayerEnhancePrefs.update { it.copy(eq = level) }
+                key == "quality" -> selectQualityLocked(level)
+                else -> return true
+            }
+        }
+        bump()
+        return true
+    }
+
+    fun panelJson(): String = synchronized(gate) {
+        val v = PlayerEnhancePrefs.values.value
+        buildString {
+            append("{\"picture\":{")
+            append("\"brightness\":${v.brightness},\"contrast\":${v.contrast},\"saturation\":${v.saturation}")
+            append(",\"gamma\":${v.gamma},\"hue\":${v.hue},\"deband\":${v.deband}},\"audio\":{")
+            append("\"gainDb\":${v.gainDb},\"normalize\":${v.normalize},\"eq\":${v.eq},\"eqNames\":[")
+            PlayerEnhancePrefs.eqNames.joinTo(this, ",") { "\"$it\"" }
+            append("]},\"quality\":{\"selected\":").append(qualityId).append(",\"options\":[")
+            qualityOptions.joinTo(this, ",") {
+                "{\"id\":${it.id},\"label\":\"${it.label}\",\"height\":${it.height},\"bitrate\":${it.bitrate}}"
+            }
+            append("]}}")
+        }
+    }
+
+    private fun bump() {
+        version += 1
+        onChanged?.invoke()
+    }
+
+    /** Set by the controller; asks it to resend the controls JSON. */
+    @Volatile var onChanged: (() -> Unit)? = null
+
+    private fun setLocked(name: String, value: String) {
+        val current = handle
+        if (current == 0L) return
+        runCatching { NativePlayerBridge.propSetString(current, name, value) }
+    }
+
+    private fun applyAllLocked() {
+        hlsBitrateCapFor(sourceUrl)?.let { setLocked("hls-bitrate", it) }
+        applyPictureLocked()
+        applyAudioLocked()
+    }
+
+    private fun applyPictureLocked() {
+        val v = PlayerEnhancePrefs.values.value
+        setLocked("brightness", v.brightness.toString())
+        setLocked("contrast", v.contrast.toString())
+        setLocked("saturation", v.saturation.toString())
+        setLocked("gamma", v.gamma.toString())
+        setLocked("hue", v.hue.toString())
+        setLocked("deband", if (v.deband) "yes" else "no")
+    }
+
+    private fun applyAudioLocked() {
+        val v = PlayerEnhancePrefs.values.value
+        val filters = buildList {
+            if (v.gainDb > 0) add("volume=${v.gainDb}dB")
+            if (v.normalize) add("dynaudnorm=f=250:g=15")
+            eqPresets[v.eq.coerceIn(0, eqPresets.lastIndex)].second.takeIf { it.isNotEmpty() }?.let { add(it) }
+            if (v.gainDb > 0) add("alimiter=limit=0.95")
+        }
+        setLocked("af", if (filters.isEmpty()) "" else "lavfi=[${filters.joinToString(",")}]")
+    }
+
+    private fun refreshQualityLocked() {
+        val current = handle
+        if (current == 0L) return
+        runCatching {
+            val count = NativePlayerBridge.propGetString(current, "track-list/count")?.toIntOrNull() ?: 0
+            val found = mutableListOf<QualityOption>()
+            for (index in 0 until count) {
+                val base = "track-list/$index"
+                if (NativePlayerBridge.propGetString(current, "$base/type") != "video") continue
+                val id = NativePlayerBridge.propGetString(current, "$base/id")?.toIntOrNull() ?: continue
+                val height = NativePlayerBridge.propGetString(current, "$base/demux-h")?.toIntOrNull() ?: 0
+                val bitrate = NativePlayerBridge.propGetString(current, "$base/hls-bitrate")?.toLongOrNull() ?: 0L
+                val codec = NativePlayerBridge.propGetString(current, "$base/codec").orEmpty()
+                val label = buildString {
+                    append(if (height > 0) "${height}p" else "Video $id")
+                    if (bitrate > 0) append(" · ").append(String.format("%.1f", bitrate / 1_000_000.0)).append(" Mbps")
+                    if (codec.isNotEmpty()) append(" · ").append(codec.uppercase().filter { it.isLetterOrDigit() })
+                }
+                found += QualityOption(id, label, height, bitrate)
+            }
+            qualityOptions = found.sortedWith(compareByDescending<QualityOption> { it.height }.thenByDescending { it.bitrate })
+        }
+    }
+
+    /** Picks the best variant under the YouTube cap; false while no variant list exists yet. */
+    private fun pinWithinCapLocked(): Boolean {
+        val pick = qualityOptions
+            .filter { it.bitrate in 1..YOUTUBE_HLS_CAP_BPS }
+            .maxByOrNull { it.bitrate }
+            ?: return false
+        setLocked("vid", pick.id.toString())
+        return true
+    }
+
+    private fun selectQualityLocked(id: Int) {
+        qualityId = id
+        when {
+            id != AUTO -> setLocked("vid", id.toString())
+            hlsBitrateCapFor(sourceUrl) != null && pinWithinCapLocked() -> Unit
+            else -> setLocked("vid", "auto")
+        }
+    }
+
+    private const val AUTO = -1
+    private const val YOUTUBE_HLS_CAP_BPS = 2_500_000
+}
