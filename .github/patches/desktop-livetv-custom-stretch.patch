+package com.nuvio.app.features.player
+
+import androidx.compose.runtime.compositionLocalOf
+import com.nuvio.app.features.livetv.isLiveTvContentType
+import com.nuvio.app.isDesktop
+
+/**
+ * Live TV on the desktop player always plays with Custom Stretch (no setting): the black bars baked
+ * into the channel's picture are removed and the picture is stretched over the whole player. The
+ * main player's own aspect mode (and the saved setting) is not touched for anything else.
+ */
+internal val PlayerScreenRuntime.liveTvAutoStretch: Boolean
+    get() = isDesktop && isLiveTvContentType(contentType)
+
+/** The resize mode the player surface really uses: Custom Stretch for Live TV, else the chosen mode. */
+internal val PlayerScreenRuntime.effectiveResizeMode: PlayerResizeMode
+    get() = if (liveTvAutoStretch) PlayerResizeMode.CustomStretch else resizeMode
+
+/** True for channels whose own baked-in bars are wider than the movie limits allow. */
+internal val PlayerScreenRuntime.liveTvWideBars: Boolean
+    get() = liveTvAutoStretch && isWideBarsChannel(title)
+
+/** Channels whose own baked-in bars are wider than the movie limits allow (music channels with letterboxed clips). */
+internal fun isWideBarsChannel(name: String?): Boolean {
+    val key = name?.lowercase()?.filter { it.isLetterOrDigit() } ?: return false
+    return key.contains("9xm") || key.contains("b4u")
+}
+
+/** Wide-bars Live TV channel (see [isWideBarsChannel]); false everywhere else. Read by the sampling loop. */
+internal val LocalLiveTvWideBars = compositionLocalOf { false }
