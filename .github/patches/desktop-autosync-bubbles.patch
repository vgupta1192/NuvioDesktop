+/* AutoSync bubble (NuvioMobile-Reshaped style) */
+.autosync-bubble {
+  position: absolute;
+  top: calc(20px + env(safe-area-inset-top));
+  left: 50%;
+  z-index: 43;
+  max-width: min(420px, calc(100% - 40px));
+  min-height: 46px;
+  padding: 8px 18px 8px 8px;
+  border: 1px solid rgba(255, 255, 255, .16);
+  border-radius: 23px;
+  background:
+    linear-gradient(180deg, rgba(255, 255, 255, .10), rgba(255, 255, 255, .02)),
+    rgba(42, 42, 46, .72);
+  color: #fff;
+  box-shadow: 0 18px 44px rgba(0, 0, 0, .36), inset 0 1px 0 rgba(255, 255, 255, .14);
+  display: flex;
+  align-items: center;
+  gap: 11px;
+  opacity: 0;
+  transform: translate3d(-50%, -14px, 0) scale(.92);
+  pointer-events: none;
+  backdrop-filter: blur(22px) saturate(1.35);
+  -webkit-backdrop-filter: blur(22px) saturate(1.35);
+  transition:
+    opacity 280ms var(--ease-out),
+    transform 380ms cubic-bezier(.34, 1.56, .64, 1),
+    border-color 300ms var(--ease-out);
+  will-change: opacity, transform;
+}
+
+.autosync-bubble.visible {
+  opacity: 1;
+  transform: translate3d(-50%, 0, 0) scale(1);
+}
+
+.autosync-bubble.visible.pop .autosync-orb {
+  animation: autosync-orb-pop 420ms cubic-bezier(.34, 1.56, .64, 1);
+}
+
+.autosync-bubble[data-kind="success"] { border-color: rgba(48, 209, 88, .45); }
+.autosync-bubble[data-kind="failure"] { border-color: rgba(255, 69, 58, .45); }
+
+.player.opening-active .autosync-bubble,
+.player.error-active .autosync-bubble {
+  opacity: 0;
+}
+
+.autosync-orb {
+  position: relative;
+  width: 30px;
+  height: 30px;
+  flex-shrink: 0;
+  border-radius: 50%;
+  background: rgba(255, 255, 255, .12);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  transition: background-color 300ms var(--ease-out);
+}
+
+.autosync-bubble[data-kind="success"] .autosync-orb { background: #30d158; }
+.autosync-bubble[data-kind="failure"] .autosync-orb { background: #ff453a; }
+
+.autosync-orb-spinner {
+  width: 18px;
+  height: 18px;
+  border-radius: 50%;
+  border: 2.4px solid rgba(255, 255, 255, .25);
+  border-top-color: #fff;
+  animation: autosync-spin 900ms linear infinite;
+}
+
+.autosync-orb-icon {
+  display: none;
+  width: 18px;
+  height: 18px;
+  fill: none;
+  stroke: #fff;
+  stroke-width: 2.6;
+  stroke-linecap: round;
+  stroke-linejoin: round;
+}
+
+.autosync-bubble:not([data-kind="working"]) .autosync-orb-spinner { display: none; }
+.autosync-bubble[data-kind="success"] .autosync-orb-check,
+.autosync-bubble[data-kind="failure"] .autosync-orb-cross { display: block; }
+
+.autosync-text {
+  display: flex;
+  flex-direction: column;
+  min-width: 0;
+  line-height: 1.25;
+}
+
+.autosync-label {
+  font-size: 11px;
+  font-weight: 600;
+  letter-spacing: .02em;
+  color: rgba(255, 255, 255, .55);
+}
+
+.autosync-headline {
+  font-size: 14px;
+  font-weight: 650;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.autosync-detail {
+  font-size: 12px;
+  color: rgba(255, 255, 255, .62);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+@keyframes autosync-spin {
+  to { transform: rotate(360deg); }
+}
+
+@keyframes autosync-orb-pop {
+  0% { transform: scale(.6); }
+  100% { transform: scale(1); }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .autosync-bubble { transition: opacity 200ms linear; }
+  .autosync-orb-spinner { animation-duration: 2400ms; }
+  .autosync-bubble.visible.pop .autosync-orb { animation: none; }
+}
+
 [hidden] {
   display: none !important;
 }
