+// Error-signalling variants of the helpers above for the generic JNI escape
+// hatch (propGetString/propSetString): callers need to distinguish a missing
+// property from an empty one.
+- (NSString *)rawStringProperty:(const char *)name {
+    if (!_mpv || !name) return nil;
+    char *value = nullptr;
+    if (mpv_get_property(_mpv, name, MPV_FORMAT_STRING, &value) < 0 || !value) {
+        return nil;
+    }
+    NSString *result = [NSString stringWithUTF8String:value];
+    mpv_free(value);
+    return result;
+}
+
+- (BOOL)rawSetStringProperty:(const char *)name value:(NSString *)value {
+    if (!_mpv || !name) return NO;
+    return mpv_set_property_string(_mpv, name, (value ?: @"").UTF8String) >= 0;
+}
