+// Generic mpv escape hatch so feature work (seek previews, generated
+// subtitles, per-title styling) does not need a bespoke JNI function each.
+extern "C" JNIEXPORT jstring JNICALL
+Java_com_nuvio_app_features_player_desktop_NativePlayerBridge_propGetString(
+    JNIEnv *env,
+    jobject /* bridge */,
+    jlong handle,
+    jstring name
+) {
+    if (handle == 0 || !name) return nullptr;
+    MpvWebPlayer *player = (__bridge MpvWebPlayer *)(void *)(intptr_t)handle;
+    std::string prop = jstringToString(env, name);
+    NSString *value = [player rawStringProperty:prop.c_str()];
+    return value ? env->NewStringUTF(value.UTF8String) : nullptr;
+}
+
+extern "C" JNIEXPORT jboolean JNICALL
+Java_com_nuvio_app_features_player_desktop_NativePlayerBridge_propSetString(
+    JNIEnv *env,
+    jobject /* bridge */,
+    jlong handle,
+    jstring name,
+    jstring value
+) {
+    if (handle == 0 || !name || !value) return JNI_FALSE;
+    MpvWebPlayer *player = (__bridge MpvWebPlayer *)(void *)(intptr_t)handle;
+    std::string prop = jstringToString(env, name);
+    std::string val = jstringToString(env, value);
+    return [player rawSetStringProperty:prop.c_str()
+                                  value:[NSString stringWithUTF8String:val.c_str()]]
+               ? JNI_TRUE : JNI_FALSE;
+}
+
+extern "C" JNIEXPORT jboolean JNICALL
+Java_com_nuvio_app_features_player_desktop_NativePlayerBridge_command(
+    JNIEnv *env,
+    jobject /* bridge */,
+    jlong handle,
+    jobjectArray args
+) {
+    if (handle == 0 || !args) return JNI_FALSE;
+    MpvWebPlayer *player = (__bridge MpvWebPlayer *)(void *)(intptr_t)handle;
+    NSArray<NSString *> *argv = jstringArrayToNSArray(env, args);
+    if (argv.count == 0) return JNI_FALSE;
+    [player command:argv];
+    return JNI_TRUE;
+}
