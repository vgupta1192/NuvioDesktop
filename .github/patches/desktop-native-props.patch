+// Generic mpv escape hatch so feature work (seek previews, generated
+// subtitles, per-title styling) does not need a bespoke JNI function each.
+JNIEXPORT jstring JNICALL NP(propGetString)(JNIEnv *env, jobject, jlong handle, jstring name) {
+    Player *p = asPlayer(handle);
+    if (!p || !p->mpv || !name) return nullptr;
+    char *value = nullptr;
+    if (mpv_get_property(p->mpv, jstringToUtf8(env, name).c_str(), MPV_FORMAT_STRING, &value) < 0 || !value) {
+        return nullptr;
+    }
+    jstring out = utf8ToJstring(env, value);
+    mpv_free(value);
+    return out;
+}
+
+JNIEXPORT jboolean JNICALL NP(propSetString)(JNIEnv *env, jobject, jlong handle, jstring name, jstring value) {
+    Player *p = asPlayer(handle);
+    if (!p || !p->mpv || !name || !value) return JNI_FALSE;
+    int err = mpv_set_property_string(p->mpv, jstringToUtf8(env, name).c_str(),
+                                      jstringToUtf8(env, value).c_str());
+    return err >= 0 ? JNI_TRUE : JNI_FALSE;
+}
+
+JNIEXPORT jboolean JNICALL NP(command)(JNIEnv *env, jobject, jlong handle, jobjectArray args) {
+    Player *p = asPlayer(handle);
+    if (!p || !p->mpv || !args) return JNI_FALSE;
+    jsize count = env->GetArrayLength(args);
+    if (count <= 0) return JNI_FALSE;
+    // Storage must outlive argv: mpv_command reads the strings synchronously.
+    std::vector<std::string> storage;
+    storage.reserve(count);
+    std::vector<const char *> argv;
+    argv.reserve(count + 1);
+    for (jsize i = 0; i < count; ++i) {
+        jstring item = (jstring) env->GetObjectArrayElement(args, i);
+        storage.push_back(item ? jstringToUtf8(env, item) : std::string());
+        if (item) env->DeleteLocalRef(item);
+        argv.push_back(storage.back().c_str());
+    }
+    argv.push_back(nullptr);
+    int err = mpv_command(p->mpv, argv.data());
+    return err >= 0 ? JNI_TRUE : JNI_FALSE;
+}
