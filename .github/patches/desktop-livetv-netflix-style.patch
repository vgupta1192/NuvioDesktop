+@Composable
+private fun NetflixStyleChip(selected: Boolean, onClick: () -> Unit) {
+    val tokens = MaterialTheme.nuvio
+    val shape = RoundedCornerShape(50)
+    Text(
+        text = stringResource(Res.string.livetv_netflix_style_chip),
+        style = MaterialTheme.typography.labelLarge,
+        fontWeight = FontWeight.SemiBold,
+        color = if (selected) tokens.colors.onAccent else tokens.colors.textPrimary,
+        maxLines = 1,
+        modifier = Modifier
+            .clip(shape)
+            .background(if (selected) tokens.colors.accent else tokens.colors.surfaceCard)
+            .border(1.dp, if (selected) tokens.colors.accent else tokens.colors.borderDefault, shape)
+            .clickable(onClick = onClick)
+            .padding(horizontal = 14.dp, vertical = 7.dp),
+    )
+}
+
+/** Netflix style Live TV: landscape card, logo on top, programme title and progress over a scrim. */
+@Composable
+private fun LiveTvChannelCard(
+    channel: LiveTvChannel,
+    epg: ChannelEpgInfo?,
+    nowMs: Long,
+    selected: Boolean,
+    favorite: Boolean,
+    onClick: () -> Unit,
+) {
+    val tokens = MaterialTheme.nuvio
+    val shape = RoundedCornerShape(12.dp)
+    Box(
+        modifier = Modifier
+            .fillMaxWidth()
+            .aspectRatio(16f / 9f)
+            .clip(shape)
+            .background(tokens.colors.surfaceCard)
+            .then(if (selected) Modifier.border(2.dp, tokens.colors.accent, shape) else Modifier)
+            .clickable(onClick = onClick),
+    ) {
+        ChannelLogo(
+            channel,
+            Modifier.align(Alignment.TopCenter).padding(top = 10.dp).fillMaxWidth(0.5f).fillMaxHeight(0.5f),
+        )
+        Column(
+            modifier = Modifier
+                .align(Alignment.BottomStart)
+                .fillMaxWidth()
+                .background(Brush.verticalGradient(listOf(Color.Transparent, Color.Black.copy(alpha = 0.85f))))
+                .padding(start = 10.dp, end = 10.dp, top = 18.dp, bottom = 8.dp),
+        ) {
+            Text(
+                text = channel.name,
+                style = MaterialTheme.typography.titleSmall,
+                fontWeight = FontWeight.SemiBold,
+                color = Color.White,
+                maxLines = 1,
+                overflow = TextOverflow.Ellipsis,
+            )
+            val now = epg?.nowProgram
+            if (now != null) {
+                Text(
+                    text = now.title,
+                    style = MaterialTheme.typography.bodySmall,
+                    color = Color.White.copy(alpha = 0.8f),
+                    maxLines = 1,
+                    overflow = TextOverflow.Ellipsis,
+                )
+                Spacer(Modifier.height(4.dp))
+                LinearProgressIndicator(
+                    progress = now.progress(nowMs),
+                    modifier = Modifier.fillMaxWidth().height(3.dp).clip(RoundedCornerShape(2.dp)),
+                )
+            } else {
+                Text(
+                    text = listOfNotNull(channel.primaryGenre ?: channel.catalogName, channel.addonName).distinct().joinToString(" · "),
+                    style = MaterialTheme.typography.bodySmall,
+                    color = Color.White.copy(alpha = 0.6f),
+                    maxLines = 1,
+                    overflow = TextOverflow.Ellipsis,
+                )
+            }
+        }
+        IconButton(
+            onClick = { LiveTvRepository.toggleFavorite(channel) },
+            modifier = Modifier.align(Alignment.TopEnd).size(36.dp),
+        ) {
+            Icon(
+                imageVector = if (favorite) Icons.Rounded.Star else Icons.Rounded.StarBorder,
+                contentDescription = if (favorite) "Remove from favorites" else "Add to favorites",
+                tint = if (favorite) tokens.colors.warning else tokens.colors.textMuted,
+            )
+        }
+    }
+}
