+
+private const val LiveTvPreviewHoverDelayMillis = 900L
+
+/**
+ * Netflix style Live TV preview: the selected channel's first stream plays muted above the details
+ * after a short delay, over the channel logo. A stream that cannot be played just leaves the logo.
+ */
+@Composable
+private fun LiveTvMutedPreview(channel: LiveTvChannel, option: LiveTvStreamOption?) {
+    val tokens = MaterialTheme.nuvio
+    val shape = RoundedCornerShape(12.dp)
+    val url = option?.url
+    var started by remember(channel.stableKey(), url) { mutableStateOf(false) }
+    var ready by remember(channel.stableKey(), url) { mutableStateOf(false) }
+    var failed by remember(channel.stableKey(), url) { mutableStateOf(false) }
+    LaunchedEffect(channel.stableKey(), url) {
+        if (url != null) {
+            delay(LiveTvPreviewHoverDelayMillis)
+            started = true
+        }
+    }
+    Box(
+        modifier = Modifier
+            .fillMaxWidth()
+            .aspectRatio(16f / 9f)
+            .clip(shape)
+            .background(Color.Black),
+        contentAlignment = Alignment.Center,
+    ) {
+        ChannelLogo(channel, Modifier.fillMaxWidth(0.4f).fillMaxHeight(0.5f))
+        if (url != null && started && !failed) {
+            HeroTrailerPlayerSurface(
+                sourceUrl = url,
+                sourceAudioUrl = null,
+                playWhenReady = true,
+                muted = true,
+                fillFrame = false,
+                modifier = Modifier.fillMaxSize().graphicsLayer { alpha = if (ready) 1f else 0f },
+                onReady = { ready = true },
+                onEnded = { ready = false; failed = true },
+                onError = { ready = false; failed = true },
+            )
+        }
+        Text(
+            text = stringResource(Res.string.livetv_preview_live_badge),
+            style = MaterialTheme.typography.labelSmall,
+            fontWeight = FontWeight.Bold,
+            color = Color.White,
+            modifier = Modifier
+                .align(Alignment.TopStart)
+                .padding(8.dp)
+                .clip(RoundedCornerShape(4.dp))
+                .background(tokens.colors.danger)
+                .padding(horizontal = 6.dp, vertical = 2.dp),
+        )
+    }
+}
