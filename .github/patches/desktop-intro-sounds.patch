+import com.nuvio.app.features.settings.ForkPrefs
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/** Nuvio fork (dx.bi port): startup cinematic intro and soft interface sounds. Both are OFF by default. */
+internal object DxSounds {
+        const val INTRO_MS = 2600L
+
+    private var loaded = false
+    private var introShownThisLaunch = false
+
+    private val _introEnabled = MutableStateFlow(false)
+    val introEnabled: StateFlow<Boolean> = _introEnabled.asStateFlow()
+    private val _uiSoundsEnabled = MutableStateFlow(false)
+    val uiSoundsEnabled: StateFlow<Boolean> = _uiSoundsEnabled.asStateFlow()
+
+    fun ensureLoaded() {
+        if (loaded) return
+        loaded = true
+        _introEnabled.value = ForkPrefs.introSound.current()
+        _uiSoundsEnabled.value = ForkPrefs.uiSounds.current()
+    }
+
+    fun setIntroEnabled(value: Boolean) {
+        ensureLoaded()
+        _introEnabled.value = value
+        ForkPrefs.introSound.set(value)
+    }
+
+    fun setUiSoundsEnabled(value: Boolean) {
+        ensureLoaded()
+        _uiSoundsEnabled.value = value
+        ForkPrefs.uiSounds.set(value)
+    }
+
+    /** True once per app launch, and only when the intro is switched on. */
+    fun shouldShowIntro(): Boolean {
+        ensureLoaded()
+        if (introShownThisLaunch || !_introEnabled.value) return false
+        introShownThisLaunch = true
+        return true
+    }
+
+    fun click() {
+        ensureLoaded()
+        if (_uiSoundsEnabled.value) runCatching { DxSoundPlatform.playClick() }
+    }
+
+    /** Preview from Settings: plays the intro sound without the overlay. */
+    fun previewIntroSound() {
+        runCatching { DxSoundPlatform.playIntro() }
+    }
+}
+
+/** Full-screen intro on top of the app. Plays once per launch, tap to skip. */
+@Composable
+internal fun DxIntroHost(content: @Composable () -> Unit) {
+    val show = remember { DxSounds.shouldShowIntro() }
+    var visible by remember { mutableStateOf(true) }
+    content()
+    if (show && visible) {
+        DxIntroOverlay(onFinished = { visible = false })
+    }
+}
+
+@Composable
+private fun DxIntroOverlay(onFinished: () -> Unit) {
+    val fade = remember { Animatable(0f) }
+    val grow = remember { Animatable(0.82f) }
+    val out = remember { Animatable(1f) }
+    LaunchedEffect(Unit) {
+        runCatching { DxSoundPlatform.playIntro() }
+        fade.animateTo(1f, tween(900, easing = FastOutSlowInEasing))
+    }
+    LaunchedEffect(Unit) {
+        grow.animateTo(1.08f, tween(DxSounds.INTRO_MS.toInt(), easing = FastOutSlowInEasing))
+    }
+    LaunchedEffect(Unit) {
+        delay(DxSounds.INTRO_MS - 500L)
+        out.animateTo(0f, tween(500))
+        onFinished()
+    }
+    Box(
+        modifier = Modifier
+            .fillMaxSize()
+            .alpha(out.value)
+            .background(Color.Black)
+            .clickable(
+                interactionSource = remember { MutableInteractionSource() },
+                indication = null,
+            ) {
+                runCatching { DxSoundPlatform.stopIntro() }
+                onFinished()
+            },
+        contentAlignment = Alignment.Center,
+    ) {
+        Text(
+            text = "NUVIO",
+            color = MaterialTheme.colorScheme.primary,
+            fontSize = 44.sp,
+            fontWeight = FontWeight.Black,
+            letterSpacing = 10.sp,
+            modifier = Modifier.alpha(fade.value).scale(grow.value),
+        )
+    }
+}
