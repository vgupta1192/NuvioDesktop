+++ b/composeApp/src/desktopMain/kotlin/com/nuvio/app/features/player/autosync/AutoSyncSubtitleHttp.kt
@@ -0,0 +1,135 @@
+package com.nuvio.app.features.player.autosync
+
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.withContext
+import java.io.ByteArrayOutputStream
+import java.net.URI
+import java.net.http.HttpClient
+import java.net.http.HttpRequest
+import java.net.http.HttpResponse
+import java.time.Duration
+import kotlin.text.Charsets
+
+/**
+ * AutoSync-only subtitle HTTP path (desktop replacement for NuvioTV's OkHttp-based AutoSyncSubtitleHttp, same name).
+ *
+ * Runs on Dispatchers.IO with a hard response-size cap; the read loop polls coroutine
+ * cancellation, and the request timeout bounds any straggling call.
+ */
+internal object AutoSyncSubtitleHttp {
+    private const val READ_BUFFER_BYTES = 32 * 1024
+    private const val INITIAL_BUFFER_BYTES = 64 * 1024
+    private const val TRUNCATION_SUFFIX = "\n...[truncated]"
+    private const val REQUEST_TIMEOUT_MS = 15_000L
+
+    private val httpClient: HttpClient = HttpClient.newBuilder()
+        .followRedirects(HttpClient.Redirect.NORMAL)
+        .connectTimeout(Duration.ofSeconds(5))
+        .build()
+
+    suspend fun get(
+        url: String,
+        headers: Map<String, String>,
+        maxResponseBodyBytes: Int,
+    ): AutoSyncRawHttpResponse {
+        val callerContext = currentCoroutineContext()
+        return withContext(Dispatchers.IO) {
+            try {
+                val requestBuilder = HttpRequest.newBuilder(URI.create(url))
+                    .GET()
+                    .timeout(Duration.ofMillis(REQUEST_TIMEOUT_MS))
+                headers.forEach { (name, value) ->
+                    // Let the HTTP stack negotiate transparent compression instead of forwarding
+                    // caller-provided Accept-Encoding, matching the TV build's raw-HTTP behavior.
+                    if (!name.equals("Accept-Encoding", ignoreCase = true)) {
+                        requestBuilder.header(name, value)
+                    }
+                }
+
+                val response = httpClient.send(
+                    requestBuilder.build(),
+                    HttpResponse.BodyHandlers.ofInputStream(),
+                )
+                response.body().use { stream ->
+                    val body = readResponseBodyLimited(
+                        stream = stream,
+                        maxBytes = maxResponseBodyBytes,
+                        contentType = response.headers().firstValue("Content-Type").orElse(null),
+                        onCancel = { callerContext.ensureActive() },
+                    )
+                    AutoSyncRawHttpResponse(
+                        status = response.statusCode(),
+                        statusText = "",
+                        url = response.uri().toString(),
+                        body = body,
+                        headers = response.headers().map()
+                            .mapKeys { (name, _) -> name.lowercase() }
+                            .mapValues { (_, values) -> values.joinToString(",") },
+                    )
+                }
+            } catch (cancel: CancellationException) {
+                throw cancel
+            } catch (error: Exception) {
+                callerContext.ensureActive()
+                throw error
+            }
+        }
+    }
+
+    private fun readResponseBodyLimited(
+        stream: java.io.InputStream,
+        maxBytes: Int,
+        contentType: String?,
+        onCancel: () -> Unit,
+    ): String {
+        val limit = maxBytes.coerceAtLeast(0)
+        val output = ByteArrayOutputStream(INITIAL_BUFFER_BYTES)
+        val buffer = ByteArray(READ_BUFFER_BYTES)
+        var remaining = limit
+        var truncated = false
+
+        while (remaining > 0) {
+            onCancel()
+            val read = stream.read(buffer, 0, minOf(buffer.size, remaining))
+            if (read < 0) break
+            if (read == 0) continue
+            output.write(buffer, 0, read)
+            remaining -= read
+        }
+
+        if (remaining == 0) {
+            truncated = stream.read() != -1
+        }
+
+        val bytes = output.toByteArray()
+        val charset = contentType
+            ?.substringAfter(';', "")
+            ?.trim()
+            ?.removePrefix("charset=")
+            ?.removePrefix("\"")
+            ?.trimEnd('"')
+            ?.takeIf { it.isNotBlank() }
+            ?.let { name ->
+                runCatching { java.nio.charset.Charset.forName(name) }.getOrNull()
+            }
+            ?: Charsets.UTF_8
+        val decoded = try {
+            String(bytes, charset)
+        } catch (_: Exception) {
+            String(bytes, Charsets.UTF_8)
+        }
+
+        return if (truncated) "$decoded$TRUNCATION_SUFFIX" else decoded
+    }
+}
+
+internal data class AutoSyncRawHttpResponse(
+    val status: Int,
+    val statusText: String,
+    val url: String,
+    val body: String,
+    val headers: Map<String, String>,
+)
