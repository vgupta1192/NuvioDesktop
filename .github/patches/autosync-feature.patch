+package com.nuvio.app.features.player
+
+import com.nuvio.app.features.streams.StreamSubtitle
+
+/**
+ * Optional AutoSync (automatic subtitle sync) capability layered beside PlayerEngineController.
+ * Implemented only by engines that can run the analysis (desktop libmpv); other platforms keep
+ * the plain subtitle attach path. Mirrors NuvioTV's AutoSyncPlayerController contract.
+ */
+interface AutoSyncPlayerController {
+    /** Attach [url] as an external subtitle and run AutoSync in startup scope (once per stream). */
+    fun setSubtitleUriWithAutoSync(url: String)
+
+    /** Attach [url] as an external subtitle and always run AutoSync for exactly this subtitle. */
+    fun setSubtitleUriWithSelectedAutoSync(url: String)
+
+    /** Called after AutoSync confirmed or corrected the timing of [subtitleUrl]. */
+    fun setAutoSyncAppliedListener(listener: ((subtitleUrl: String, delayMs: Int) -> Unit)?) {}
+
+    /** Called with a short user-facing message when AutoSync cannot sync the subtitle. */
+    fun setAutoSyncMessageListener(listener: ((message: String) -> Unit)?) {}
+
+    /**
+     * Called with AutoSync's progress for the Reshaped-style bubble: [kind] is "working",
+     * "success", "failure" or "dismiss". Used instead of the message listener while the
+     * bubble is turned on.
+     */
+    fun setAutoSyncBubbleListener(listener: ((kind: String, message: String) -> Unit)?) {}
+
+    /**
+     * Stream-typed candidates (carrying request headers): the stream's own subtitles plus every
+     * add-on's, pushed by the player runtime. The player surface's own list only ever contains
+     * the stream's subtitles - without this push, a picked add-on subtitle cannot be matched to
+     * a candidate and AutoSync silently skips it.
+     */
+    fun setAutoSyncSubtitleStreamCandidates(candidates: List<StreamSubtitle>) {}
+}
+
+/** One downloadable add-on subtitle AutoSync may analyse or swap in as a better match. */
+data class AutoSyncSubtitleCandidate(
+    val url: String,
+    val language: String,
+    val name: String? = null,
+)
