+package com.nuvio.app.features.player.autosync
+
+import com.nuvio.app.core.storage.DesktopStorage
+import com.nuvio.app.core.storage.ProfileScopedKey
+import com.nuvio.app.features.autosync.AutoSyncPreferencesRepository
+
+/**
+ * Nuvio fork: persists the mobile-style AutoSync settings rows (auto-sync at start, thorough
+ * search, tolerance) on the desktop, the way AutoSyncPreferencesAndroid does on phones. Without
+ * this the rows render with defaults and forget every change.
+ *
+ * Also migrates the removed old engine's toggle: users who had turned AutoSync on in the
+ * duplicate settings section keep it on (the old store's enabled flag seeds auto-sync-on-start
+ * the first time the new keys are read).
+ */
+internal object AutoSyncPreferencesPlatform {
+    private const val STORE_NAME = "nuvio_autosync_settings"
+    private const val AUTO_SYNC_ON_START_KEY = "preferred_subtitle_auto_sync_on_start"
+    private const val AGGRESSIVE_MODE_KEY = "auto_sync_aggressive_mode"
+    private const val SYNC_TOLERANCE_MS_KEY = "auto_sync_tolerance_ms"
+
+    private const val LEGACY_STORE_NAME = "nuvio_autosync"
+    private const val LEGACY_ENABLED_KEY = "automatic_subtitle_sync_enabled"
+
+    @Volatile
+    private var installed = false
+
+    fun install() {
+        if (installed) return
+        synchronized(this) {
+            if (installed) return
+            val store = DesktopStorage.store(STORE_NAME)
+            AutoSyncPreferencesRepository.installPersistence(
+                load = { store.getBoolean(ProfileScopedKey.of(AUTO_SYNC_ON_START_KEY)) },
+                save = { enabled -> store.putBoolean(ProfileScopedKey.of(AUTO_SYNC_ON_START_KEY), enabled) },
+                loadAggressiveMode = { store.getBoolean(ProfileScopedKey.of(AGGRESSIVE_MODE_KEY)) },
+                saveAggressiveMode = { enabled -> store.putBoolean(ProfileScopedKey.of(AGGRESSIVE_MODE_KEY), enabled) },
+                loadSyncToleranceMs = { store.getInt(ProfileScopedKey.of(SYNC_TOLERANCE_MS_KEY)) },
+                saveSyncToleranceMs = { toleranceMs -> store.putInt(ProfileScopedKey.of(SYNC_TOLERANCE_MS_KEY), toleranceMs) },
+            )
+            // One-time migration: the old cue-reference engine's enable toggle becomes the
+            // mobile-style auto-sync-at-start toggle when the new keys were never written.
+            AutoSyncPreferencesRepository.ensureLoaded()
+            val newUserValue = store.getBoolean(ProfileScopedKey.of(AUTO_SYNC_ON_START_KEY))
+            if (newUserValue == null &&
+                !AutoSyncPreferencesRepository.preferredSubtitleAutoSyncOnStart.value
+            ) {
+                when (DesktopStorage.store(LEGACY_STORE_NAME).getBoolean(LEGACY_ENABLED_KEY)) {
+                    // The user had the old engine on: keep it on.
+                    true -> AutoSyncPreferencesRepository.setPreferredSubtitleAutoSyncOnStart(true)
+                    // The user explicitly turned the old engine off: respect that.
+                    false -> Unit
+                    // Never chose anywhere (fresh install): this fork exists to play with
+                    // AutoSync, so start with it on instead of a silent no-op engine.
+                    null -> AutoSyncPreferencesRepository.setPreferredSubtitleAutoSyncOnStart(true)
+                }
+            }
+            installed = true
+        }
+    }
+}
diff --git a/composeApp/src/desktopMain/kotlin/com/nuvio/app/features/player/autosync/AutoSyncSubtitleCueParser.kt b/composeApp/src/desktopMain/kotlin/com/nuvio/app/features/player/autosync/AutoSyncSubtitleCueParser.kt
new file mode 100644
