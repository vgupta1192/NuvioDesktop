+++ b/composeApp/src/desktopMain/kotlin/com/nuvio/app/features/player/autosync/PlayerAutoSyncBridge.kt
@@ -0,0 +1,213 @@
+package com.nuvio.app.features.player.autosync
+
+import com.nuvio.app.core.storage.DesktopStorage
+import com.nuvio.app.features.player.PlayerEngineController
+import com.nuvio.app.features.player.SubtitleSyncCue
+import java.nio.file.Files
+import java.nio.file.Path
+import java.nio.file.StandardCopyOption
+import kotlin.math.abs
+import kotlin.math.roundToLong
+
+private const val BOUNDARY_TOLERANCE_MS = 500L
+private const val DIRECT_INDEX_TOLERANCE_MS = 50L
+private const val RETIMED_FILES_TO_KEEP = 4
+
+/**
+ * Applies an AutoSync retiming to the mpv-based desktop player. mpv cannot retime a loaded
+ * subtitle track, so the confident path materializes the retimed cues as a temporary SRT file
+ * and swaps the external track onto it; the caller resets mpv's sub-delay first so the baked
+ * correction is not applied twice.
+ */
+internal object PlayerAutoSyncBridge {
+    private val retimeDir: Path by lazy {
+        DesktopStorage.cacheDir.resolve("autosync").also { Files.createDirectories(it) }
+    }
+
+    /**
+     * Writes [cues] retimed by [timeline] to a temp SRT file, clears any manual sub-delay and
+     * swaps the player's external subtitle to the retimed file. Returns false when nothing was
+     * written (the caller then attaches the original subtitle unchanged).
+     */
+    /** Nuvio fork: the last retimed subtitle as SRT, saved as a synced subtitle on success. */
+    @Volatile
+    var lastRetimedSrt: String? = null
+
+    fun attachRetimedSubtitle(
+        base: PlayerEngineController,
+        cues: List<SubtitleSyncCue>,
+        timeline: AutoSyncTimelineRetimeResult,
+    ): Boolean {
+        if (cues.isEmpty() || timeline.cues.isEmpty()) return false
+        val retimed = retimeCues(cues, timeline)
+        if (retimed.isEmpty()) return false
+        val file = try {
+            writeRetimedSrt(retimed)
+        } catch (_: Exception) {
+            return false
+        }
+        // mpv's sub-delay is global and sticky across sub-add; zero it before the swap so the
+        // baked correction is not doubled. This also clears the controller's pending delay.
+        base.setSubtitleDelayMs(0)
+        base.setSubtitleUri(file.toAbsolutePath().toString())
+        pruneOldRetimeFiles(keep = file)
+        return true
+    }
+
+    /** Port of the TV sidecar bridge's retime mapping (direct index, boundaries, affine). */
+    private fun retimeCues(
+        source: List<SubtitleSyncCue>,
+        timeline: AutoSyncTimelineRetimeResult,
+    ): List<SubtitleSyncCue> {
+        retimeByIndexIfCompatible(source, timeline)?.let { direct -> return direct }
+
+        val startBoundaries = ArrayList<TimingBoundary>(timeline.cues.size)
+        val endBoundaries = ArrayList<TimingBoundary>(timeline.cues.size)
+        timeline.cues.forEach { cue ->
+            startBoundaries += TimingBoundary(cue.originalStartTimeMs, cue.startTimeMs)
+            endBoundaries += TimingBoundary(cue.originalEndTimeMs, cue.endTimeMs)
+        }
+        startBoundaries.sortBy { it.originalMs }
+        endBoundaries.sortBy { it.originalMs }
+
+        fun mapTime(originalMs: Long, boundaries: List<TimingBoundary>): Long {
+            if (boundaries.isNotEmpty()) {
+                var low = 0
+                var high = boundaries.size
+                while (low < high) {
+                    val mid = (low + high) ushr 1
+                    if (boundaries[mid].originalMs < originalMs) low = mid + 1 else high = mid
+                }
+
+                val first = (low - 2).coerceAtLeast(0)
+                val last = (low + 2).coerceAtMost(boundaries.lastIndex)
+                var best: TimingBoundary? = null
+                var bestError = Long.MAX_VALUE
+                if (first <= last) {
+                    for (index in first..last) {
+                        val candidate = boundaries[index]
+                        val error = abs(candidate.originalMs - originalMs)
+                        if (error < bestError) {
+                            best = candidate
+                            bestError = error
+                        }
+                    }
+                }
+                if (best != null && bestError <= BOUNDARY_TOLERANCE_MS) {
+                    return best.retimedMs.coerceAtLeast(0L)
+                }
+            }
+
+            return (
+                originalMs.toDouble() * timeline.alignmentScale +
+                    timeline.alignmentInterceptMs
+                ).roundToLong().coerceAtLeast(0L)
+        }
+
+        val out = ArrayList<SubtitleSyncCue>(source.size)
+        source.forEach { cue ->
+            val startMs = mapTime(cue.startTimeMs, startBoundaries)
+            val endMs = mapTime(cue.endTimeMs, endBoundaries).coerceAtLeast(startMs + 1L)
+            out += cue.copy(startTimeMs = startMs, endTimeMs = endMs)
+        }
+
+        clampIntroducedOverlaps(source, out)
+        return out
+    }
+
+    private fun retimeByIndexIfCompatible(
+        source: List<SubtitleSyncCue>,
+        timeline: AutoSyncTimelineRetimeResult,
+    ): List<SubtitleSyncCue>? {
+        if (source.size != timeline.cues.size || source.isEmpty()) return null
+
+        val out = ArrayList<SubtitleSyncCue>(source.size)
+        for (index in source.indices) {
+            val entry = source[index]
+            val originalStartMs = entry.startTimeMs
+            val originalEndMs = entry.endTimeMs.coerceAtLeast(originalStartMs + 1L)
+
+            val retimedCue = timeline.cues[index]
+            if (
+                abs(originalStartMs - retimedCue.originalStartTimeMs) > DIRECT_INDEX_TOLERANCE_MS ||
+                abs(originalEndMs - retimedCue.originalEndTimeMs) > DIRECT_INDEX_TOLERANCE_MS
+            ) {
+                return null
+            }
+
+            val startMs = retimedCue.startTimeMs.coerceAtLeast(0L)
+            val endMs = retimedCue.endTimeMs.coerceAtLeast(startMs + 1L)
+            out += entry.copy(startTimeMs = startMs, endTimeMs = endMs)
+        }
+
+        clampIntroducedOverlaps(source, out)
+        return out
+    }
+
+    /** A retimed cue must not swallow a source-next cue that used to start after it. */
+    private fun clampIntroducedOverlaps(
+        source: List<SubtitleSyncCue>,
+        out: MutableList<SubtitleSyncCue>,
+    ) {
+        for (index in 0 until out.lastIndex) {
+            val sourceCurrent = source[index]
+            val sourceNext = source[index + 1]
+            if (sourceCurrent.endTimeMs <= sourceNext.startTimeMs) continue
+
+            val current = out[index]
+            val next = out[index + 1]
+            if (current.endTimeMs > next.startTimeMs && next.startTimeMs > current.startTimeMs) {
+                out[index] = current.copy(
+                    endTimeMs = next.startTimeMs.coerceAtLeast(current.startTimeMs + 1L),
+                )
+            }
+        }
+    }
+
+    private fun writeRetimedSrt(cues: List<SubtitleSyncCue>): Path {
+        val file = Files.createTempFile(retimeDir, "retime-", ".srt")
+        val builder = StringBuilder(cues.size * 48)
+        cues.forEachIndexed { index, cue ->
+            builder.append(index + 1).append('\n')
+            builder.append(formatSrtTime(cue.startTimeMs)).append(" --> ")
+                .append(formatSrtTime(cue.endTimeMs)).append('\n')
+            builder.append(cue.text.trim().ifEmpty { " " }).append("\n\n")
+        }
+        lastRetimedSrt = builder.toString() // Nuvio fork: synced subtitles
+        val tmp = file.resolveSibling(file.fileName.toString() + ".part")
+        Files.writeString(tmp, builder.toString(), Charsets.UTF_8)
+        Files.move(tmp, file, StandardCopyOption.REPLACE_EXISTING)
+        return file
+    }
+
+    private fun formatSrtTime(timeMs: Long): String {
+        val safe = timeMs.coerceAtLeast(0L)
+        val hours = safe / 3_600_000L
+        val minutes = (safe / 60_000L) % 60L
+        val seconds = (safe / 1_000L) % 60L
+        val millis = safe % 1_000L
+        return "%02d:%02d:%02d,%03d".format(hours, minutes, seconds, millis)
+    }
+
+    private fun pruneOldRetimeFiles(keep: Path) {
+        runCatching {
+            Files.list(retimeDir).use { stream ->
+                stream
+                    .filter { path ->
+                        path != keep &&
+                            path.fileName.toString().startsWith("retime-") &&
+                            path.fileName.toString().endsWith(".srt")
+                    }
+                    .sorted(Comparator.comparing { path: Path -> path.fileName.toString() }
+                        .reversed())
+                    .skip((RETIMED_FILES_TO_KEEP - 1).coerceAtLeast(0).toLong())
+                    .forEach { path -> runCatching { Files.deleteIfExists(path) } }
+            }
+        }
+    }
+}
+
+private data class TimingBoundary(
+    val originalMs: Long,
+    val retimedMs: Long,
+)
