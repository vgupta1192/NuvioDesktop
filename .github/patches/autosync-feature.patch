@@ -0,0 +1,417 @@
+package com.nuvio.app.features.player
+
+import co.touchlab.kermit.Logger
+import com.nuvio.app.features.autosync.AutoSyncPreferencesRepository
+import com.nuvio.app.features.autosync.AutoSyncSyncedSubtitle
+import com.nuvio.app.features.player.autosync.AutoSyncPreferences
+import com.nuvio.app.features.player.autosync.AutoSyncPreferencesPlatform
+import com.nuvio.app.features.player.autosync.AutoSyncSubtitleHttp
+import com.nuvio.app.features.player.autosync.PlayerAutoSyncBridge
+import com.nuvio.app.features.player.autosync.SubtitleLanguageMatching
+import com.nuvio.app.features.player.autosync.constantShiftRetime
+import com.nuvio.app.features.player.autosync.maxAlignmentShiftMs
+import com.nuvio.app.features.player.audiosync.SpeechAutoSyncEngine
+import com.nuvio.app.features.player.audiosync.SyncLog
+import com.nuvio.app.features.streams.StreamSubtitle
+import kotlin.math.roundToLong
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.launch
+
+private val autoSyncLog = Logger.withTag("NuvioAutoSync")
+
+private const val SUBTITLE_BODY_MAX_BYTES = 8 * 1024 * 1024
+
+private fun isHttpUrl(url: String): Boolean =
+    url.startsWith("http://", ignoreCase = true) || url.startsWith("https://", ignoreCase = true)
+
+private fun shortUrl(url: String): String = url.substringBefore('?').substringAfterLast('/').ifBlank { url.take(48) }
+
+/**
+ * Wraps the libmpv desktop controller with the AutoSync capability. The subtitle is attached
+ * immediately (unsynced) so playback is never blocked; the speech-based engine
+ * ([SpeechAutoSyncEngine], the desktop port of NuvioMobile's flow) then samples the stream's
+ * audio at dialogue-dense spots, correlates it with the subtitle's cue timeline and, when a
+ * confident constant-shift mapping is found, swaps the track to a retimed SRT carrying the
+ * corrected timing. When the chosen subtitle never fits the audio, a better-matching file in the
+ * same language is synced in its place. Every decision is logged (Kermit + the shareable sync
+ * log) so a "nothing happened" report from the launcher console is always explainable.
+ */
+internal class AutoSyncNativePlayerController(
+    private val base: PlayerEngineController,
+    private val scope: CoroutineScope,
+    private val sourceUrl: () -> String,
+    private val sourceHeaders: () -> Map<String, String>,
+    private val subtitleCandidates: () -> List<StreamSubtitle>,
+    private val playerInstanceKey: Int,
+) : PlayerEngineController by base, AutoSyncPlayerController {
+
+    private var autoSyncJob: Job? = null
+
+    /** Stream-typed candidates (stream's own + every add-on's), pushed by the player runtime. */
+    @Volatile
+    private var streamCandidates: List<StreamSubtitle> = emptyList()
+
+    override fun setAutoSyncSubtitleStreamCandidates(candidates: List<StreamSubtitle>) {
+        streamCandidates = candidates
+    }
+
+    /**
+     * The player surface's list only ever contains the STREAM's own subtitles; without the
+     * runtime-pushed add-ons, a picked add-on subtitle fails the candidate match below and
+     * AutoSync silently skips it (no bubble, no sync) - exactly the "nothing happens" report.
+     */
+    private fun allSubtitleCandidates(): List<StreamSubtitle> {
+        val pushed = streamCandidates
+        val surface = subtitleCandidates()
+        if (pushed.isEmpty()) return surface
+        val merged = ArrayList(pushed)
+        for (subtitle in surface) {
+            if (merged.none { it.url == subtitle.url }) merged += subtitle
+        }
+        return merged
+    }
+
+    /** What this wrapper last attached: the selected URL, the retimed copy of it, or null. */
+    @Volatile
+    private var activeSyncedKey: String? = null
+
+    private var appliedListener: ((subtitleUrl: String, delayMs: Int) -> Unit)? = null
+    private var messageListener: ((message: String) -> Unit)? = null
+    private var bubbleListener: ((kind: String, message: String) -> Unit)? = null
+
+    /** The run whose bubble is still showing "working", so a cancelled run can dismiss it. */
+    private var bubbleRun = 0L
+    private var openBubbleRun = -1L
+
+    /**
+     * Reports AutoSync's progress: to the bubble while it is turned on, else as a plain
+     * message ([plain]; null means the plain path stays quiet).
+     */
+    private fun notifyAutoSync(runId: Long, kind: String, bubble: String, plain: String?) {
+        // Listeners write Compose state on this background thread; a faulty listener must never
+        // take the sync run (or the app) down.
+        runCatching {
+            val bubbleTarget = bubbleListener
+            if (bubbleTarget != null && AutoSyncPreferences.bubbleToastsEnabled.value) {
+                openBubbleRun = if (kind == "working") runId else -1L
+                bubbleTarget(kind, bubble)
+            } else if (plain != null) {
+                messageListener?.invoke(plain)
+            }
+        }.onFailure { autoSyncLog.w { "notify failed: ${it.message}" } }
+    }
+
+    init {
+        SyncedSubtitlesDesktop.ensureStore() // Nuvio fork: synced subtitles
+        AutoSyncPreferences.ensureLoaded()
+        AutoSyncPreferencesPlatform.install() // Nuvio fork: mobile-style AutoSync rows persist (+ legacy toggle migration)
+    }
+
+    override fun setAutoSyncAppliedListener(
+        listener: ((subtitleUrl: String, delayMs: Int) -> Unit)?,
+    ) {
+        appliedListener = listener
+    }
+
+    override fun setAutoSyncMessageListener(listener: ((message: String) -> Unit)?) {
+        messageListener = listener
+    }
+
+    override fun setAutoSyncBubbleListener(listener: ((kind: String, message: String) -> Unit)?) {
+        bubbleListener = listener
+    }
+
+    override fun setSubtitleUriWithAutoSync(url: String) {
+        autoSyncLog.i { "AutoSync requested (startup scope) for ${shortUrl(url)}" }
+        if (restoreSynced(url)) return // Nuvio fork: synced subtitles
+        runSpeechSync(url, startupScope = true)
+    }
+
+    override fun setSubtitleUriWithSelectedAutoSync(url: String) {
+        autoSyncLog.i { "AutoSync requested (selected scope) for ${shortUrl(url)}" }
+        if (restoreSynced(url)) return // Nuvio fork: synced subtitles
+        runSpeechSync(url, startupScope = false)
+    }
+
+    /**
+     * Nuvio fork: shows [url] with the timing saved when it was synced before for this title +
+     * stream (on any device), so AutoSync does not run again.
+     */
+    private fun restoreSynced(url: String): Boolean {
+        val file = runCatching { SyncedSubtitlesDesktop.savedFileFor(url) }
+            .onFailure { autoSyncLog.w { "saved-subtitle lookup failed: ${it.message}" } }
+            .getOrNull()
+            ?: return false
+        cancelAutoSync()
+        SyncedSubtitles.restoredUrls += url
+        base.setSubtitleDelayMs(0)
+        base.setSubtitleUri(file.absolutePath)
+        activeSyncedKey = url
+        AutoSyncSyncedSubtitle.mark(url)
+        runCatching { appliedListener?.invoke(url, 0) }
+            .onFailure { autoSyncLog.w { "applied listener failed: ${it.message}" } }
+        autoSyncLog.i { "showing saved synced subtitle ($url) - AutoSync run skipped" }
+        SyncLog.i("restored saved synced subtitle ${shortUrl(url)} from the account")
+        return true
+    }
+
+    // Plain attaches mean the user (or the runtime) chose un-synced timing; cancel any running
+    // analysis and forget the synced state so a later retime cannot land on the wrong track.
+    override fun setSubtitleUri(url: String) {
+        if (restoreSynced(url)) return // Nuvio fork: synced subtitles
+        cancelAutoSync()
+        activeSyncedKey = url
+        AutoSyncSyncedSubtitle.clear()
+        base.setSubtitleUri(url)
+    }
+
+    override fun clearExternalSubtitle() {
+        cancelAutoSync()
+        activeSyncedKey = null
+        AutoSyncSyncedSubtitle.clear()
+        base.clearExternalSubtitle()
+    }
+
+    override fun clearExternalSubtitleAndSelect(trackIndex: Int) {
+        cancelAutoSync()
+        activeSyncedKey = null
+        AutoSyncSyncedSubtitle.clear()
+        base.clearExternalSubtitleAndSelect(trackIndex)
+    }
+
+    /** Called when the player surface is disposed so a running analysis cannot linger. */
+    fun dispose() {
+        cancelAutoSync()
+        appliedListener = null
+        messageListener = null
+        bubbleListener = null
+    }
+
+    private fun cancelAutoSync() {
+        autoSyncJob?.cancel()
+        autoSyncJob = null
+    }
+
+    /**
+     * Runs the speech-based sync for [selectedUrl], mirroring NuvioMobile: the subtitle attaches
+     * unsynced right away, the engine samples the stream's audio and either retimes the selected
+     * file or switches to a better-matching one. Startup runs are gated on the user's
+     * auto-sync-on-start toggle; a subtitle the user picked explicitly always gets a sync run.
+     */
+    private fun runSpeechSync(
+        selectedUrl: String,
+        startupScope: Boolean,
+    ) {
+        AutoSyncPreferencesRepository.ensureLoaded()
+        val streamUrlAtCall = sourceUrl()
+        if (
+            !isHttpUrl(selectedUrl) ||
+            !isHttpUrl(streamUrlAtCall) ||
+            selectedUrl == streamUrlAtCall
+        ) {
+            autoSyncLog.i {
+                "AutoSync skipped (selected=${isHttpUrl(selectedUrl)} stream=${isHttpUrl(streamUrlAtCall)} " +
+                    "sameUrl=${selectedUrl == streamUrlAtCall}) - plain attach"
+            }
+            setSubtitleUri(selectedUrl)
+            return
+        }
+        val selectedSubtitle = allSubtitleCandidates().firstOrNull { it.url == selectedUrl }
+        if (selectedSubtitle == null) {
+            autoSyncLog.i {
+                "AutoSync skipped: the picked subtitle is not among the ${allSubtitleCandidates().size} stream candidates - plain attach"
+            }
+            setSubtitleUri(selectedUrl)
+            return
+        }
+        if (
+            startupScope &&
+            !AutoSyncPreferencesRepository.claimStartupRun(playerInstanceKey, streamUrlAtCall)
+        ) {
+            // AutoSync already ran once for this stream, or the user turned auto-sync-off at
+            // start; attach the plain way unless the synced track is already exactly this one.
+            autoSyncLog.i {
+                "AutoSync startup run not claimed (toggle off or already ran for this stream) - plain attach"
+            }
+            if (activeSyncedKey != selectedUrl) {
+                setSubtitleUri(selectedUrl)
+            }
+            return
+        }
+
+        cancelAutoSync()
+
+        val sourceUrlAtStart = streamUrlAtCall
+        val sourceHeadersAtStart = sourceHeaders()
+        val selectedHeaders = selectedSubtitle.headers.orEmpty()
+        val selectedLanguage = selectedSubtitle.language
+        val selectedName = selectedSubtitle.name.orEmpty()
+
+        // The subtitle is attached unsynced right away so the user reads it while the engine
+        // works; a confident result later swaps the track to the retimed copy.
+        base.setSubtitleDelayMs(0)
+        base.setSubtitleUri(selectedUrl)
+        activeSyncedKey = selectedUrl
+        AutoSyncSyncedSubtitle.clear()
+
+        val bubbleRunId = ++bubbleRun
+        autoSyncJob = scope.launch {
+            // The user can switch to a built-in track, turn subtitles off or open another stream
+            // while this runs; the outcomes below must then leave their choice alone.
+            fun stillRelevant(): Boolean =
+                sourceUrl() == sourceUrlAtStart && activeSyncedKey == selectedUrl
+
+            try {
+                notifyAutoSync(bubbleRunId, "working", "Auto Sync • Listening for dialogue…", null)
+                autoSyncLog.i {
+                    "speech sync start: subtitle=${shortUrl(selectedUrl)} lang=${selectedLanguage.ifBlank { "?" }} " +
+                        "startupScope=$startupScope candidates=${allSubtitleCandidates().size}"
+                }
+                SyncLog.i("speech sync start for ${shortUrl(selectedUrl)}")
+
+                val body = try {
+                    AutoSyncSubtitleHttp.get(selectedUrl, selectedHeaders, SUBTITLE_BODY_MAX_BYTES).body
+                } catch (cancel: CancellationException) {
+                    throw cancel
+                } catch (error: Exception) {
+                    autoSyncLog.w { "AUTO_SYNC subtitle download failed: ${error.message}" }
+                    null
+                }
+                if (body.isNullOrBlank()) {
+                    if (!stillRelevant()) return@launch
+                    autoSyncLog.w { "speech sync: subtitle download failed or empty" }
+                    SyncLog.w("speech sync: subtitle download failed")
+                    notifyFailure(bubbleRunId)
+                    return@launch
+                }
+
+                // Alternatives in the selected subtitle's language, tested when it never fits.
+                // A blank language still runs the sync for the picked file itself; only the
+                // alternative search needs a language to match against.
+                val alternatives = if (startupScope && selectedLanguage.isNotBlank()) {
+                    allSubtitleCandidates()
+                        .filter { it.url != selectedUrl && it.url != sourceUrlAtStart }
+                        .distinctBy { it.url }
+                        .filter { SubtitleLanguageMatching.matchesLanguageCode(it.language, selectedLanguage) }
+                        .map { candidate ->
+                            SpeechAutoSyncEngine.Alternative(
+                                url = candidate.url,
+                                language = candidate.language,
+                                name = candidate.name.orEmpty(),
+                                headers = candidate.headers.orEmpty(),
+                            )
+                        }
+                } else {
+                    emptyList()
+                }
+
+                val result = SpeechAutoSyncEngine.run(
+                    request = SpeechAutoSyncEngine.Request(
+                        streamUrl = sourceUrlAtStart,
+                        streamHeaders = sourceHeadersAtStart,
+                        selectedUrl = selectedUrl,
+                        selectedHeaders = selectedHeaders,
+                        selectedBody = body,
+                        alternatives = alternatives,
+                    ),
+                    onProgress = { text ->
+                        if (stillRelevant()) {
+                            notifyAutoSync(bubbleRunId, "working", "Auto Sync • $text", null)
+                        }
+                    },
+                )
+
+                if (!stillRelevant()) return@launch
+                if (result == null) {
+                    autoSyncLog.w { "speech sync finished with no confident match" }
+                    notifyFailure(bubbleRunId)
+                    return@launch
+                }
+
+                val chosenUrl = result.subtitleUrl
+                val timeline = constantShiftRetime(
+                    cues = result.cues,
+                    scale = result.scale,
+                    shiftMs = result.shiftMs,
+                    source = "speech",
+                    activityScore = result.peak,
+                )
+                autoSyncLog.i {
+                    "speech sync matched ${shortUrl(chosenUrl)}: scale=${result.scale} " +
+                        "shift=${result.shiftMs.roundToLong()}ms peak=%.2f switched=${result.switched}".format(result.peak)
+                }
+                // A confident correction within the user's tolerance keeps the selected
+                // subtitle's original timing instead of retiming it.
+                val toleranceMs = AutoSyncPreferencesRepository.syncToleranceMs.value
+                val withinToleranceMs = toleranceMs.takeIf {
+                    it > 0 && !result.switched && timeline.maxAlignmentShiftMs() <= it
+                }
+                val applied = if (withinToleranceMs != null) {
+                    base.setSubtitleDelayMs(0)
+                    true
+                } else {
+                    PlayerAutoSyncBridge.attachRetimedSubtitle(base, result.cues, timeline)
+                }
+                if (!applied) {
+                    if (!stillRelevant()) return@launch
+                    autoSyncLog.w { "speech sync: the retimed track could not be attached" }
+                    notifyFailure(bubbleRunId)
+                    return@launch
+                }
+
+                if (chosenUrl != selectedUrl) {
+                    // Track the swap so stillRelevant() and the startup claim stay correct.
+                    activeSyncedKey = chosenUrl
+                }
+                runCatching { appliedListener?.invoke(chosenUrl, 0) }
+                    .onFailure { autoSyncLog.w { "applied listener failed: ${it.message}" } }
+                AutoSyncSyncedSubtitle.mark(chosenUrl)
+                // Nuvio fork: keep the retimed subtitle for the other devices on the account.
+                PlayerAutoSyncBridge.lastRetimedSrt?.let { srt ->
+                    if (withinToleranceMs == null) {
+                        SyncedSubtitles.save(chosenUrl, srt, method = "autosync", nowMs = System.currentTimeMillis())
+                    }
+                }
+                notifyAutoSync(
+                    bubbleRunId,
+                    "success",
+                    when {
+                        withinToleranceMs != null -> "Auto Sync • Subtitles already in sync"
+                        result.switched -> "Auto Sync • Switched to a subtitle that matches the audio"
+                        else -> "Auto Sync • Subtitles synced"
+                    },
+                    null,
+                )
+            } catch (cancel: CancellationException) {
+                throw cancel
+            } catch (error: Throwable) {
+                autoSyncLog.w { "AUTO_SYNC failed: ${error.javaClass.simpleName}: ${error.message}" }
+                if (!stillRelevant()) return@launch
+                notifyFailure(bubbleRunId)
+            }
+        }.also { job ->
+            job.invokeOnCompletion {
+                // A run that ended without a result (cancelled, or the stream changed) must not
+                // leave its "working" bubble on screen. A newer run owns the bubble otherwise.
+                runCatching {
+                    if (openBubbleRun == bubbleRunId) {
+                        openBubbleRun = -1L
+                        bubbleListener?.invoke("dismiss", "")
+                    }
+                }
+            }
+        }
+    }
+
+    /** The plain failure outcome: the unsynced subtitle attached at the start stays as it is. */
+    private fun notifyFailure(bubbleRunId: Long) {
+        notifyAutoSync(
+            bubbleRunId,
+            "failure",
+            "Auto Sync • Sync failed • subtitle timing not changed",
+            "Sync failed: Auto Sync couldn't match this subtitle to the audio.",
+        )
+    }
+}
