+package com.nuvio.app.features.player.autosync
+
+import com.nuvio.app.core.storage.DesktopStorage
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/**
+ * AutoSync-owned preferences that outlived the old cue-reference engine: the bubble toggle.
+ *
+ * Kept outside PlayerSettingsDataStore / PlayerSettingsRepository on purpose: no migrations or
+ * constructor wiring in the shared settings architecture just for this feature. The sync
+ * behaviour itself (auto-sync at start, thorough search, tolerance) lives in the shared
+ * AutoSyncPreferencesRepository, the same store the mobile-style settings rows write.
+ */
+internal object AutoSyncPreferences {
+    private const val STORE_NAME = "nuvio_autosync"
+    private const val KEY_BUBBLE_TOASTS = "automatic_subtitle_sync_bubble_toasts"
+
+    private val lock = Any()
+    @Volatile private var initialized = false
+
+    /** Show AutoSync's progress in the Reshaped-style bubble instead of plain toasts. */
+    private val _bubbleToastsEnabled = MutableStateFlow(true)
+    val bubbleToastsEnabled: StateFlow<Boolean> = _bubbleToastsEnabled.asStateFlow()
+
+    private fun store() = DesktopStorage.store(STORE_NAME)
+
+    fun ensureLoaded() {
+        if (initialized) return
+        synchronized(lock) {
+            if (initialized) return
+            _bubbleToastsEnabled.value = store().getBoolean(KEY_BUBBLE_TOASTS) ?: true
+            initialized = true
+        }
+    }
+
+    fun setBubbleToastsEnabled(enabled: Boolean) {
+        ensureLoaded()
+        if (_bubbleToastsEnabled.value == enabled) return
+        _bubbleToastsEnabled.value = enabled
+        store().putBoolean(KEY_BUBBLE_TOASTS, enabled)
+    }
+}
