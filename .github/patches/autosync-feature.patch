@@ -0,0 +1,29 @@
+package com.nuvio.app.core.network
+
+import com.nuvio.app.core.storage.DesktopStorage
+
+/**
+ * Nuvio fork: a desktop install that once saved a custom server keeps talking to it forever -
+ * the choice outlives every update - so its synced-subtitle pulls and pushes never reach the
+ * self-hosted backend this fork is built around, and the "Auto synced" chips silently stay
+ * empty. Once per install: drop any saved custom server and use the baked-in one. The active
+ * backend is always logged so a launcher-console report can prove where the app talks.
+ */
+internal fun resetBackendToOfficialOnce() {
+    runCatching {
+        val store = DesktopStorage.store("backend_configuration")
+        if (store.getBoolean("official_reset_v1") != true) {
+            val active = ServerConfigurationRepository.active.value
+            if (active.isCustom) {
+                val official = officialConfiguration()
+                ServerConfigurationRepository.useOfficial()
+                println(
+                    "[nuvio] backend switched from the saved custom ${active.backendUrl} " +
+                        "to the built-in ${official.backendUrl} - log in again if asked",
+                )
+            }
+            store.putBoolean("official_reset_v1", true)
+        }
+        println("[nuvio] backend: ${ServerConfigurationRepository.active.value.backendUrl}")
+    }
+}
