+package com.nuvio.app.features.player
+
+/**
+ * dx.bi port: Dialogue boost and Night mode audio presets for the Desktop (mpv) player.
+ * The numbers follow dx.bi's own presets (low shelf at 200 Hz, speech presence at 2.5 kHz,
+ * compressor threshold, ratio and make-up gain). They ride the player's `af` chain, which
+ * DesktopPlayerEnhance owns as the single writer.
+ */
+enum class DxSoundPreset(
+    val id: String,
+    val label: String,
+    val hint: String,
+    /** ffmpeg filters appended to the player's `af` chain; empty for [OFF]. */
+    val mpvFilters: String,
+) {
+    OFF("off", "Off", "As the stream comes.", ""),
+    DIALOGUE(
+        "dialogue", "Dialogue boost", "Raises voices and softens booming lows.",
+        "lowshelf=f=200:g=-3,equalizer=f=2500:t=q:w=1:g=5,acompressor=threshold=-26dB:ratio=3:makeup=1.4",
+    ),
+    NIGHT(
+        "night", "Late night", "Strong night compression: evens out loud and quiet scenes so you can keep the volume down.",
+        "lowshelf=f=200:g=-6,equalizer=f=2500:t=q:w=1:g=4,acompressor=threshold=-42dB:ratio=8:makeup=2.4,alimiter=limit=0.95",
+    );
+
+    companion object {
+        val names: List<String> = values().map { it.label }
+        fun forIndex(index: Int): DxSoundPreset = values()[index.coerceIn(0, values().lastIndex)]
+    }
+}
