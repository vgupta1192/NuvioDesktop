new file mode 100644
index 00000000..52e6db4c
--- /dev/null
+++ b/composeApp/src/desktopMain/kotlin/com/nuvio/app/features/player/generated/WhisperModels.kt
@@ -0,0 +1,196 @@
+package com.nuvio.app.features.player.generated
+
+import com.nuvio.app.core.storage.DesktopStorage
+import com.nuvio.app.features.player.audiosync.SyncLog
+import java.io.File
+import java.io.IOException
+import java.net.HttpURLConnection
+import java.net.URL
+import java.security.MessageDigest
+
+/**
+ * The ggml Whisper models used by on-device generated subtitles, kept in the app's data folder.
+ * The model is downloaded on first use from the whisper.cpp repository on Hugging Face; an
+ * interrupted download resumes where it stopped (HTTP Range) and the finished file is checked
+ * against the SHA-256 that Hugging Face reports.
+ */
+internal object WhisperModels {
+    class Variant(val id: String, val label: String, val fileName: String, val approxBytes: Long) {
+        val url: String get() = "$BASE_URL/$fileName"
+    }
+
+    /** The full large-v3 model: the most accurate, the default. */
+    val LARGE_V3 = Variant("large-v3", "Whisper large-v3", "ggml-large-v3.bin", 3_100_000_000L)
+
+    /** large-v3 quantised to 5 bits: about a third of the size, for small disks or slow links. */
+    val LARGE_V3_Q5 = Variant("large-v3-q5_0", "Whisper large-v3 (compressed)", "ggml-large-v3-q5_0.bin", 1_100_000_000L)
+
+    private const val BASE_URL = "https://huggingface.co/ggerganov/whisper.cpp/resolve/main"
+    private const val ATTEMPTS = 4
+    private const val FREE_SPACE_MARGIN = 500_000_000L
+    private const val MAGIC_GGML = 0x67676d6c // "ggml", stored little-endian as "lmgg"
+
+    private val downloadLock = Any()
+    @Volatile private var downloadFile: File? = null
+
+    private val directory: File
+        get() = DesktopStorage.rootDir.resolve("models").resolve("whisper").toFile()
+
+    fun file(variant: Variant): File = File(directory, variant.fileName)
+
+    fun isInstalled(variant: Variant): Boolean = file(variant).let { it.isFile && it.length() > variant.approxBytes / 2 }
+
+    /** One line for Settings: what is on disk. Empty when nothing is. */
+    fun summary(): String {
+        val parts = listOf(LARGE_V3, LARGE_V3_Q5).filter { isInstalled(it) }.map { variant ->
+            "${variant.label} (${formatSize(file(variant).length())})"
+        }
+        return parts.joinToString(", ")
+    }
+
+    fun deleteAll() {
+        synchronized(this) {
+            directory.listFiles()?.forEach { file ->
+                if (file.name.startsWith("ggml-")) runCatching { file.delete() }
+            }
+        }
+    }
+
+    /** Returns the model file, downloading it first when it is not there. Blocking. */
+    fun ensure(variant: Variant, progress: (done: Long, total: Long) -> Unit): File {
+        val target = file(variant)
+        if (isInstalled(variant)) return target
+        return synchronized(downloadLock) {
+            if (isInstalled(variant)) return@synchronized target
+            target.parentFile.mkdirs()
+            val part = File(target.parentFile, target.name + ".part")
+            val needed = (variant.approxBytes - part.length()).coerceAtLeast(0L) + FREE_SPACE_MARGIN
+            if (target.parentFile.usableSpace in 1 until needed) {
+                throw IOException(
+                    "not enough free disk space for ${variant.label}: need ${formatSize(needed)}, " +
+                        "have ${formatSize(target.parentFile.usableSpace)}",
+                )
+            }
+            downloadFile = part
+            try {
+                var lastError: IOException? = null
+                for (attempt in 1..ATTEMPTS) {
+                    try {
+                        SyncLog.i("generated subtitles: downloading ${variant.label} (attempt $attempt, ${formatSize(part.length())} on disk)")
+                        download(variant, part, progress)
+                        if (!part.renameTo(target)) throw IOException("could not move the finished download into place")
+                        SyncLog.i("generated subtitles: ${variant.label} downloaded")
+                        return@synchronized target
+                    } catch (error: IOException) {
+                        lastError = error
+                        SyncLog.w("generated subtitles: model download failed: ${error.message}")
+                        if (attempt < ATTEMPTS) Thread.sleep(2_000L * attempt * attempt)
+                    }
+                }
+                throw lastError ?: IOException("model download failed")
+            } finally {
+                downloadFile = null
+            }
+        }
+    }
+
+    private fun download(variant: Variant, part: File, progress: (Long, Long) -> Unit) {
+        var url = variant.url
+        var expectedSha: String? = null
+        var hops = 0
+        while (true) {
+            val resume = part.length()
+            val connection = (URL(url).openConnection() as HttpURLConnection).apply {
+                instanceFollowRedirects = false
+                connectTimeout = 20_000
+                readTimeout = 60_000
+                setRequestProperty("User-Agent", "NuvioDesktop")
+                if (resume > 0) setRequestProperty("Range", "bytes=$resume-")
+            }
+            try {
+                val code = try {
+                    connection.responseCode
+                } catch (error: Exception) {
+                    throw IOException("unreachable: ${error.message}")
+                }
+                if (code in 301..308 && code != 304) {
+                    // Hugging Face reports the SHA-256 of the file on the redirect to its CDN
+                    connection.getHeaderField("X-Linked-Etag")?.trim('"')
+                        ?.takeIf { it.length == 64 }?.let { expectedSha = it.lowercase() }
+                    val location = connection.getHeaderField("Location") ?: throw IOException("redirect without a location")
+                    url = URL(URL(url), location).toString()
+                    if (++hops > 6) throw IOException("too many redirects")
+                    continue
+                }
+                if (code == 416) {
+                    part.delete()
+                    throw IOException("server refused the resume point; starting over")
+                }
+                if (code != 200 && code != 206) throw IOException("HTTP $code")
+                val append = code == 206 && resume > 0
+                val total = if (append) {
+                    connection.getHeaderField("Content-Range")?.substringAfter('/')?.toLongOrNull() ?: -1L
+                } else {
+                    connection.contentLengthLong
+                }
+                var done = if (append) resume else 0L
+                java.io.FileOutputStream(part, append).use { output ->
+                    connection.inputStream.use { input ->
+                        val buffer = ByteArray(1 shl 20)
+                        var lastReport = 0L
+                        while (true) {
+                            val read = input.read(buffer)
+                            if (read < 0) break
+                            output.write(buffer, 0, read)
+                            done += read
+                            val now = System.currentTimeMillis()
+                            if (now - lastReport >= 1_000L) {
+                                lastReport = now
+                                progress(done, total)
+                            }
+                        }
+                    }
+                }
+                progress(done, total)
+                if (total > 0 && part.length() != total) {
+                    throw IOException("download ended early (${part.length()} of $total bytes)")
+                }
+                verify(part, expectedSha)
+                return
+            } finally {
+                connection.disconnect()
+            }
+        }
+    }
+
+    private fun verify(file: File, expectedSha: String?) {
+        file.inputStream().use { input ->
+            val magic = ByteArray(4)
+            if (input.read(magic) != 4 ||
+                (magic[0].toInt() and 0xFF) or ((magic[1].toInt() and 0xFF) shl 8) or
+                ((magic[2].toInt() and 0xFF) shl 16) or ((magic[3].toInt() and 0xFF) shl 24) != MAGIC_GGML
+            ) {
+                file.delete()
+                throw IOException("the downloaded file is not a ggml model")
+            }
+        }
+        if (expectedSha == null) return
+        val digest = MessageDigest.getInstance("SHA-256")
+        file.inputStream().use { input ->
+            val buffer = ByteArray(1 shl 20)
+            while (true) {
+                val read = input.read(buffer)
+                if (read < 0) break
+                digest.update(buffer, 0, read)
+            }
+        }
+        val actual = digest.digest().joinToString("") { "%02x".format(it) }
+        if (actual != expectedSha) {
+            file.delete()
+            throw IOException("the downloaded model failed its SHA-256 check")
+        }
+    }
+
+    fun formatSize(bytes: Long): String =
+        if (bytes >= 1_000_000_000L) "%.1f GB".format(bytes / 1e9) else "${bytes / 1_000_000L} MB"
+}
