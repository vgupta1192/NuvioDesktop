+     * Collects every saved copy of this title (this device and the account, this mode and the
+     * other one, the stream durations one second either side), starts from the copy that covers
+     * the most and fills only its gaps from the others. A partial copy made one way therefore
+     * never hides a complete copy made the other way.
+     */
+    private suspend fun loadSaved(keys: List<String>, otherKeys: List<String>, cues: MutableList<Cue>, covered: MutableList<LongArray>) {
+        fun local(k: String): String? = savedFile(k).takeIf { it.isFile }?.let { runCatching { it.readText() }.getOrNull() }
+        suspend fun remote(k: String): String? = withTimeoutOrNull(SYNC_TIMEOUT_MS) { GeneratedSubtitleSync.pull(k) }
+        val found = coroutineScope {
+            (keys + otherKeys).map { k -> async { Pair(local(k), remote(k)) } }.awaitAll()
+        }
+        if (found.any { it.second != null }) SyncLog.i("generated subtitles: lines from your Nuvio account found")
+        val copies = found.flatMap { listOfNotNull(it.first, it.second) }
+            .mapNotNull { parseSaved(it) }
+            .sortedByDescending { coveredSeconds(it.covered) }
+        copies.forEach { copy ->
+            copy.covered.forEach { range ->
+                uncoveredParts(covered, range[0], range[1]).forEach { gap ->
+                    copy.cues.filter { (it.start * 1000).toLong() in gap[0] until gap[1] }.forEach { cues += it }
+                    addCovered(covered, gap[0], gap[1])
+                }
+            }
+        }
+        cues.sortBy { it.start }
+    }
+
+    /** The parts of [fromMs]..[toMs] that [covered] does not reach yet. */
+    private fun uncoveredParts(covered: List<LongArray>, fromMs: Long, toMs: Long): List<LongArray> {
+        var cursor = fromMs
+        val parts = ArrayList<LongArray>()
+        for (range in covered.sortedBy { it[0] }) {
+            if (range[1] <= cursor) continue
+            if (range[0] >= toMs) break
+            if (range[0] > cursor) parts += longArrayOf(cursor, range[0])
+            cursor = maxOf(cursor, range[1])
+        }
+        if (cursor < toMs) parts += longArrayOf(cursor, toMs)
+        return parts
+    }
+
+    /** Writes the JSON and a plain SRT next to it on this device and, when [push] is set, to the Nuvio account. */
+    private suspend fun saveSaved(keys: List<String>, contentId: String?, cues: List<Cue>, covered: List<LongArray>, push: Boolean): Boolean {
+        val key = keys.first()
+        val file = savedFile(key)
+        val payload = JsonObject(
+            mapOf(
+                "cues" to JsonArray(
+                    cues.sortedBy { it.start }.map {
+                        JsonArray(listOf(JsonPrimitive((it.start * 1000).toLong()), JsonPrimitive((it.end * 1000).toLong()), JsonPrimitive(it.text)))
+                    },
+                ),
+                "covered" to JsonArray(covered.map { JsonArray(listOf(JsonPrimitive(it[0]), JsonPrimitive(it[1]))) }),
+            ),
+        ).toString()
+        runCatching {
+            file.parentFile?.mkdirs()
+            val partial = File(file.parentFile, file.name + ".part")
+            partial.writeText(payload)
+            partial.renameTo(file)
+            File(file.parentFile, "$key.srt").writeText(buildSrt(cues))
+            file.parentFile?.listFiles { candidate -> candidate.name.endsWith(".json") }
+                ?.sortedByDescending { it.lastModified() }
+                ?.drop(MAX_KEPT_TITLES)
+                ?.forEach { stale ->
+                    stale.delete()
+                    File(stale.parentFile, stale.name.removeSuffix(".json") + ".srt").delete()
+                }
+        }.onFailure { SyncLog.w("generated subtitles: couldn't save lines: ${it.message}") }
+        if (!push) return false
+        val pushed = keys.map { k -> withTimeoutOrNull(SYNC_TIMEOUT_MS) { GeneratedSubtitleSync.push(k, contentId, payload) } == true }.all { it }
+        if (pushed) SyncLog.i("generated subtitles: saved to your account, ${cues.size} lines, ${coveredSeconds(covered)}s covered")
+        else SyncLog.w("generated subtitles: not saved to the Nuvio account (signed out, offline or refused)")
+        return pushed
+    }
+
+    /** Adds [fromMs]..[toMs] to [covered], merging ranges that touch or overlap. */
+    private fun addCovered(covered: MutableList<LongArray>, fromMs: Long, toMs: Long) {
+        if (toMs <= fromMs) return
+        var from = fromMs
+        var to = toMs
+        val kept = ArrayList<LongArray>()
+        for (range in covered) {
+            if (range[1] < from || range[0] > to) kept += range else {
+                from = minOf(from, range[0])
+                to = maxOf(to, range[1])
+            }
+        }
+        kept += longArrayOf(from, to)
+        kept.sortBy { it[0] }
+        covered.clear()
+        covered += kept
+    }
+
+    private fun isCovered(covered: List<LongArray>, fromMs: Long, toMs: Long): Boolean =
+        covered.any { it[0] <= fromMs + COVERED_TOLERANCE_MS && it[1] >= toMs - COVERED_TOLERANCE_MS }
+
+    private fun isFullyCovered(covered: List<LongArray>, durationMs: Long): Boolean =
+        isCovered(covered, 0L, durationMs)
+
+    private fun coveredSeconds(covered: List<LongArray>): Long = covered.sumOf { it[1] - it[0] } / 1_000L
+
+    /** ISO 639-2 audio tags (as in Matroska) to the codes in [GeneratedSubtitles.spokenLanguages]. */
+    private val THREE_LETTER_CODES = mapOf(
+        "zho" to "zh", "chi" to "zh", "cmn" to "zh", "jpn" to "ja", "kor" to "ko", "eng" to "en",
+        "hin" to "hi", "urd" to "ur", "ben" to "bn", "tam" to "ta", "tel" to "te", "mal" to "ml",
+        "kan" to "kn", "mar" to "mr", "guj" to "gu", "pan" to "pa", "tha" to "th", "ind" to "id",
+        "msa" to "ms", "may" to "ms", "tgl" to "tl", "fil" to "tl", "vie" to "vi", "tur" to "tr",
+        "ara" to "ar", "fas" to "fa", "per" to "fa", "rus" to "ru", "ukr" to "uk", "pol" to "pl",
+        "spa" to "es", "por" to "pt", "fra" to "fr", "fre" to "fr", "deu" to "de", "ger" to "de",
+        "ita" to "it", "nld" to "nl", "dut" to "nl", "swe" to "sv", "ell" to "el", "gre" to "el",
+        "heb" to "he", "iw" to "he", "in" to "id",
+    )
 }
