--- /dev/null
+++ b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/player/GeneratedUsage.kt
@@ -0,0 +1,144 @@
+package com.nuvio.app.features.player
+
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+
+/**
+ * What the online generation services have been used for, shown in Settings so the choice between
+ * Groq, DeepL and the on-device model can be made with the numbers in view.
+ *
+ * Groq publishes no balance. The calls and the minutes of audio sent are counted here per UTC day
+ * (the way its daily limits count), and the "requests left" Groq reports in its response headers
+ * is shown once a call has been made. DeepL reports its own character usage when asked.
+ */
+object GeneratedUsage {
+    private data class State(
+        val day: Long = 0L,
+        val calls: Int = 0,
+        val audioSeconds: Long = 0L,
+        val requestsLeft: Int? = null,
+        val requestsLimit: Int? = null,
+        val deeplUsed: Long? = null,
+        val deeplLimit: Long? = null,
+        val deeplProblem: String? = null,
+    )
+
+    private val state = MutableStateFlow(State())
+    private val _groqText = MutableStateFlow(groqLine(State()))
+    private val _deeplText = MutableStateFlow(deeplLine(State()))
+
+    /** One or two sentences about today's Groq use. */
+    val groqText: StateFlow<String> = _groqText.asStateFlow()
+
+    /** One sentence about the DeepL characters used and left. */
+    val deeplText: StateFlow<String> = _deeplText.asStateFlow()
+
+    /** Registered by the platform: asks DeepL for the key's usage and calls [publishDeepl]. */
+    var deeplFetcher: ((key: String) -> Unit)? = null
+
+    private var save: ((key: String, value: String) -> Unit)? = null
+
+    /** Restores today's Groq counters; [nowMs] drops counters of an earlier day. */
+    fun install(nowMs: Long, load: (key: String) -> String?, save: (key: String, value: String) -> Unit) {
+        this.save = save
+        val today = nowMs / DAY_MS
+        val storedDay = load(KEY_DAY)?.toLongOrNull()
+        if (storedDay == today) {
+            state.update {
+                it.copy(
+                    day = today,
+                    calls = load(KEY_CALLS)?.toIntOrNull() ?: 0,
+                    audioSeconds = load(KEY_AUDIO)?.toLongOrNull() ?: 0L,
+                )
+            }
+        } else {
+            state.update { it.copy(day = today) }
+        }
+        publish()
+    }
+
+    /**
+     * One Groq answer: [audioSeconds] of speech were uploaded; the two header values are what Groq
+     * reported as requests left and allowed per day (null when absent). Only a successful call counts.
+     */
+    fun recordGroq(nowMs: Long, audioSeconds: Double, requestsLeft: Int?, requestsLimit: Int?, success: Boolean) {
+        val today = nowMs / DAY_MS
+        state.update { current ->
+            val base = if (current.day == today) current else current.copy(day = today, calls = 0, audioSeconds = 0L)
+            base.copy(
+                calls = base.calls + if (success) 1 else 0,
+                audioSeconds = base.audioSeconds + if (success) audioSeconds.toLong() else 0L,
+                requestsLeft = requestsLeft ?: base.requestsLeft,
+                requestsLimit = requestsLimit ?: base.requestsLimit,
+            )
+        }
+        val now = state.value
+        save?.invoke(KEY_DAY, now.day.toString())
+        save?.invoke(KEY_CALLS, now.calls.toString())
+        save?.invoke(KEY_AUDIO, now.audioSeconds.toString())
+        publish()
+    }
+
+    fun publishDeepl(used: Long, limit: Long) {
+        state.update { it.copy(deeplUsed = used, deeplLimit = limit, deeplProblem = null) }
+        publish()
+    }
+
+    fun publishDeeplProblem(problem: String) {
+        state.update { it.copy(deeplProblem = problem) }
+        publish()
+    }
+
+    /** Asks DeepL for the usage of [key] (the platform fetcher limits how often). */
+    fun refreshDeepl(key: String) {
+        if (key.isNotBlank()) deeplFetcher?.invoke(key)
+    }
+
+    private fun publish() {
+        val now = state.value
+        _groqText.value = groqLine(now)
+        _deeplText.value = deeplLine(now)
+    }
+
+    private fun groqLine(now: State): String {
+        val used = if (now.calls == 0) {
+            "Groq today (UTC): no calls yet."
+        } else {
+            "Groq today (UTC): ${now.calls} calls, ${now.audioSeconds / 60} min of audio sent."
+        }
+        val left = if (now.requestsLeft != null && now.requestsLimit != null) {
+            " Groq reports ${grouped(now.requestsLeft.toLong())} of ${grouped(now.requestsLimit.toLong())} requests left today."
+        } else {
+            ""
+        }
+        return used + left + " Groq publishes no balance; its free plan allows about 2,000 requests and 480 min of audio a day."
+    }
+
+    private fun deeplLine(now: State): String {
+        val used = now.deeplUsed
+        val limit = now.deeplLimit
+        return when {
+            used != null && limit != null ->
+                "DeepL: ${grouped(used)} of ${grouped(limit)} characters used this period, ${grouped((limit - used).coerceAtLeast(0L))} left."
+            now.deeplProblem != null -> "DeepL usage unavailable (${now.deeplProblem})."
+            else -> "DeepL usage: checking…"
+        }
+    }
+
+    private fun grouped(value: Long): String {
+        val digits = value.toString()
+        val out = StringBuilder()
+        digits.forEachIndexed { index, char ->
+            if (index > 0 && (digits.length - index) % 3 == 0) out.append(',')
+            out.append(char)
+        }
+        return out.toString()
+    }
+
+    private const val DAY_MS = 86_400_000L
+    private const val KEY_DAY = "usage_groq_day"
+    private const val KEY_CALLS = "usage_groq_calls"
+    private const val KEY_AUDIO = "usage_groq_audio_seconds"
+}
