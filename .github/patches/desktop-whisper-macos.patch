@@ -0,0 +1,150 @@
+// JNI bridge between the desktop app and whisper.cpp (statically linked), used for on-device
+// generated subtitles on macOS. The CI workflow builds libwhisper_all.a for each architecture
+// under ./lib/<arch>/ and copies the headers to ./include/; Gradle compiles this file into
+// libwhisper_bridge.dylib next to libplayer_bridge.dylib.
+//
+// Kotlin side: com.nuvio.app.features.player.generated.WhisperNative
+#include <jni.h>
+
+#include <atomic>
+#include <cstdio>
+#include <string>
+#include <vector>
+
+#include "whisper.h"
+
+namespace {
+
+struct Handle {
+    whisper_context* ctx = nullptr;
+    std::atomic<bool> cancel{false};
+};
+
+bool abortRequested(void* userData) {
+    return static_cast<Handle*>(userData)->cancel.load();
+}
+
+std::string toStdString(JNIEnv* env, jstring value) {
+    if (value == nullptr) return std::string();
+    const char* chars = env->GetStringUTFChars(value, nullptr);
+    if (chars == nullptr) return std::string();
+    std::string result(chars);
+    env->ReleaseStringUTFChars(value, chars);
+    return result;
+}
+
+std::string oneLine(const char* text) {
+    std::string out(text == nullptr ? "" : text);
+    for (char& c : out) {
+        if (c == '\t' || c == '\n' || c == '\r') c = ' ';
+    }
+    return out;
+}
+
+// Whisper emits standard UTF-8 (4-byte emoji, occasionally a cut sequence), which NewStringUTF does
+// not accept, so the text goes through new String(bytes, "UTF-8"), which repairs bad sequences.
+jstring utf8String(JNIEnv* env, jclass stringClass, jmethodID constructor, jstring charset, const std::string& text) {
+    jbyteArray bytes = env->NewByteArray(static_cast<jsize>(text.size()));
+    if (bytes == nullptr) return nullptr;
+    env->SetByteArrayRegion(bytes, 0, static_cast<jsize>(text.size()), reinterpret_cast<const jbyte*>(text.data()));
+    jstring result = static_cast<jstring>(env->NewObject(stringClass, constructor, bytes, charset));
+    env->DeleteLocalRef(bytes);
+    return result;
+}
+
+}  // namespace
+
+extern "C" {
+
+// Returns an opaque handle, or 0 when the model could not be loaded.
+JNIEXPORT jlong JNICALL Java_com_nuvio_app_features_player_generated_WhisperNative_nativeLoad(
+    JNIEnv* env, jobject, jstring path, jboolean useGpu) {
+    const std::string modelPath = toStdString(env, path);
+    whisper_context_params params = whisper_context_default_params();
+    params.use_gpu = useGpu == JNI_TRUE;
+    whisper_context* ctx = whisper_init_from_file_with_params(modelPath.c_str(), params);
+    if (ctx == nullptr) return 0;
+    Handle* handle = new Handle();
+    handle->ctx = ctx;
+    return reinterpret_cast<jlong>(handle);
+}
+
+// Recognises one window of 16 kHz mono float samples. The result is null when it failed or was
+// cancelled. Otherwise element 0 is the language code Whisper used and every following element is
+// "startMs<TAB>endMs<TAB>noSpeechProbability<TAB>text".
+JNIEXPORT jobjectArray JNICALL Java_com_nuvio_app_features_player_generated_WhisperNative_nativeTranscribe(
+    JNIEnv* env, jobject, jlong handlePtr, jfloatArray samples, jboolean translate, jstring language,
+    jint threads) {
+    Handle* handle = reinterpret_cast<Handle*>(handlePtr);
+    if (handle == nullptr || handle->ctx == nullptr || samples == nullptr) return nullptr;
+
+    const jsize count = env->GetArrayLength(samples);
+    std::vector<float> pcm(static_cast<size_t>(count));
+    env->GetFloatArrayRegion(samples, 0, count, pcm.data());
+    const std::string lang = toStdString(env, language);
+
+    handle->cancel.store(false);
+    whisper_full_params params = whisper_full_default_params(WHISPER_SAMPLING_GREEDY);
+    params.n_threads = threads > 0 ? threads : 4;
+    params.translate = translate == JNI_TRUE;
+    params.language = lang.empty() ? "auto" : lang.c_str();
+    params.detect_language = false;  // language "auto" already detects
+    params.print_progress = false;
+    params.print_realtime = false;
+    params.print_special = false;
+    params.print_timestamps = false;
+    params.no_context = true;  // windows are independent; carried context feeds repetition loops
+    params.suppress_blank = true;
+    params.abort_callback = abortRequested;
+    params.abort_callback_user_data = handle;
+
+    if (whisper_full(handle->ctx, params, pcm.data(), static_cast<int>(pcm.size())) != 0) return nullptr;
+    if (handle->cancel.load()) return nullptr;
+
+    const int segments = whisper_full_n_segments(handle->ctx);
+    jclass stringClass = env->FindClass("java/lang/String");
+    if (stringClass == nullptr) return nullptr;
+    jmethodID constructor = env->GetMethodID(stringClass, "<init>", "([BLjava/lang/String;)V");
+    jstring charset = env->NewStringUTF("UTF-8");
+    jobjectArray result = env->NewObjectArray(segments + 1, stringClass, nullptr);
+    if (constructor == nullptr || charset == nullptr || result == nullptr) return nullptr;
+
+    const int langId = whisper_full_lang_id(handle->ctx);
+    const char* detected = whisper_lang_str(langId);
+    jstring langString = env->NewStringUTF(detected == nullptr ? "" : detected);  // ASCII code
+    env->SetObjectArrayElement(result, 0, langString);
+    env->DeleteLocalRef(langString);
+
+    for (int i = 0; i < segments; i++) {
+        // whisper timestamps are in units of 10 ms
+        const long long start = whisper_full_get_segment_t0(handle->ctx, i) * 10;
+        const long long end = whisper_full_get_segment_t1(handle->ctx, i) * 10;
+        const float noSpeech = whisper_full_get_segment_no_speech_prob(handle->ctx, i);
+        char head[96];
+        std::snprintf(head, sizeof(head), "%lld\t%lld\t%.4f\t", start, end, static_cast<double>(noSpeech));
+        const std::string line = std::string(head) + oneLine(whisper_full_get_segment_text(handle->ctx, i));
+        jstring element = utf8String(env, stringClass, constructor, charset, line);
+        if (element == nullptr) return nullptr;  // exception pending (out of memory)
+        env->SetObjectArrayElement(result, i + 1, element);
+        env->DeleteLocalRef(element);
+    }
+    env->DeleteLocalRef(charset);
+    return result;
+}
+
+// Makes a running nativeTranscribe on this handle stop as soon as Whisper checks.
+JNIEXPORT void JNICALL Java_com_nuvio_app_features_player_generated_WhisperNative_nativeCancel(
+    JNIEnv*, jobject, jlong handlePtr) {
+    Handle* handle = reinterpret_cast<Handle*>(handlePtr);
+    if (handle != nullptr) handle->cancel.store(true);
+}
+
+JNIEXPORT void JNICALL Java_com_nuvio_app_features_player_generated_WhisperNative_nativeFree(
+    JNIEnv*, jobject, jlong handlePtr) {
+    Handle* handle = reinterpret_cast<Handle*>(handlePtr);
+    if (handle == nullptr) return;
+    if (handle->ctx != nullptr) whisper_free(handle->ctx);
+    delete handle;
+}
+
+}  // extern "C"
