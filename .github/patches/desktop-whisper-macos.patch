+package com.nuvio.app.features.player.generated
+
+import com.nuvio.app.features.player.audiosync.RmsVad
+import kotlin.math.max
+
+/**
+ * Pulls the timing of recognised lines onto the dialogue that is really in the audio. Whisper
+ * (large-v3 in particular) often starts a line early, in the silence or music before the first
+ * word, and ends it late; Groq behaves the same. The voice-activity runs of the same window give
+ * the real speech onset and end, so each line starts when its speech starts and stops when it stops.
+ */
+internal object SubtitleTimingSnap {
+    /** A line's start moves at most this far (seconds); a larger gap means VAD and line disagree. */
+    private const val MAX_START_SHIFT = 10.0
+    private const val MAX_END_SHIFT = 6.0
+    private const val MAX_EARLIER_SHIFT = 1.5
+    private const val MIN_DURATION = 0.6
+    private const val TAIL = 0.15
+
+    /** [spans] are (start, end) seconds from the window start, in order; returns the same count. */
+    fun snap(spans: List<Pair<Double, Double>>, samples: FloatArray): List<Pair<Double, Double>> {
+        val runs = RmsVad.detect(samples).map { (a, b) -> a / 1000.0 to b / 1000.0 }
+        if (runs.isEmpty() || spans.isEmpty()) return spans
+        val out = ArrayList<Pair<Double, Double>>(spans.size)
+        var floor = 0.0
+        for ((rawStart, rawEnd) in spans) {
+            var start = rawStart
+            var end = rawEnd
+            // First speech run that is still going on, or starts, after the line's claimed start.
+            val first = runs.firstOrNull { it.second > rawStart && it.first < rawEnd }
+            if (first != null && first.first > rawStart && first.first - rawStart <= MAX_START_SHIFT) {
+                start = first.first
+            } else if (first != null && first.first < rawStart && rawStart - first.first <= MAX_EARLIER_SHIFT && first.first >= floor) {
+                // Whisper started the line after the words began: show it when the speech starts.
+                start = first.first
+            }
+            // Last speech run that starts before the line's claimed end.
+            val last = runs.lastOrNull { it.first < rawEnd && it.second > start }
+            if (last != null && last.second + TAIL < rawEnd && rawEnd - last.second <= MAX_END_SHIFT) {
+                end = last.second + TAIL
+            }
+            start = max(start, floor)
+            end = max(end, start + MIN_DURATION)
+            out += start to end
+            floor = out.last().second
+        }
+        return out
+    }
+}
