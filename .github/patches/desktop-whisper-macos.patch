@@ -0,0 +1,55 @@
+package com.nuvio.app.features.player.generated
+
+import co.touchlab.kermit.Logger
+import java.io.File
+
+/**
+ * JNI binding for the whisper.cpp bridge (libwhisper_bridge.dylib, built by Gradle from
+ * native/macos/whisper/whisper_bridge.cpp). Only the macOS app bundles it; elsewhere [available]
+ * is false and generated subtitles keep using Groq.
+ */
+internal object WhisperNative {
+    private val log = Logger.withTag("WhisperNative")
+
+    external fun nativeLoad(path: String, useGpu: Boolean): Long
+    external fun nativeTranscribe(
+        handle: Long,
+        samples: FloatArray,
+        translate: Boolean,
+        language: String,
+        threads: Int,
+    ): Array<String>?
+    external fun nativeCancel(handle: Long)
+    external fun nativeFree(handle: Long)
+
+    /** True once the bridge library is loaded. */
+    val available: Boolean by lazy { loadBridge() }
+
+    private fun loadBridge(): Boolean {
+        if (!System.getProperty("os.name").orEmpty().contains("mac", ignoreCase = true)) return false
+        val library = findLibrary() ?: run {
+            log.i { "libwhisper_bridge.dylib not found; on-device Whisper is unavailable" }
+            return false
+        }
+        return runCatching { System.load(library.absolutePath) }
+            .onFailure { error -> log.w(error) { "could not load ${library.absolutePath}" } }
+            .isSuccess
+    }
+
+    private fun findLibrary(): File? {
+        val name = "libwhisper_bridge.dylib"
+        System.getProperty("compose.application.resources.dir")
+            ?.takeIf(String::isNotBlank)
+            ?.let { File(it, "native/macos/$name") }
+            ?.takeIf(File::isFile)
+            ?.let { return it }
+        val architectures = when (System.getProperty("os.arch").orEmpty().lowercase()) {
+            "aarch64", "arm64" -> listOf("arm64", "aarch64")
+            "amd64", "x64", "x86_64" -> listOf("x86_64")
+            else -> emptyList()
+        }
+        val roots = listOf(File("composeApp/build/native/macos"), File("build/native/macos"))
+        return roots.flatMap { root -> architectures.map { root.resolve(it).resolve(name) } }
+            .firstOrNull(File::isFile)
+    }
+}
