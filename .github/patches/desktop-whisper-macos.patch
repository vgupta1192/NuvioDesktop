+package com.nuvio.app.features.player.generated
+
+import com.nuvio.app.features.player.audiosync.SyncLog
+import java.io.File
+import java.util.concurrent.Executors
+import java.util.concurrent.ScheduledExecutorService
+import java.util.concurrent.TimeUnit
+
+/**
+ * On-device speech recognition with whisper.cpp (large-v3), macOS only. The model context takes
+ * several GB of memory, so it is loaded when generation starts and freed again after
+ * [IDLE_FREE_MS] without a request. Calls are serialised.
+ */
+internal object WhisperLocal {
+    private const val IDLE_FREE_MS = 60_000L
+    private const val NO_SPEECH_LIMIT = 0.6
+
+    private val lock = Any()
+    private var handle = 0L
+    private var loadedPath: String? = null
+    private var lastUse = 0L
+    @Volatile private var cancelHandle = 0L
+
+    private val idle: ScheduledExecutorService by lazy {
+        Executors.newSingleThreadScheduledExecutor { task ->
+            Thread(task, "nuvio-whisper-idle").apply { isDaemon = true }
+        }
+    }
+
+    /** True when the native bridge is in this build and loaded. */
+    val available: Boolean get() = WhisperNative.available
+
+    /** Recognises [samples] (16 kHz mono) with the model file [model]. Blocking; may take minutes on CPU. */
+    fun recognize(
+        model: File,
+        samples: FloatArray,
+        translate: Boolean,
+        language: String,
+    ): List<GroqWhisperClient.Line> {
+        val raw = synchronized(lock) {
+            ensureLoaded(model)
+            val threads = Runtime.getRuntime().availableProcessors().coerceIn(2, 8)
+            val result = WhisperNative.nativeTranscribe(handle, samples, translate, language, threads)
+            lastUse = System.currentTimeMillis()
+            scheduleFree()
+            result
+        } ?: throw GroqWhisperClient.Failure("on-device Whisper stopped without a result", permanent = false)
+        val spoken = raw.firstOrNull().orEmpty()
+        return raw.drop(1).mapNotNull { row ->
+            val cells = row.split('\t', limit = 4)
+            if (cells.size < 4) return@mapNotNull null
+            val noSpeech = cells[2].toDoubleOrNull() ?: 0.0
+            val text = cells[3].trim()
+            if (noSpeech >= NO_SPEECH_LIMIT || text.isEmpty()) return@mapNotNull null
+            val start = (cells[0].toLongOrNull() ?: return@mapNotNull null) / 1000.0
+            val end = (cells[1].toLongOrNull() ?: return@mapNotNull null) / 1000.0
+            GroqWhisperClient.Line(start, end, text, spoken)
+        }
+    }
+
+    /** Stops a recognition that is running now (the next call starts normally). */
+    fun cancelCurrent() {
+        val current = cancelHandle
+        if (current != 0L) WhisperNative.nativeCancel(current)
+    }
+
+    private fun ensureLoaded(model: File) {
+        if (handle != 0L && loadedPath == model.absolutePath) return
+        releaseLocked()
+        SyncLog.i("generated subtitles: loading ${model.name}")
+        var loaded = WhisperNative.nativeLoad(model.absolutePath, true)
+        if (loaded == 0L) {
+            SyncLog.w("generated subtitles: GPU load failed, trying the CPU")
+            loaded = WhisperNative.nativeLoad(model.absolutePath, false)
+        }
+        if (loaded == 0L) {
+            // a damaged file would fail on every start; the next request downloads it again
+            runCatching { model.delete() }
+            throw GroqWhisperClient.Failure("could not load ${model.name}; it is deleted and downloads again", permanent = false)
+        }
+        handle = loaded
+        cancelHandle = loaded
+        loadedPath = model.absolutePath
+    }
+
+    private fun scheduleFree() {
+        idle.schedule({
+            synchronized(lock) {
+                if (handle != 0L && System.currentTimeMillis() - lastUse >= IDLE_FREE_MS) releaseLocked()
+            }
+        }, IDLE_FREE_MS + 1_000L, TimeUnit.MILLISECONDS)
+    }
+
+    /** Frees the model now (Settings "delete models"). */
+    fun release() {
+        synchronized(lock) { releaseLocked() }
+    }
+
+    private fun releaseLocked() {
+        if (handle != 0L) {
+            cancelHandle = 0L
+            WhisperNative.nativeFree(handle)
+            handle = 0L
+            loadedPath = null
+        }
+    }
+}
