+// whisper.cpp bridge for on-device generated subtitles. The CI workflow builds the static
+// libwhisper_all.a per architecture into native/macos/whisper/lib/<arch>/ and the headers into
+// native/macos/whisper/include/; without them the task is off and the app falls back to Groq.
+val macosWhisperDir = layout.projectDirectory.dir("src/desktopMain/native/macos/whisper").asFile
+val macosWhisperBridgeSource = File(macosWhisperDir, "whisper_bridge.cpp")
+val macosWhisperStaticLib = File(macosWhisperDir, "lib/$macosPlayerBridgeArch/libwhisper_all.a")
+val macosWhisperBridgeOutput = layout.buildDirectory.file("native/macos/$macosPlayerBridgeArch/libwhisper_bridge.dylib")
+val buildMacosWhisperBridge = tasks.register<Exec>("buildMacosWhisperBridge") {
+    notCompatibleWithConfigurationCache("Builds a host-local whisper.cpp bridge against the static whisper libraries.")
+    enabled = isMacHost && macosWhisperStaticLib.isFile && macosWhisperBridgeSource.isFile
+    inputs.file(macosWhisperBridgeSource)
+    inputs.file(macosWhisperStaticLib)
+    outputs.file(macosWhisperBridgeOutput)
+    doFirst { macosWhisperBridgeOutput.get().asFile.parentFile.mkdirs() }
+    commandLine(
+        "xcrun", "clang++",
+        "-std=c++17", "-O2", "-dynamiclib",
+        "-arch", macosPlayerBridgeArch,
+        "-mmacosx-version-min=13.0",
+        macosWhisperBridgeSource.absolutePath,
+        "-o", macosWhisperBridgeOutput.get().asFile.absolutePath,
+        "-I$macosPlayerBridgeJavaHome/include",
+        "-I$macosPlayerBridgeJavaHome/include/darwin",
+        "-I${File(macosWhisperDir, "include").absolutePath}",
+        macosWhisperStaticLib.absolutePath,
+        "-framework", "Accelerate",
+        "-framework", "Foundation",
+        "-framework", "Metal",
+        "-framework", "MetalKit",
+        "-lc++",
+    )
+}
+
