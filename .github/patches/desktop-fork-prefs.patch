+package com.nuvio.app.features.settings
+
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/**
+ * Small fork settings kept in the platform store, shared by several fork features.
+ * The desktop engine installs [Storage] at app start; elsewhere everything stays default.
+ */
+object ForkPrefs {
+    interface Storage {
+        fun getBoolean(key: String): Boolean?
+        fun putBoolean(key: String, value: Boolean)
+        fun getString(key: String): String?
+        fun putString(key: String, value: String)
+    }
+
+    var storage: Storage? = null
+        private set
+
+    class BoolPref(private val key: String, private val default: Boolean) {
+        private val _value = MutableStateFlow(default)
+        val value: StateFlow<Boolean> = _value.asStateFlow()
+
+        fun ensureLoaded() {
+            val stored = storage?.getBoolean(key) ?: return
+            _value.value = stored
+        }
+
+        fun current(): Boolean {
+            ensureLoaded()
+            return _value.value
+        }
+
+        fun set(enabled: Boolean) {
+            _value.value = enabled
+            storage?.putBoolean(key, enabled)
+        }
+    }
+
+    class StringPref(private val key: String, private val default: String) {
+        private val _value = MutableStateFlow(default)
+        val value: StateFlow<String> = _value.asStateFlow()
+
+        fun ensureLoaded() {
+            val stored = storage?.getString(key) ?: return
+            _value.value = stored
+        }
+
+        fun current(): String {
+            ensureLoaded()
+            return _value.value
+        }
+
+        fun set(text: String) {
+            _value.value = text
+            storage?.putString(key, text)
+        }
+    }
+
+    val subtitleShadow = BoolPref("settings/subtitle_shadow", false)
+    val subtitlesStartOff = BoolPref("settings/subtitles_start_off", false)
+    val skipFeedback = BoolPref("settings/skip_feedback", true)
+
+    /** Called once from the desktop engine before any UI reads a pref. */
+    fun install(newStorage: Storage) {
+        storage = newStorage
+        subtitleShadow.ensureLoaded()
+        subtitlesStartOff.ensureLoaded()
+        skipFeedback.ensureLoaded()
+    }
+}
