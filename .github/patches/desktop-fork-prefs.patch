+package com.nuvio.app.features.settings
+
+import com.nuvio.app.core.storage.DesktopStorage
+
+/** Desktop backing store for [ForkPrefs]; called once from Main at app start. */
+internal fun installForkPrefs() {
+    val store = DesktopStorage.store("nuvio_fork_prefs")
+    ForkPrefs.install(object : ForkPrefs.Storage {
+        override fun getBoolean(key: String): Boolean? = store.getString(key)?.let { it == "1" }
+        override fun putBoolean(key: String, value: Boolean) {
+            store.putString(key, if (value) "1" else "0")
+        }
+        override fun getString(key: String): String? = store.getString(key)
+        override fun putString(key: String, value: String) {
+            store.putString(key, value)
+        }
+    })
+}
