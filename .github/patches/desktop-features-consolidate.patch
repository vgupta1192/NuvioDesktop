+@Composable
+internal fun ForkDohSettingsSection(isTablet: Boolean) {
+SettingsSection(
+        title = "Network",
+        isTablet = isTablet,
+    ) {
+        SettingsGroup(isTablet = isTablet) {
+            DohSettingsRow(isTablet = isTablet)
+        }
+    }
+}
+
+@Composable
+internal fun ForkImageCacheSection(isTablet: Boolean) {
+var cleared by remember { mutableStateOf(false) }
+    SettingsSection(
+        title = "Storage",
+        isTablet = isTablet,
+    ) {
+        SettingsGroup(isTablet = isTablet) {
+            val imageLoaderContext = coil3.compose.LocalPlatformContext.current
+            SettingsNavigationRow(
+                title = "Clear image cache",
+                description = "Remove cached posters and backdrops. They download again when needed.",
+                isTablet = isTablet,
+                trailingContent = if (cleared) {
+                    {
+                        Text(
+                            "Cleared",
+                            style = MaterialTheme.typography.labelLarge,
+                            color = MaterialTheme.colorScheme.primary,
+                        )
+                    }
+                } else {
+                    null
+                },
+                onClick = {
+                    val loader = coil3.SingletonImageLoader.get(imageLoaderContext)
+                    loader.memoryCache?.clear()
+                    loader.diskCache?.clear()
+                    cleared = true
+                },
+            )
+        }
+    }
+}
+
+@Composable
+internal fun ForkCrashLogsSection(isTablet: Boolean) {
+if (CrashLogPlatform.available) {
+        var showCrashLogs by remember { mutableStateOf(false) }
+        val clipboardManager = androidx.compose.ui.platform.LocalClipboardManager.current
+        SettingsSection(
+            title = "Crash logs",
+            isTablet = isTablet,
+        ) {
+            SettingsGroup(isTablet = isTablet) {
+                SettingsNavigationRow(
+                    title = "Crash logs",
+                    description = if (CrashLogPlatform.files().isEmpty()) {
+                        "No crash logs recorded."
+                    } else {
+                        "${CrashLogPlatform.files().size} recorded. The newest is shown; report it if you hit a bug."
+                    },
+                    isTablet = isTablet,
+                    onClick = { showCrashLogs = true },
+                )
+            }
+        }
+        if (showCrashLogs) {
+            val names = remember(showCrashLogs) { CrashLogPlatform.files() }
+            val latest = names.firstOrNull()?.let { CrashLogPlatform.read(it) }
+            androidx.compose.material3.AlertDialog(
+                onDismissRequest = { showCrashLogs = false },
+                confirmButton = {
+                    androidx.compose.material3.TextButton(onClick = {
+                        latest?.let { text ->
+                            clipboardManager.setText(androidx.compose.ui.text.AnnotatedString(text))
+                        }
+                    }) { Text("Copy latest") }
+                },
+                dismissButton = {
+                    androidx.compose.material3.TextButton(onClick = {
+                        CrashLogPlatform.clear()
+                        showCrashLogs = false
+                    }) { Text("Clear all") }
+                },
+                title = { Text("Crash logs") },
+                text = {
+                    Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
+                        Text(names.joinToString("\n"))
+                        if (latest != null) {
+                            Text(
+                                text = latest.take(4000),
+                                style = MaterialTheme.typography.bodySmall,
+                            )
+                        }
+                    }
+                },
+            )
+        }
+    }
+}
