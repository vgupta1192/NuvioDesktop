+package com.nuvio.app.features.settings
+
+import androidx.compose.foundation.layout.Arrangement
+import androidx.compose.foundation.layout.Column
+import androidx.compose.foundation.layout.Row
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.padding
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.material3.Text
+import androidx.compose.material3.TextButton
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.text.font.FontWeight
+import androidx.compose.ui.unit.dp
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.nuvio.app.core.ui.DialogButton
+import com.nuvio.app.core.ui.DialogButtons
+import com.nuvio.app.core.ui.DialogSurface
+import com.nuvio.app.features.tracking.WeTrakrRepository
+import kotlinx.coroutines.launch
+
+/** Nuvio fork: WeTrakr account card — device-code sign-in, live scrobbling and history writes. */
+@Composable
+internal fun WeTrakrProviderCard(modifier: Modifier = Modifier) {
+    androidx.compose.runtime.LaunchedEffect(Unit) { WeTrakrRepository.ensureLoaded() }
+    val state by WeTrakrRepository.state.collectAsStateWithLifecycle()
+    val scope = rememberCoroutineScope()
+    fun dismiss() = scope.launch { WeTrakrRepository.cancelConnect() }
+
+    Column(
+        modifier = modifier
+            .fillMaxWidth()
+            .padding(vertical = 4.dp),
+        verticalArrangement = Arrangement.spacedBy(6.dp),
+    ) {
+        Row(
+            modifier = Modifier.fillMaxWidth(),
+            horizontalArrangement = Arrangement.SpaceBetween,
+            verticalAlignment = Alignment.CenterVertically,
+        ) {
+            Column {
+                Text(
+                    text = "WeTrakr",
+                    style = MaterialTheme.typography.titleMedium,
+                    fontWeight = FontWeight.SemiBold,
+                )
+                val statusText = when {
+                    state.isConnected -> state.username?.let { "Connected as $it" } ?: "Connected"
+                    state.busy || state.userCode != null -> "Waiting for sign-in…"
+                    else -> "Scrobbling and watched-history sync."
+                }
+                Text(
+                    text = statusText,
+                    style = MaterialTheme.typography.bodySmall,
+                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                )
+            }
+            Row(verticalAlignment = Alignment.CenterVertically) {
+                if (state.isConnected) {
+                    TextButton(onClick = { WeTrakrRepository.disconnect() }) { Text("Disconnect") }
+                } else {
+                    TextButton(onClick = { WeTrakrRepository.connect() }, enabled = !state.busy) {
+                        Text("Connect")
+                    }
+                }
+            }
+        }
+        state.error?.let { error ->
+            Text(
+                text = error,
+                style = MaterialTheme.typography.bodySmall,
+                color = MaterialTheme.colorScheme.error,
+            )
+        }
+    }
+
+    if (state.userCode != null || state.busy) {
+        DialogSurface(
+            onDismissRequest = { dismiss() },
+            title = "Connect WeTrakr",
+        ) {
+            Column(
+                modifier = Modifier.fillMaxWidth().padding(vertical = 8.dp),
+                verticalArrangement = Arrangement.spacedBy(10.dp),
+            ) {
+                val userCode = state.userCode
+                if (userCode != null) {
+                    Text(
+                        text = "1. Open",
+                        style = MaterialTheme.typography.labelLarge,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    )
+                    Text(
+                        text = state.verificationUrl ?: "https://wetrakr.com/activate",
+                        style = MaterialTheme.typography.bodyLarge,
+                        fontWeight = FontWeight.SemiBold,
+                        color = MaterialTheme.colorScheme.primary,
+                    )
+                    Text(
+                        text = "2. Enter this code:",
+                        style = MaterialTheme.typography.labelLarge,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    )
+                    Text(
+                        text = userCode,
+                        style = MaterialTheme.typography.headlineMedium,
+                        fontWeight = FontWeight.Bold,
+                    )
+                    Text(
+                        text = "The app keeps checking until you finish, then connects automatically.",
+                        style = MaterialTheme.typography.bodySmall,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant,
+                    )
+                } else {
+                    Text("Contacting WeTrakr…")
+                }
+            }
+            DialogButtons {
+                DialogButton(
+                    text = "Cancel",
+                    onClick = { dismiss() },
+                )
+            }
+        }
+    }
+}
