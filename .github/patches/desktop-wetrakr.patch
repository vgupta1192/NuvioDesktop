@@ -0,0 +1,393 @@
+package com.nuvio.app.features.tracking
+
+import co.touchlab.kermit.Logger
+import com.nuvio.app.features.addons.httpRequestRaw
+import com.nuvio.app.features.settings.ForkPrefs
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.Job
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.sync.Mutex
+import kotlinx.coroutines.sync.withLock
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonObject
+import kotlinx.serialization.json.JsonPrimitive
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.intOrNull
+import kotlinx.serialization.json.jsonArray
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.longOrNull
+import kotlinx.serialization.json.put
+
+data class WeTrakrUiState(
+    val isConnected: Boolean = false,
+    val username: String? = null,
+    val userCode: String? = null,
+    val verificationUrl: String? = null,
+    val busy: Boolean = false,
+    val error: String? = null,
+)
+
+/**
+ * Nuvio fork (ported from the TV fork): WeTrakr account with device-code sign-in, live
+ * scrobbling and watched-history writes. Reads (library/progress/ratings) are not part of
+ * the port. Auth is stored through [ForkPrefs] raw storage.
+ */
+object WeTrakrRepository : TrackingScrobbler {
+    private val log = Logger.withTag("WeTrakr")
+    private val json = Json { ignoreUnknownKeys = true; isLenient = true }
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+    private val refreshMutex = Mutex()
+    private val writeMutex = Mutex()
+    private var pollJob: Job? = null
+
+    private val mutableState = MutableStateFlow(loadState())
+    val state: StateFlow<WeTrakrUiState> = mutableState.asStateFlow()
+
+    override val providerId: TrackingProviderId = TrackingProviderId.WETRAKR
+
+    fun ensureLoaded() {
+        mutableState.value = loadState()
+    }
+
+    fun connect() {
+        if (mutableState.value.isConnected || pollJob?.isActive == true) return
+        mutableState.update { it.copy(busy = true, error = null) }
+        pollJob = scope.launch {
+            try {
+                val device = requestDeviceCode()
+                mutableState.update { it.copy(busy = false, userCode = device.userCode, verificationUrl = device.verificationUrl) }
+                pollForTokens(device)
+            } catch (cancelled: CancellationException) {
+                throw cancelled
+            } catch (e: Exception) {
+                mutableState.update { it.copy(busy = false, userCode = null, verificationUrl = null, error = e.message ?: "WeTrakr request failed") }
+            }
+        }
+    }
+
+    fun cancelConnect() {
+        cancelPolling()
+        mutableState.update { it.copy(busy = false, userCode = null, verificationUrl = null) }
+    }
+
+    fun disconnect() {
+        cancelPolling()
+        val auth = readAuth()
+        writeAuth(null)
+        mutableState.value = WeTrakrUiState()
+        if (auth?.refreshToken != null) {
+            scope.launch {
+                runCatching {
+                    send("POST", "/oauth/logout", buildJsonObject { put("refresh_token", auth.refreshToken) }, auth.accessToken)
+                }
+            }
+        }
+    }
+
+    override suspend fun scrobble(
+        profileId: Int,
+        action: TrackingScrobbleAction,
+        event: TrackingScrobbleEvent,
+    ) {
+        if (!mutableState.value.isConnected || !event.progressPercent.isFinite()) return
+        val media = event.media
+        val ids = mediaIds(media) ?: return
+        val isMovie = media.kind == TrackingMediaKind.MOVIE
+        val episode = media.episode
+        if (!isMovie && episode == null) return
+        val body = buildJsonObject {
+            if (isMovie) {
+                put("movie", titleObject(media, ids))
+            } else {
+                put("show", titleObject(media, ids))
+                put("episode", buildJsonObject {
+                    put("season", episode?.season ?: 1)
+                    put("number", episode?.number ?: 1)
+                })
+            }
+            put("progress", event.progressPercent.coerceIn(0.0, 100.0))
+        }
+        authorizedPost("/scrobble/${action.wireValue}", body)
+    }
+
+    suspend fun addToHistory(items: Collection<TrackingHistoryItem>): TrackingMutationResult {
+        if (!mutableState.value.isConnected) return TrackingMutationResult(items.size)
+        val document = historyDocument(items.map { it.media to it.watchedAtEpochMs })
+            ?: return TrackingMutationResult(items.size, items.size)
+        writeMutex.withLock { authorizedPost("/sync/tracking", document) }
+        return TrackingMutationResult(items.size)
+    }
+
+    suspend fun removeFromHistory(items: Collection<TrackingMediaReference>): TrackingMutationResult {
+        if (!mutableState.value.isConnected) return TrackingMutationResult(0)
+        val document = historyDocument(items.map { it to null })
+            ?: return TrackingMutationResult(items.size, items.size)
+        writeMutex.withLock { authorizedPost("/sync/tracking/remove/all", document) }
+        return TrackingMutationResult(items.size)
+    }
+
+    // --- internals ---
+
+    private fun historyDocument(entries: List<Pair<TrackingMediaReference, Long?>>): JsonObject? {
+        val movies = mutableListOf<kotlinx.serialization.json.JsonElement>()
+        val shows = linkedMapOf<String, Pair<MutableMap<String, kotlinx.serialization.json.JsonElement>, MutableMap<Int, MutableMap<Int, Long?>>>>()
+        entries.forEach { (media, watchedAt) ->
+            val ids = mediaIds(media) ?: return@forEach
+            if (media.kind == TrackingMediaKind.MOVIE) {
+                movies += buildJsonObject {
+                    put("ids", ids)
+                    put("status", WATCHED)
+                    watchedAt?.let { put("tracked_at", isoTimestamp(it)) }
+                }
+                return@forEach
+            }
+            val episode = media.episode ?: return@forEach
+            val key = ids.toString()
+            val show = shows.getOrPut(key) {
+                buildJsonObject {
+                    put("ids", ids)
+                    put("status", WATCHED)
+                } to linkedMapOf()
+            }
+            show.second.getOrPut(episode.season ?: 1) { linkedMapOf() }[episode.number] = watchedAt
+        }
+        if (movies.isEmpty() && shows.isEmpty()) return null
+        val showArray = shows.values.map { (show, seasons) ->
+            buildJsonObject {
+                put("ids", (show["ids"] as JsonObject))
+                put("status", WATCHED)
+                put("seasons", kotlinx.serialization.json.JsonArray(
+                    seasons.toSortedMap().map { (season, episodes) ->
+                        buildJsonObject {
+                            put("number", season)
+                            put("episodes", kotlinx.serialization.json.JsonArray(
+                                episodes.toSortedMap().map { (number, watchedAt) ->
+                                    buildJsonObject {
+                                        put("number", number)
+                                        put("status", WATCHED)
+                                        watchedAt?.let { put("tracked_at", isoTimestamp(it)) }
+                                    }
+                                },
+                            ))
+                        }
+                    },
+                ))
+            }
+        }
+        return buildJsonObject {
+            put("movies", kotlinx.serialization.json.JsonArray(movies))
+            put("shows", kotlinx.serialization.json.JsonArray(showArray))
+        }
+    }
+
+    private fun mediaIds(media: TrackingMediaReference): JsonObject? {
+        val obj = buildJsonObject {
+            media.ids.imdb?.takeIf(String::isNotBlank)?.let { put("imdb", it) }
+            media.ids.tmdb?.let { put("tmdb", it) }
+            media.ids.tvdb?.toLongOrNull()?.let { put("tvdb", it) }
+        }
+        return obj.takeIf { it.isNotEmpty() }
+    }
+
+    private fun titleObject(media: TrackingMediaReference, ids: JsonObject): JsonObject = buildJsonObject {
+        media.title?.takeIf(String::isNotBlank)?.let { put("title", it) }
+        media.year?.let { put("year", it) }
+        put("ids", ids)
+    }
+
+    private fun isoTimestamp(epochMs: Long): String =
+        java.time.Instant.ofEpochMilli(epochMs).toString().replace("\\.\\d{3}Z$".toRegex(), "Z")
+
+    // --- auth ---
+
+    private data class DeviceCode(val deviceCode: String, val userCode: String, val verificationUrl: String, val intervalSeconds: Long, val expiresAtEpochMs: Long)
+    private data class StoredAuth(val accessToken: String?, val refreshToken: String?, val expiresAtEpochMs: Long?, val username: String?)
+    private data class Response(val status: Int, val body: String)
+
+    private suspend fun requestDeviceCode(): DeviceCode {
+        val response = send("POST", "/oauth/device/code", buildJsonObject { put("client_id", CLIENT_ID) }, null)
+        if (response.status !in 200..299) {
+            throw IllegalStateException(if (response.status == 429) "WeTrakr is rate limiting requests, try again shortly" else "WeTrakr sign-in is unavailable (${response.status})")
+        }
+        val root = json.parseToJsonElement(response.body).jsonObject
+        val userCode = root.str("user_code") ?: throw IllegalStateException("WeTrakr sent no code")
+        val deviceCode = root.str("device_code") ?: throw IllegalStateException("WeTrakr sent no code")
+        val url = root.str("verification_url") ?: root.str("verification_uri") ?: DEFAULT_VERIFICATION_URL
+        val interval = (root["interval"]?.jsonPrimitive?.longOrNull ?: 5L).coerceIn(1L, 60L)
+        val expiresIn = (root["expires_in"]?.jsonPrimitive?.longOrNull ?: 600L).coerceIn(60L, 3_600L)
+        return DeviceCode(deviceCode, userCode, url, interval, System.currentTimeMillis() + expiresIn * 1_000L)
+    }
+
+    private suspend fun pollForTokens(device: DeviceCode) {
+        var interval = device.intervalSeconds
+        while (System.currentTimeMillis() < device.expiresAtEpochMs) {
+            delay(interval * 1_000L)
+            val response = send(
+                "POST",
+                "/oauth/device/token",
+                buildJsonObject {
+                    put("code", device.deviceCode)
+                    put("device_code", device.deviceCode)
+                    put("client_id", CLIENT_ID)
+                },
+                null,
+            )
+            when {
+                response.status in 200..299 -> {
+                    val auth = parseTokens(response.body)
+                    if (auth == null) {
+                        finishConnect("WeTrakr sent an invalid sign-in response")
+                    } else {
+                        writeAuth(auth)
+                        mutableState.value = WeTrakrUiState(isConnected = true, username = auth.username)
+                    }
+                    return
+                }
+                response.status == 429 -> interval = (interval + 5L).coerceAtMost(60L)
+                response.status == 400 -> {
+                    val code = errorCode(response.body)
+                    when {
+                        code.contains("slow", ignoreCase = true) -> interval = (interval + 5L).coerceAtMost(60L)
+                        code.contains("expired", ignoreCase = true) -> return finishConnect("The code expired. Start again.")
+                        code.contains("denied", ignoreCase = true) -> return finishConnect("Sign-in was denied.")
+                        else -> Unit
+                    }
+                }
+                response.status == 410 -> return finishConnect("The code expired. Start again.")
+                response.status == 418 -> return finishConnect("Sign-in was denied.")
+                response.status in 500..599 -> Unit
+                else -> return finishConnect("WeTrakr sign-in failed (${response.status})")
+            }
+        }
+        finishConnect("The code expired. Start again.")
+    }
+
+    private fun finishConnect(error: String) {
+        mutableState.update { it.copy(busy = false, userCode = null, verificationUrl = null, error = error) }
+    }
+
+    private fun cancelPolling() {
+        pollJob?.cancel()
+        pollJob = null
+    }
+
+    private fun errorCode(body: String): String = runCatching {
+        val root = json.parseToJsonElement(body).jsonObject
+        (root["error"] as? JsonPrimitive)?.content?.takeIf { it.isNotBlank() && !it.startsWith("{") }
+            ?: (root["error"] as? JsonObject)?.get("code")?.jsonPrimitive?.content
+            ?: root["code"]?.jsonPrimitive?.content
+    }.getOrNull().orEmpty()
+
+    private fun parseTokens(body: String): StoredAuth? = runCatching {
+        val root = json.parseToJsonElement(body).jsonObject
+        val access = root.str("access_token") ?: return null
+        val refresh = (root.str("refresh_token") ?: root.str("new_refresh_token")) ?: return null
+        val expiresIn = root["expires_in"]?.jsonPrimitive?.longOrNull ?: 0L
+        val expiresAt = if (expiresIn > 0L) System.currentTimeMillis() + expiresIn * 1_000L else null
+        val username = root.str("username") ?: (root["user"] as? JsonObject)?.str("username")
+        StoredAuth(access, refresh, expiresAt, username)
+    }.getOrNull()
+
+    private fun JsonObject.str(key: String): String? =
+        (this[key] as? JsonPrimitive)?.content?.takeIf(String::isNotBlank)
+
+    private fun StoredAuth.toJson(): String = buildJsonObject {
+        put("access", accessToken.orEmpty())
+        put("refresh", refreshToken.orEmpty())
+        expiresAtEpochMs?.let { put("expiresAt", it) }
+        username?.let { put("username", it) }
+    }.toString()
+
+    private fun readAuth(): StoredAuth? = runCatching {
+        val raw = ForkPrefs.readRaw(AUTH_KEY) ?: return null
+        val root = json.parseToJsonElement(raw).jsonObject
+        StoredAuth(
+            accessToken = root.str("access"),
+            refreshToken = root.str("refresh"),
+            expiresAtEpochMs = root["expiresAt"]?.jsonPrimitive?.longOrNull,
+            username = root.str("username"),
+        )
+    }.getOrNull()
+
+    private fun writeAuth(auth: StoredAuth?) {
+        ForkPrefs.writeRaw(AUTH_KEY, auth?.toJson() ?: "")
+    }
+
+    private fun loadState(): WeTrakrUiState {
+        val auth = readAuth()
+        return WeTrakrUiState(isConnected = auth?.refreshToken != null, username = auth?.username)
+    }
+
+    private suspend fun accessToken(forceRefresh: Boolean): String? = refreshMutex.withLock {
+        val auth = readAuth() ?: return null
+        val expired = auth.expiresAtEpochMs?.let { it - System.currentTimeMillis() <= REFRESH_MARGIN_MS } == true
+        if (!forceRefresh && !expired && auth.accessToken != null) return auth.accessToken
+        val refresh = auth.refreshToken ?: return null
+        val response = send("POST", "/oauth/token/refresh", buildJsonObject { put("refresh_token", refresh) }, null)
+        when {
+            response.status in 200..299 -> {
+                val renewed = parseTokens(response.body) ?: return null
+                val merged = renewed.copy(username = renewed.username ?: auth.username)
+                writeAuth(merged)
+                merged.accessToken
+            }
+            response.status == 400 || response.status == 401 -> {
+                writeAuth(null)
+                mutableState.value = WeTrakrUiState(error = "WeTrakr sign-in was revoked. Connect again.")
+                null
+            }
+            else -> auth.accessToken.takeIf { !forceRefresh }
+        }
+    }
+
+    private suspend fun authorizedPost(path: String, body: JsonObject): Response? {
+        var token = accessToken(forceRefresh = false) ?: return null
+        var response = send("POST", path, body, token)
+        if (response.status == 401) {
+            token = accessToken(forceRefresh = true) ?: return null
+            response = send("POST", path, body, token)
+        }
+        if (response.status == 404) return response
+        if (response.status !in 200..299) throw IllegalStateException("WeTrakr $path failed (${response.status})")
+        return response
+    }
+
+    private suspend fun send(method: String, path: String, body: JsonObject?, token: String?): Response =
+        withContext(Dispatchers.Default) {
+            val response = httpRequestRaw(
+                method = method,
+                url = API_BASE_URL + path,
+                headers = buildMap {
+                    put("Accept", "application/json")
+                    put("User-Agent", USER_AGENT)
+                    put("wetrakr-api-key", CLIENT_ID)
+                    put("wetrakr-api-version", API_VERSION)
+                    put("Content-Type", "application/json")
+                    token?.let { put("Authorization", "Bearer $it") }
+                },
+                body = body?.toString().orEmpty(),
+            )
+            Response(response.status, response.body)
+        }
+
+    private const val AUTH_KEY = "wetrakr/auth"
