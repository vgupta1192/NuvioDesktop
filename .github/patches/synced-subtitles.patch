+/** Nuvio fork: whether [stream] has a subtitle synced before for the title shown. */
+@Composable
+internal fun rememberSyncedSubtitlesMark(stream: StreamItem): Boolean {
+    val videoId = LocalSyncedSubtitleVideoId.current
+    val marks by SyncedSubtitles.marks.collectAsState()
+    return remember(stream, videoId, marks) { SyncedSubtitles.isMarked(videoId, stream, marks) }
