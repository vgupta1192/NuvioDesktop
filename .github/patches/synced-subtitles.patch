+package com.nuvio.app.features.player
+
+import com.nuvio.app.core.storage.DesktopStorage
+import java.io.File
+
+/*
+ * Nuvio fork: synced subtitles on Desktop. Subtitles synced on any device signed in to the Nuvio
+ * account (see SyncedSubtitles) are shown with their saved timing instead of running AutoSync,
+ * and subtitles the desktop AutoSync retimes are saved for the other devices.
+ */
+internal object SyncedSubtitlesDesktop {
+    private const val MAX_FILES = 400
+
+    @Volatile
+    private var installed = false
+
+    private val dir: File by lazy { DesktopStorage.rootDir.resolve("synced-subtitles").toFile() }
+    private val showDir: File by lazy { DesktopStorage.cacheDir.resolve("synced-subtitles-show").toFile() }
+
+    /** Device storage for SyncedSubtitles, next to the app's other data. */
+    fun ensureStore() {
+        if (installed) return
+        installed = true
+        SyncedSubtitles.installStore(
+            load = { name -> runCatching { File(dir, name).takeIf { it.isFile }?.readText() }.getOrNull() },
+            save = { name, value ->
+                runCatching {
+                    dir.mkdirs()
+                    File(dir, name).writeText(value)
+                    val files = dir.listFiles().orEmpty()
+                    if (files.size > MAX_FILES) {
+                        files.sortedBy { it.lastModified() }.take(files.size - MAX_FILES).forEach { it.delete() }
+                    }
+                }
+            },
+        )
+    }
+
+    /** The saved synced copy of [url] as a local SRT file for mpv, or null when none is saved. */
+    fun savedFileFor(url: String): File? {
+        val saved = SyncedSubtitles.savedFor(url) ?: return null
+        return runCatching {
+            showDir.mkdirs()
+            showDir.listFiles().orEmpty().filter { System.currentTimeMillis() - it.lastModified() > 86_400_000L }.forEach { it.delete() }
+            File(showDir, "synced-${url.hashCode().toUInt()}.srt").apply { writeText(saved.srt) }
+        }.getOrNull()
+    }
+}
