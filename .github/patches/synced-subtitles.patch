+++ b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/player/SyncedSubtitles.kt
@@ -0,0 +1,333 @@
+package com.nuvio.app.features.player
+
+import androidx.compose.runtime.compositionLocalOf
+import com.nuvio.app.core.network.SupabaseProvider
+import com.nuvio.app.features.streams.StreamItem
+import io.github.jan.supabase.postgrest.postgrest
+import io.github.jan.supabase.postgrest.rpc
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.coroutines.flow.update
+import kotlinx.coroutines.launch
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.builtins.ListSerializer
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.JsonArray
+import kotlinx.serialization.json.buildJsonObject
+import kotlinx.serialization.json.contentOrNull
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.put
+
+/**
+ * Subtitles that AutoSync (or the audio sync) already synced for one title + stream, saved to the
+ * user's Nuvio account (table synced_subtitles on the self-hosted backend) and on this device.
+ *
+ * The saved timing is the synced subtitle itself, written as SRT, so any device (TV, Desktop)
+ * can show it without a sync engine. A stream that has one is marked in the stream lists, and
+ * playing it again selects that subtitle with the saved timing instead of running AutoSync.
+ *
+ * A stream is identified by its torrent (info hash + file index) when it plays as a torrent,
+ * otherwise by addon + stream name + description (numbers left out), which stay the same when
+ * debrid links change.
+ */
+object SyncedSubtitles {
+    @Serializable
+    data class Saved(
+        val subtitleUrl: String,
+        val language: String = "",
+        val name: String = "",
+        val method: String = "",
+        val srt: String,
+        val savedAtMs: Long = 0L,
+    )
+
+    data class Playback(val videoId: String, val streamKey: String)
+
+    private val json = Json { ignoreUnknownKeys = true; encodeDefaults = true }
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+
+    /** Nuvio fork: set by the platform so the shareable audio-sync log shows the pull story. */
+    var logSink: ((String) -> Unit)? = null
+    internal fun log(message: String) { logSink?.invoke(message) }
+
+    private var localLoad: ((name: String) -> String?)? = null
+    private var localSave: ((name: String, value: String) -> Unit)? = null
+
+    /** Device storage for saved subtitles, installed by the platform at app start. */
+    fun installStore(load: (name: String) -> String?, save: (name: String, value: String) -> Unit) {
+        localLoad = load
+        localSave = save
+    }
+
+    private val _playback = MutableStateFlow<Playback?>(null)
+    /** The title + stream playing now, set by the player. */
+    val playback: StateFlow<Playback?> = _playback.asStateFlow()
+
+    private val _saved = MutableStateFlow<Pair<Playback, Map<String, Saved>>?>(null)
+    /** Every synced subtitle saved for [playback] (by subtitle URL), once looked up. */
+    val saved: StateFlow<Pair<Playback, Map<String, Saved>>?> = _saved.asStateFlow()
+
+    private val _marks = MutableStateFlow<Map<String, Set<String>>>(emptyMap())
+    /** Stream keys with a synced subtitle, per video id, for the stream lists. */
+    val marks: StateFlow<Map<String, Set<String>>> = _marks.asStateFlow()
+
+    /** Looks up the subtitle list entry for a URL (language and name), set by the player. */
+    var describeSubtitle: (url: String) -> AddonSubtitle? = { null }
+
+    /** Subtitles restored from [saved] in this playback; their "synced" state is not saved again. */
+    val restoredUrls: MutableSet<String> = mutableSetOf()
+
+    fun streamKey(
+        addonId: String?,
+        name: String?,
+        description: String?,
+        torrentInfoHash: String?,
+        torrentFileIdx: Int?,
+    ): String? {
+        val hash = torrentInfoHash?.trim()?.lowercase()?.takeIf { it.isNotEmpty() }
+        if (hash != null) return "t:$hash:${torrentFileIdx ?: -1}"
+        val addon = addonId?.trim().orEmpty()
+        val label = name?.trim().orEmpty()
+        if (addon.isEmpty() && label.isEmpty()) return null
+        // Numbers are left out of the description: addons put live values there (speed, start
+        // time, seeders) that change on every load of the same stream.
+        val details = description.orEmpty().replace(VOLATILE_NUMBER, "#").trim()
+        return "s:" + fnv64("$addon\n$label\n$details")
+    }
+
+    /** Both keys a listed stream may have been saved under (as a torrent, or by its name). */
+    fun streamKeys(stream: StreamItem): List<String> = listOfNotNull(
+        stream.p2pInfoHash?.let { streamKey(stream.addonId, stream.streamLabel, stream.streamSubtitle, it, stream.p2pFileIdx) },
+        streamKey(stream.addonId, stream.streamLabel, stream.streamSubtitle, null, null),
+    )
+
+    fun isMarked(videoId: String?, stream: StreamItem, marks: Map<String, Set<String>>): Boolean {
+        val keys = marks[videoId ?: return false] ?: return false
+        return keys.isNotEmpty() && streamKeys(stream).any { it in keys }
+    }
+
+    /** Loads the stream marks of [videoId] from the device, then from the account. */
+    fun requestMarks(videoId: String) {
+        if (videoId.isBlank()) return
+        scope.launch {
+            val local = localLoad?.invoke(indexName(videoId))?.lines()?.filter { it.isNotBlank() }?.toSet().orEmpty()
+            if (local.isNotEmpty()) _marks.update { it + (videoId to (it[videoId].orEmpty() + local)) }
+            val remote = runCatching {
+                val result = SupabaseProvider.client.postgrest.rpc(
+                    "synced_subtitles_list",
+                    buildJsonObject { put("p_video_id", videoId) },
+                )
+                (Json.parseToJsonElement(result.data) as? JsonArray)
+                    ?.mapNotNull { it.jsonPrimitive.contentOrNull }
+                    ?.toSet()
+            }.getOrNull() ?: return@launch
+            _marks.update { it + (videoId to (it[videoId].orEmpty() + remote)) }
+        }
+    }
+
+    /** The player moved to [videoId] + stream: look up the synced subtitles saved for it. */
+    fun setPlayback(videoId: String?, streamKey: String?) {
+        val next = if (videoId.isNullOrBlank() || streamKey == null) null else Playback(videoId, streamKey)
+        if (next == _playback.value) return
+        _playback.value = next
+        _saved.value = null
+        restoredUrls.clear()
+        autoSelected = null
+        userPicked = false
+        next ?: return
+        requestMarks(next.videoId)
+        log("synced subs: playback video=${next.videoId} key=${next.streamKey}")
+        scope.launch {
+            val local = localLoad?.invoke(fileName(next))?.let(::decodeList).orEmpty()
+            log("synced subs: local file rows=${local.size}")
+            if (local.isNotEmpty() && _playback.value == next) merge(next, local, store = false)
+            val remote = runCatching {
+                val result = SupabaseProvider.client.postgrest.rpc(
+                    "synced_subtitles_pull_all",
+                    buildJsonObject {
+                        put("p_video_id", next.videoId)
+                        put("p_stream_key", next.streamKey)
+                    },
+                )
+                decodeList(result.data)
+            }.getOrNull().orEmpty()
+            log("synced subs: keyed pull rows=${remote.size}")
+            if (remote.isNotEmpty() && _playback.value == next) merge(next, remote, store = true)
+        }
+        // Nuvio fork: nothing under THIS device's stream key - other devices (or earlier
+        // sessions with rotated stream URLs) saved under different keys for the same title.
+        // Pull every key known for the video and merge without persisting locally.
+        scope.launch {
+            if (_playback.value != next || !_saved.value?.second.isNullOrEmpty()) return@launch
+            val allKeys = runCatching {
+                val result = SupabaseProvider.client.postgrest.rpc(
+                    "synced_subtitles_list",
+                    buildJsonObject { put("p_video_id", next.videoId) },
+                )
+                json.decodeFromString<List<String>>(result.data)
+            }.getOrNull().orEmpty()
+            for (key in allKeys) {
+                if (_playback.value != next) break
+                val remote = runCatching {
+                    val result = SupabaseProvider.client.postgrest.rpc(
+                        "synced_subtitles_pull_all",
+                        buildJsonObject {
+                            put("p_video_id", next.videoId)
+                            put("p_stream_key", key)
+                        },
+                    )
+                    decodeList(result.data)
+                }.getOrNull().orEmpty()
+                if (remote.isNotEmpty() && _playback.value == next) merge(next, remote, store = false)
+            }
+        }
+    }
+
+    /** Adds [incoming] to the saved subtitles of [playback]; the newer copy of a subtitle wins. */
+    private fun merge(playback: Playback, incoming: List<Saved>, store: Boolean) {
+        var changed = false
+        _saved.update { current ->
+            val map = current?.takeIf { it.first == playback }?.second.orEmpty().toMutableMap()
+            for (saved in incoming) {
+                val existing = map[saved.subtitleUrl]
+                if (existing == null || saved.savedAtMs > existing.savedAtMs) {
+                    map[saved.subtitleUrl] = saved
+                    changed = true
+                }
+            }
+            playback to map
+        }
+        if (store && changed) {
+            _saved.value?.second?.values?.toList()?.let { all ->
+                localSave?.invoke(fileName(playback), json.encodeToString(ListSerializer(Saved.serializer()), all))
+            }
+            addLocalMark(playback)
+        }
+    }
+
+    /**
+     * [subtitles] plus the saved synced subtitles this device's addons don't list (other addon
+     * settings on another device). Added only once the addon subtitles have loaded.
+     */
+    fun withEntry(
+        subtitles: List<AddonSubtitle>,
+        saved: Pair<Playback, Map<String, Saved>>?,
+        loading: Boolean,
+    ): List<AddonSubtitle> {
+        val current = saved?.takeIf { it.first == _playback.value }?.second ?: return subtitles
+        if (loading) return subtitles
+        val missing = current.values.filter { entry -> subtitles.none { it.url == entry.subtitleUrl } }
+        if (missing.isEmpty()) return subtitles
+        return subtitles + missing.mapIndexed { index, entry ->
+            AddonSubtitle(
+                id = "nuvio-synced-subtitle-$index",
+                url = entry.subtitleUrl,
+                language = entry.language,
+                display = entry.name.ifBlank { "Synced subtitle" },
+                addonName = "Synced subtitles",
+            )
+        }
+    }
+
+    /** True once a saved subtitle was selected for [playback]; that happens at most once. */
+    fun claimAutoSelect(playback: Playback): Boolean {
+        if (autoSelected == playback) return false
+        autoSelected = playback
+        return true
+    }
+
+    private var autoSelected: Playback? = null
+
+    /** The user picked a subtitle by hand in this playback; a saved one doesn't replace it. */
+    var userPicked: Boolean = false
+
+    /** The saved synced subtitle for [url] in this playback, if any. */
+    fun savedFor(url: String): Saved? {
+        val (playback, saved) = _saved.value ?: return null
+        if (playback != _playback.value) return null
+        saved[url]?.let { return it }
+        return saved.values.firstOrNull { sameSubtitleFile(it.subtitleUrl, url) }
+    }
+
+    /**
+     * Nuvio fork: the add-on's subtitle URLs rotate between sessions (fresh redirect tokens in
+     * the path), so a saved timing is matched to the current list by the stable file name at
+     * the end of the URL when the exact URL is no longer present.
+     */
+    fun sameSubtitleFile(savedUrl: String, listUrl: String): Boolean {
+        if (savedUrl == listUrl) return true
+        val a = savedUrl.substringBefore('?').substringAfterLast('/')
+        val b = listUrl.substringBefore('?').substringAfterLast('/')
+        return a.isNotEmpty() && a == b
+    }
+
+    /** AutoSync or the audio sync synced [url] to [srt] in this playback: keep it for next time. */
+    fun save(url: String, srt: String, method: String, nowMs: Long) {
+        val playback = _playback.value ?: return
+        if (srt.isBlank() || url in restoredUrls || GeneratedSubtitles.isGenerated(url)) return
+        val subtitle = describeSubtitle(url)
+        val saved = Saved(
+            subtitleUrl = url,
+            language = subtitle?.language.orEmpty(),
+            name = subtitle?.display.orEmpty(),
+            method = method,
+            srt = srt,
+            savedAtMs = nowMs,
+        )
+        merge(playback, listOf(saved), store = true)
+        val encoded = json.encodeToString(Saved.serializer(), saved)
+        scope.launch {
+            runCatching {
+                SupabaseProvider.client.postgrest.rpc(
+                    "synced_subtitles_push_one",
+                    buildJsonObject {
+                        put("p_video_id", playback.videoId)
+                        put("p_stream_key", playback.streamKey)
+                        put("p_subtitle_key", fnv64(url))
+                        put("p_payload", Json.parseToJsonElement(encoded))
+                    },
+                )
+            }
+        }
+    }
+
+    private fun addLocalMark(playback: Playback) {
+        _marks.update { it + (playback.videoId to (it[playback.videoId].orEmpty() + playback.streamKey)) }
+        val name = indexName(playback.videoId)
+        val keys = localLoad?.invoke(name)?.lines()?.filter { it.isNotBlank() }.orEmpty()
+        if (playback.streamKey !in keys) localSave?.invoke(name, (keys + playback.streamKey).joinToString("\n"))
+    }
+
+    /** A JSON list of saved subtitles, or one saved subtitle (files written by older builds). */
+    private fun decodeList(text: String): List<Saved> = runCatching {
+        when (val element = Json.parseToJsonElement(text.trim())) {
+            is JsonArray -> element.mapNotNull { item ->
+                runCatching { json.decodeFromJsonElement(Saved.serializer(), item) }.getOrNull()
+            }
+            is kotlinx.serialization.json.JsonObject -> listOf(json.decodeFromJsonElement(Saved.serializer(), element))
+            else -> emptyList()
+        }
+    }.getOrDefault(emptyList()).filter { it.srt.isNotBlank() && it.subtitleUrl.isNotBlank() }
+
+    private fun fileName(playback: Playback) = "s-" + fnv64(playback.videoId + "\n" + playback.streamKey) + ".json"
+
+    private fun indexName(videoId: String) = "i-" + fnv64(videoId) + ".txt"
+
+    private val VOLATILE_NUMBER = Regex("[0-9]+(?:[.,][0-9]+)?")
+
+    private fun fnv64(text: String): String {
+        var hash = -0x340d631b7bdddcdbL
+        for (byte in text.encodeToByteArray()) {
+            hash = hash xor (byte.toLong() and 0xff)
+            hash *= 0x100000001b3L
+        }
+        return hash.toULong().toString(16).padStart(16, '0')
+    }
+}
+
+/** The video id whose synced streams a stream list marks; null shows no marks. */
+val LocalSyncedSubtitleVideoId = compositionLocalOf<String?> { null }
