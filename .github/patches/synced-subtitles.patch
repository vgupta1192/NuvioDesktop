+package com.nuvio.app.features.player
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.DisposableEffect
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.collectAsState
+import androidx.compose.runtime.getValue
+
+/*
+ * Nuvio fork (Desktop): synced subtitles in the player runtime, as on Nuvio Mobile. Looks up the
+ * subtitles synced before for this title + stream (any device on the Nuvio account) and selects
+ * the latest; the player controller shows it with its saved timing.
+ */
+
+@Composable
+internal fun PlayerScreenRuntime.BindSyncedSubtitleEffects() {
+    SyncedSubtitles.describeSubtitle = { url -> addonSubtitles.firstOrNull { it.url == url } }
+    LaunchedEffect(activeVideoId, activeProviderAddonId, activeStreamTitle, activeStreamSubtitle, activeTorrentInfoHash, activeTorrentFileIdx) {
+        SyncedSubtitles.setPlayback(
+            videoId = activeVideoId,
+            streamKey = SyncedSubtitles.streamKey(
+                addonId = activeProviderAddonId,
+                name = activeStreamTitle,
+                description = activeStreamSubtitle,
+                torrentInfoHash = activeTorrentInfoHash,
+                torrentFileIdx = activeTorrentFileIdx,
+            ),
+        )
+    }
+    DisposableEffect(Unit) {
+        onDispose { SyncedSubtitles.setPlayback(null, null) }
+    }
+    val syncedSubtitle by SyncedSubtitles.saved.collectAsState()
+    LaunchedEffect(playerController, syncedSubtitle, addonSubtitles) {
+        selectSavedSyncedSubtitle(syncedSubtitle)
+    }
+}
+
+/**
+ * Selects a subtitle saved as synced for this title + stream, once per playback: the one already
+ * selected when it is among them, else the latest synced one. A subtitle the user already picked
+ * by hand in this playback is kept.
+ */
+private fun PlayerScreenRuntime.selectSavedSyncedSubtitle(
+    saved: Pair<SyncedSubtitles.Playback, Map<String, SyncedSubtitles.Saved>>?,
+) {
+    val controller = playerController ?: return
+    val (playback, subtitles) = saved ?: return
+    if (playback != SyncedSubtitles.playback.value || subtitles.isEmpty()) return
+    val selected = addonSubtitles.firstOrNull { it.selectionKey == selectedAddonSubtitleId }
+    val target = selected?.takeIf { it.url in subtitles }
+        ?: subtitles.values.sortedByDescending { it.savedAtMs }
+            .firstNotNullOfOrNull { savedSubtitle -> addonSubtitles.firstOrNull { it.url == savedSubtitle.subtitleUrl } }
+        ?: return
+    if (!SyncedSubtitles.claimAutoSelect(playback)) return
+    if (SyncedSubtitles.userPicked && selected?.url != target.url) return
+    if (selected?.url == target.url && target.url in SyncedSubtitles.restoredUrls) return
+    selectedAddonSubtitleId = target.selectionKey
+    selectedSubtitleIndex = -1
+    useCustomSubtitles = true
+    preferredSubtitleSelectionApplied = true
+    isUserExplicitSubtitleSelection = true
+    controller.setSubtitleUri(target.url)
+}
