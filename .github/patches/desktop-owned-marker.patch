index 000000000..10cb39b60
--- /dev/null
+++ b/composeApp/src/commonMain/kotlin/com/nuvio/app/features/details/components/OwnedTitles.kt
@@ -0,0 +1,27 @@
+package com.nuvio.app.features.details.components
+
+import com.nuvio.app.features.home.MetaPreview
+import com.nuvio.app.features.library.LibraryItem
+import com.nuvio.app.features.watchprogress.WatchProgressEntry
+
+/**
+ * Nuvio fork: "In library" / "Watching" labels for the cast filmography, keyed by id and by
+ * folded title (TMDB credits use TMDB ids while library and progress use other id spaces, so
+ * the title is the practical match). Watching wins over In library.
+ */
+internal fun ownedKeys(id: String, title: String): List<String> =
+    listOf(id, title.lowercase().filter { it.isLetterOrDigit() }).filter { it.isNotBlank() }
+
+internal fun buildOwnedLabels(
+    library: List<LibraryItem>,
+    progress: List<WatchProgressEntry>,
+): Map<String, String> {
+    val labels = HashMap<String, String>()
+    library.forEach { entry -> ownedKeys(entry.id, entry.name).forEach { labels[it] = "In library" } }
+    progress.filterNot { it.isEffectivelyCompleted }
+        .forEach { entry -> ownedKeys(entry.parentMetaId, entry.title).forEach { labels[it] = "Watching" } }
+    return labels
+}
+
+internal fun Map<String, String>.ownedLabelFor(item: MetaPreview): String? =
+    ownedKeys(item.id, item.name).firstNotNullOfOrNull { this[it] }
