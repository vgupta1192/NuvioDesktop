@@ -0,0 +1,13 @@
+package com.nuvio.app.features.settings
+
+internal actual object CrashLogPlatform {
+    actual val available: Boolean = true
+    actual fun files(): List<String> = DesktopCrashLogs.files().map { it.name }
+    actual fun read(name: String): String? =
+        DesktopCrashLogs.files().firstOrNull { it.name == name }?.let { file ->
+            runCatching { file.readText() }.getOrNull()
+        }
+    actual fun clear() {
+        DesktopCrashLogs.files().forEach { runCatching { it.delete() } }
+    }
+}
