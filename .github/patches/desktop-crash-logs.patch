+package com.nuvio.app.features.settings
+
+import java.io.File
+import java.io.PrintWriter
+import java.io.StringWriter
+import java.time.Instant
+
+/**
+ * Nuvio fork: crash log capture for the desktop app. An uncaught exception handler writes the
+ * stack trace to <data>/crash-logs/crash-<timestamp>.txt (keeping the newest few) and then
+ * delegates to the previous handler so normal crash reporting still runs.
+ */
+internal object DesktopCrashLogs {
+    private const val KEEP = 5
+
+    fun dir(): File {
+        val base = System.getProperty("compose.application.resources.dir")
+            ?.let { File(it).parentFile }
+            ?: File(System.getProperty("user.home"), ".local/share/nuviojellyfintv")
+        return File(base, "crash-logs")
+    }
+
+    fun files(): List<File> =
+        dir().listFiles { f -> f.name.startsWith("crash-") && f.name.endsWith(".txt") }
+            ?.sortedByDescending { it.name }
+            .orEmpty()
+
+    fun install() {
+        val previous = Thread.getDefaultUncaughtExceptionHandler()
+        Thread.setDefaultUncaughtExceptionHandler { thread, throwable ->
+            runCatching {
+                val d = dir()
+                d.mkdirs()
+                val stamp = Instant.now().toString().replace(":", "-")
+                val out = File(d, "crash-$stamp.txt")
+                val sw = StringWriter()
+                throwable.printStackTrace(PrintWriter(sw))
+                out.writeText(
+                    buildString {
+                        appendLine("time: ${Instant.now()}")
+                        appendLine("thread: ${thread.name}")
+                        appendLine("version: ${System.getProperty("nuvio.version") ?: "unknown"}")
+                        appendLine()
+                        appendLine(sw.toString())
+                    },
+                )
+                // keep only the newest few
+                files().drop(KEEP).forEach { runCatching { it.delete() } }
+            }
+            previous?.uncaughtException(thread, throwable)
+        }
+    }
+}
