+package com.nuvio.app.features.settings
+
+import androidx.compose.foundation.lazy.LazyListScope
+
+/** Nuvio fork: one page gathering every fork feature toggle. */
+internal fun LazyListScope.featuresSettingsContent(isTablet: Boolean) {
+    item {
+        ForkPlayerPrefsSettingsSection(isTablet = isTablet)
+    }
+    item {
+        DxWatchedTitlesSettingsSection(isTablet = isTablet)
+    }
+    item {
+        DxWatchStatsSettingsSection(isTablet = isTablet)
+    }
+    item {
+        DxSoundsSettingsSection(isTablet = isTablet)
+    }
+    item {
+        SettingsSection(title = "Network", isTablet = isTablet) {
+            SettingsGroup(isTablet = isTablet) {
+                DohSettingsRow(isTablet = isTablet)
+            }
+        }
+    }
+}
