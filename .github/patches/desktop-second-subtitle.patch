+    // Nuvio fork: second subtitle line via mpv secondary-sid (top of the picture).
+    private fun applySecondarySubtitle() {
+        val current = handle.takeIf { it != 0L } ?: return
+        runCatching {
+            val prefs = com.nuvio.app.features.settings.ForkPrefs
+            val wanted = prefs.secondSubtitleLang.current().trim()
+                .takeIf { prefs.secondSubtitle.current() && it.isNotBlank() }
+            val desired = if (wanted == null) {
+                "no"
+            } else {
+                val tracks = decodeTracks { NativePlayerBridge.subtitleTracksJson(current) }
+                val primarySid = runCatching { NativePlayerBridge.propGetString(current, "sid") }.getOrNull()
+                val match = tracks.firstOrNull { track ->
+                    track.id != primarySid && track.id.toIntOrNull() != 0 && (
+                        track.language.lowercase().startsWith(wanted.lowercase()) ||
+                            track.label.lowercase().contains(wanted.lowercase())
+                        )
+                }
+                match?.id ?: "no"
+            }
+            val applied = runCatching { NativePlayerBridge.propGetString(current, "secondary-sid") }.getOrNull()
+            if (applied != desired) {
+                NativePlayerBridge.propSetString(current, "secondary-sid", desired)
+            }
+        }
+    }
+
