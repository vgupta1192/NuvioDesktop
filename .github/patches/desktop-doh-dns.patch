+package com.nuvio.app.core.network
+
+import com.nuvio.app.features.settings.ForkPrefs
+
+/** Fork feature: resolve host names through DNS over HTTPS instead of the system resolver. */
+enum class DohProvider(val id: String, val label: String, val description: String, val endpoint: String?) {
+    OFF("off", "System DNS", "Use the DNS your network gives you.", null),
+    CLOUDFLARE("cloudflare", "Cloudflare", "1.1.1.1, fast and private.", "https://1.1.1.1/dns-query"),
+    GOOGLE("google", "Google", "8.8.8.8, works on most networks.", "https://8.8.8.8/resolve"),
+    QUAD9("quad9", "Quad9", "9.9.9.9, blocks malicious domains.", "https://9.9.9.9:5053/dns-query"),
+}
+
+object DohSetting {
+    val provider = kotlinx.coroutines.flow.MutableStateFlow(DohProvider.OFF)
+
+    fun ensureLoaded() {
+        val id = ForkPrefs.dohProvider.current()
+        val resolved = DohProvider.entries.firstOrNull { it.id == id } ?: DohProvider.OFF
+        if (provider.value != resolved) provider.value = resolved
+    }
+
+    fun current(): DohProvider {
+        ensureLoaded()
+        return provider.value
+    }
+
+    fun set(provider: DohProvider) {
+        ForkPrefs.dohProvider.set(provider.id)
+        this.provider.value = provider
+    }
+
+    fun next(provider: DohProvider): DohProvider {
+        val entries = DohProvider.entries
+        return entries[(entries.indexOf(provider) + 1) % entries.size]
+    }
+}
