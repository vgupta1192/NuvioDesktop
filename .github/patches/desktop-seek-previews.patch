+package com.nuvio.app.features.player.seekpreview
+
+import androidx.compose.ui.graphics.ImageBitmap
+import androidx.compose.ui.graphics.toComposeImageBitmap
+import io.ktor.client.HttpClient
+import io.ktor.client.engine.cio.CIO
+import io.ktor.client.plugins.HttpTimeout
+import org.jetbrains.skia.Image
+import java.util.prefs.Preferences
+
+internal actual fun createSeekrHttpClient(): HttpClient = HttpClient(CIO) {
+    expectSuccess = false
+    install(HttpTimeout) {
+        requestTimeoutMillis = 30_000
+        connectTimeoutMillis = 15_000
+        socketTimeoutMillis = 30_000
+    }
+}
+
+// No on-device segment decoder on the desktop JVM (the filler is ExoPlayer-only),
+// so previews come from the Seekr API only.
+internal actual fun openLocalSeekPreviewTrack(cacheKey: String, durationMs: Long): SeekPreviewTrack? = null
+
+internal actual fun decodeSeekrSpriteSheet(bytes: ByteArray): ImageBitmap? =
+    runCatching { Image.makeFromEncoded(bytes).toComposeImageBitmap() }.getOrNull()
+
+/** Wires Seekr key + local-preview persistence into java.util.prefs; called once from main(). */
+internal fun installSeekrDesktopPreferences() {
+    runCatching {
+        val seekr = Preferences.userNodeForPackage(SeekrKeyRepository::class.java)
+        SeekrKeyRepository.installPersistence(
+            load = { seekr.get("seekr_key", null) },
+            save = { seekr.put("seekr_key", it) },
+        )
+        val local = Preferences.userNodeForPackage(LocalSeekPreviewSettings::class.java)
+        LocalSeekPreviewSettings.installPersistence(
+            load = {
+                if (local.get("local_previews", null) != null) {
+                    local.get("local_previews", "true").toBoolean()
+                } else {
+                    null
+                }
+            },
+            save = { local.put("local_previews", it.toString()) },
+        )
+    }
+}
