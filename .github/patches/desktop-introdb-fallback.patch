+package com.nuvio.app.features.player.skip
+
+import com.nuvio.app.features.addons.httpGetText
+import kotlinx.coroutines.CancellationException
+import kotlinx.serialization.SerialName
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+
+@Serializable
+private data class TheIntroDbSegment(
+    @SerialName("start_ms") val startMs: Long? = null,
+    @SerialName("end_ms") val endMs: Long? = null,
+)
+
+@Serializable
+private data class TheIntroDbResponse(
+    val intro: List<TheIntroDbSegment> = emptyList(),
+    val recap: List<TheIntroDbSegment> = emptyList(),
+    val credits: List<TheIntroDbSegment> = emptyList(),
+)
+
+/** Free intro, recap and credits timestamps from api.theintrodb.org (no key needed). Nuvio fork. */
+internal object TheIntroDb {
+    private const val BASE = "https://api.theintrodb.org/v2/media"
+    private val json = Json { ignoreUnknownKeys = true; isLenient = true }
+
+    suspend fun intervals(imdbId: String, season: Int?, episode: Int?): List<SkipInterval> {
+        val url = buildString {
+            append(BASE).append("?imdb_id=").append(imdbId)
+            if (season != null && episode != null) append("&season=").append(season).append("&episode=").append(episode)
+        }
+        return try {
+            val data = json.decodeFromString<TheIntroDbResponse>(httpGetText(url))
+            listOfNotNull(
+                data.intro.firstOrNull().toInterval("intro"),
+                data.recap.firstOrNull().toInterval("recap"),
+                data.credits.firstOrNull().toInterval("outro"),
+            )
+        } catch (cancelled: CancellationException) {
+            throw cancelled
+        } catch (_: Exception) {
+            emptyList()
+        }
+    }
+
+    private fun TheIntroDbSegment?.toInterval(type: String): SkipInterval? {
+        if (this == null) return null
+        val start = startMs ?: 0L
+        val end = endMs ?: return null
+        if (end <= start) return null
+        return SkipInterval(startTime = start / 1000.0, endTime = end / 1000.0, type = type, provider = "theintrodb")
+    }
+}
