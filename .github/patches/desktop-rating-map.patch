+import com.nuvio.app.features.details.MetaVideo
+import java.util.Locale
+
+/** Nuvio fork: season by episode rating grid, colored by score tier. */
+@Composable
+internal fun DetailRatingMapDialog(
+    groupedEpisodes: Map<Int, List<MetaVideo>>,
+    episodeRatings: Map<Pair<Int, Int>, Double>,
+    onDismiss: () -> Unit,
+) {
+    val seasons = groupedEpisodes.keys.filter { it > 0 }.sorted()
+    Column(
+        modifier = Modifier
+            .widthIn(min = 420.dp)
+            .padding(vertical = 8.dp),
+    ) {
+        Text(
+            text = "Green is 8 and up, yellow 7 to 8, orange 6 to 7, red below 6.",
+            style = MaterialTheme.typography.bodySmall,
+            color = MaterialTheme.colorScheme.onSurfaceVariant,
+        )
+        Column(
+            modifier = Modifier
+                .heightIn(max = 420.dp)
+                .verticalScroll(rememberScrollState())
+                .padding(top = 12.dp),
+            verticalArrangement = Arrangement.spacedBy(12.dp),
+        ) {
+            seasons.forEach { season ->
+                val videos = groupedEpisodes[season].orEmpty().filter { it.episode != null }.sortedBy { it.episode }
+                if (videos.isEmpty()) return@forEach
+                val scores = videos.map { v ->
+                    v.episode!! to (episodeRatings[season to v.episode!!] ?: v.rating)?.takeIf { it > 0.0 }
+                }
+                val rated = scores.mapNotNull { it.second }
+                val average = if (rated.isEmpty()) "-" else String.format(Locale.US, "%.1f", rated.average())
+                Text(
+                    text = "Season $season, average $average",
+                    style = MaterialTheme.typography.titleSmall,
+                    fontWeight = FontWeight.SemiBold,
+                )
+                Row(
+                    modifier = Modifier.horizontalScroll(rememberScrollState()),
+                    horizontalArrangement = Arrangement.spacedBy(4.dp),
+                ) {
+                    scores.forEach { (ep, score) ->
+                        Box(
+                            modifier = Modifier
+                                .size(width = 46.dp, height = 40.dp)
+                                .clip(RoundedCornerShape(6.dp))
+                                .background(ratingTierColor(score)),
+                            contentAlignment = Alignment.Center,
+                        ) {
+                            Column(horizontalAlignment = Alignment.CenterHorizontally) {
+                                Text(text = "E$ep", color = Color.Black.copy(alpha = 0.6f), fontSize = 9.sp)
+                                Text(
+                                    text = score?.let { String.format(Locale.US, "%.1f", it) } ?: "-",
+                                    color = Color.Black,
+                                    fontSize = 12.sp,
+                                    fontWeight = FontWeight.Bold,
+                                )
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        TextButton(onClick = onDismiss, modifier = Modifier.align(Alignment.End)) {
+            Text("Close")
+        }
+    }
+}
+
+private fun ratingTierColor(score: Double?): Color = when {
+    score == null -> Color(0xFF555555)
+    score >= 9.0 -> Color(0xFF3DB46D)
+    score >= 8.0 -> Color(0xFF7ACB8F)
+    score >= 7.0 -> Color(0xFFF2C94C)
+    score >= 6.0 -> Color(0xFFF2994A)
+    else -> Color(0xFFEB5757)
+}
