+package com.nuvio.app.features.autosync
+
+/**
+ * Stream URLs opened as Live TV channels. A live channel has no embedded subtitle index, and a
+ * second connection for one can take the provider's only slot, so AutoSync skips prefetching it.
+ * (Replaces NuvioMobile-Reshaped's LiveTvPlaybackRegistry for this fork's Live TV feature.)
+ */
+object AutoSyncLiveSources {
+    private const val MAX_TRACKED = 64
+    private val urls = ArrayDeque<String>()
+
+    fun mark(url: String) {
+        if (url.isBlank()) return
+        urls.remove(url)
+        urls.addLast(url)
+        while (urls.size > MAX_TRACKED) urls.removeFirst()
+    }
+
+    fun isLive(url: String): Boolean = url in urls
+}
