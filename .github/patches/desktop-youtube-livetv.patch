@@ -0,0 +1,97 @@
+package com.nuvio.app.features.player
+
+import com.nuvio.app.features.streams.YouTubeStreamResolver
+import java.net.HttpURLConnection
+import java.net.URI
+
+/**
+ * Reports how a YouTube stream behaves on Desktop to the diagnostics receiver (same endpoint and
+ * kinds as the Mobile youtube-diag patch): the HLS master it resolved to, how long the first
+ * frame took, and a "stall" if nothing played within [StallAfterMs]. Only googlevideo media is
+ * reported, nothing else leaves the app.
+ */
+internal object DesktopYouTubeDiag {
+    private const val Endpoint = "https://nuviodiag.kissmissi.duckdns.org/d/yt"
+    private const val StallAfterMs = 15_000L
+
+    @Volatile private var url: String = ""
+    @Volatile private var startedAt = 0L
+    @Volatile private var resolved = false
+    @Volatile private var stallSent = false
+
+    fun begin(mediaUrl: String) {
+        if (!YouTubeStreamResolver.isYouTubeMedia(mediaUrl)) {
+            url = ""
+            return
+        }
+        url = mediaUrl
+        startedAt = System.currentTimeMillis()
+        resolved = false
+        stallSent = false
+        val snapshotUrl = mediaUrl
+        post("prepare", snapshotUrl) { probe(snapshotUrl) }
+    }
+
+    fun onSnapshot(snapshot: PlayerPlaybackSnapshot) {
+        val current = url
+        if (current.isEmpty() || resolved) return
+        val elapsed = System.currentTimeMillis() - startedAt
+        if (snapshot.positionMs > 0L && snapshot.videoWidth > 0) {
+            resolved = true
+            post("ready", current) {
+                "\"firstFrameMs\":$elapsed,\"width\":${snapshot.videoWidth},\"height\":${snapshot.videoHeight}"
+            }
+        } else if (elapsed > StallAfterMs && !stallSent) {
+            stallSent = true
+            post("stall", current) { "\"afterMs\":$elapsed,\"buffered\":${snapshot.bufferedPositionMs}" }
+        }
+    }
+
+    fun onError(message: String?) {
+        val current = url
+        if (current.isEmpty()) return
+        post("error", current) { "\"message\":${(message ?: "").take(300).toJsonString()}" }
+    }
+
+    private fun probe(mediaUrl: String): String {
+        val started = System.currentTimeMillis()
+        return runCatching {
+            val connection = URI(mediaUrl).toURL().openConnection() as HttpURLConnection
+            connection.connectTimeout = 8_000
+            connection.readTimeout = 8_000
+            val body = connection.inputStream.use { it.readNBytes(256 * 1024) }.decodeToString()
+            val variants = body.lineSequence().count { it.startsWith("#EXT-X-STREAM-INF") }
+            "\"manifestMs\":${System.currentTimeMillis() - started},\"variants\":$variants,\"status\":${connection.responseCode}"
+        }.getOrElse { "\"probeError\":${(it.message ?: it::class.simpleName.orEmpty()).take(200).toJsonString()}" }
+    }
+
+    private fun post(kind: String, mediaUrl: String, details: () -> String) {
+        Thread({
+            runCatching {
+                val extra = details()
+                val host = runCatching { URI(mediaUrl).host }.getOrNull().orEmpty()
+                val body = "{\"kind\":\"$kind\",\"platform\":\"desktop\",\"host\":${host.toJsonString()},$extra}"
+                val connection = URI(Endpoint).toURL().openConnection() as HttpURLConnection
+                connection.requestMethod = "POST"
+                connection.connectTimeout = 8_000
+                connection.readTimeout = 8_000
+                connection.doOutput = true
+                connection.setRequestProperty("Content-Type", "application/json")
+                connection.outputStream.use { it.write(body.toByteArray()) }
+                connection.responseCode
+            }
+        }, "youtube-diag").apply { isDaemon = true }.start()
+    }
+
+    private fun String.toJsonString(): String =
+        buildString {
+            append('"')
+            for (c in this@toJsonString) when {
+                c == '"' -> append("\\\"")
+                c == '\\' -> append("\\\\")
+                c < ' ' -> append(' ')
+                else -> append(c)
+            }
+            append('"')
+        }
+}
