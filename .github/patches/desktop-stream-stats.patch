+                updateControls(controlsState)
+            }
+        }
+    }
+
+    private fun startPlaybackStatsPoller() {
+        val poller = java.util.concurrent.Executors.newSingleThreadScheduledExecutor { r ->
+            Thread(r, "nuvio-playback-stats").apply { isDaemon = true }
+        }
+        poller.scheduleWithFixedDelay({
+            try {
+                val current = handle
+                if (current == 0L) return@scheduleWithFixedDelay
+                val paused = runCatching { NativePlayerBridge.propGetString(current, "paused") }.getOrNull()
+                if (paused == "true") return@scheduleWithFixedDelay
+                refreshPlaybackStats()
+            } catch (_: Throwable) {
+            }
+        }, 2, 2, java.util.concurrent.TimeUnit.SECONDS)
+    }
