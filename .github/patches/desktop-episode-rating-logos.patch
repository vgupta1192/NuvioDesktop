+
+/**
+ * Nuvio fork: per-source episode ratings ("Simkl", "Trakt") keyed by (season, episode), shown
+ * as small logo badges on episode cards next to the IMDb rating.
+ */
+object ExtraEpisodeRatings {
+    private val log = Logger.withTag("ExtraEpisodeRatings")
+    private val json = Json { ignoreUnknownKeys = true; isLenient = true }
+    private val cache = HashMap<String, Map<String, Map<Pair<Int, Int>, Double>>>()
+
+    suspend fun fetch(imdbId: String): Map<String, Map<Pair<Int, Int>, Double>> {
+        cache[imdbId]?.let { return it }
+        val simkl = fetchSimkl(imdbId)
+        val trakt = fetchTrakt(imdbId)
+        val out = buildMap {
+            if (simkl.isNotEmpty()) put("Simkl", simkl)
+            if (trakt.isNotEmpty()) put("Trakt", trakt)
+        }
+        if (out.isNotEmpty()) cache[imdbId] = out
+        return out
+    }
+
+    private suspend fun fetchSimkl(imdbId: String): Map<Pair<Int, Int>, Double> = withContext(Dispatchers.Default) {
+        if (SimklConfig.CLIENT_ID.isBlank()) return@withContext emptyMap()
+        try {
+            val ids = SimklIdResolver.resolveIds("imdb", imdbId, "series") ?: return@withContext emptyMap()
+            val url = "https://api.simkl.com/${ids.type}/episodes/${ids.simklId}?extended=full" +
+                "&client_id=${SimklConfig.CLIENT_ID}&app-name=nuvio&app-version=1.0"
+            val body = httpGetText(url)
+            val arr = json.parseToJsonElement(body).jsonArray
+            val out = HashMap<Pair<Int, Int>, Double>()
+            for (element in arr) {
+                val ep = element as? JsonObject ?: continue
+                if ((ep["type"]?.jsonPrimitive?.content ?: "episode") != "episode") continue
+                val s = ep["season"]?.jsonPrimitive?.intOrNull ?: continue
+                val e = ep["episode"]?.jsonPrimitive?.intOrNull ?: continue
+                if (s < 0 || e < 0) continue
+                val rating = ((ep["ratings"] as? JsonObject)?.get("simkl" ) as? JsonObject)
+                    ?.get("rating")?.jsonPrimitive?.doubleOrNull
+                    ?: ep["rating"]?.jsonPrimitive?.doubleOrNull
+                if (rating != null && rating > 0.0) out[s to e] = rating
+            }
+            out
+        } catch (cancelled: kotlinx.coroutines.CancellationException) {
+            throw cancelled
+        } catch (e: Exception) {
+            log.w { "Simkl episode ratings failed for $imdbId: ${e.message}" }
+            emptyMap()
+        }
+    }
+
+    private suspend fun fetchTrakt(imdbId: String): Map<Pair<Int, Int>, Double> = withContext(Dispatchers.Default) {
+        if (TraktConfig.CLIENT_ID.isBlank()) return@withContext emptyMap()
+        try {
+            val body = httpGetTextWithHeaders(
+                "https://api.trakt.tv/shows/$imdbId/seasons?extended=episodes,full",
+                mapOf("trakt-api-key" to TraktConfig.CLIENT_ID, "trakt-api-version" to "2"),
+            )
+            val seasons = json.parseToJsonElement(body).jsonArray
+            val out = HashMap<Pair<Int, Int>, Double>()
+            for (seasonElement in seasons) {
+                val season = seasonElement as? JsonObject ?: continue
+                val s = season["number"]?.jsonPrimitive?.intOrNull ?: continue
+                val eps = season["episodes"] as? kotlinx.serialization.json.JsonArray ?: continue
+                for (epElement in eps) {
+                    val ep = epElement as? JsonObject ?: continue
+                    val e = ep["number"]?.jsonPrimitive?.intOrNull ?: continue
+                    val rating = ep["rating"]?.jsonPrimitive?.doubleOrNull ?: continue
+                    if (rating > 0.0) out[s to e] = rating
+                }
+            }
+            out
+        } catch (cancelled: kotlinx.coroutines.CancellationException) {
+            throw cancelled
+        } catch (e: Exception) {
+            log.w { "Trakt episode ratings failed for $imdbId: ${e.message}" }
+            emptyMap()
+        }
+    }
+}
