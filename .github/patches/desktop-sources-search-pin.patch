+    private const val PINNED_SOURCES_KEY = "sources/pinned"
+
+    /** Stream sources (addon ids) pinned to the top of the sources panel. */
+    fun pinnedSources(): Set<String> =
+        readRaw(PINNED_SOURCES_KEY)?.split("\n")?.filter { it.isNotBlank() }?.toSet() ?: emptySet()
+
+    fun togglePinnedSource(id: String) {
+        val current = pinnedSources()
+        val next = if (id in current) current - id else current + id
+        writeRaw(PINNED_SOURCES_KEY, next.joinToString("\n"))
+    }
+
     /** Raw string storage for larger fork payloads (stats JSON etc.). */
     fun readRaw(key: String): String? = storage?.getString(key)
 
