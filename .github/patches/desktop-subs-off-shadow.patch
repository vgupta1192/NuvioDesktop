@@ -0,0 +1,31 @@
+package com.nuvio.app.features.settings
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+
+/** Nuvio fork: subtitle appearance and startup behaviour toggles (desktop store backed). */
+@Composable
+internal fun ForkPlayerPrefsSettingsSection(isTablet: Boolean) {
+    val shadow by ForkPrefs.subtitleShadow.value.collectAsStateWithLifecycle()
+    val subsOff by ForkPrefs.subtitlesStartOff.value.collectAsStateWithLifecycle()
+    SettingsSection(title = "Subtitles", isTablet = isTablet) {
+        SettingsGroup(isTablet = isTablet) {
+            SettingsSwitchRow(
+                title = "Subtitle shadow",
+                description = "Draw a soft drop shadow behind subtitle text. Applies to the next video.",
+                checked = shadow,
+                isTablet = isTablet,
+                onCheckedChange = ForkPrefs.subtitleShadow::set,
+            )
+            SettingsGroupDivider(isTablet = isTablet)
+            SettingsSwitchRow(
+                title = "Subtitles start off",
+                description = "Never turn subtitles on by themselves. You can still pick a track in the player.",
+                checked = subsOff,
+                isTablet = isTablet,
+                onCheckedChange = ForkPrefs.subtitlesStartOff::set,
+            )
+        }
+    }
+}
