+
+/**
+ * Fork feature: Settings > Live TV. Add, enable, reload and remove the IPTV sources (M3U,
+ * Xtream Codes, Stalker portal) that also show up in the Live TV screen.
+ */
+internal fun LazyListScope.liveTvSettingsContent(isTablet: Boolean) {
+    item {
+        val state by remember {
+            LiveTvRepository.initialize()
+            LiveTvRepository.uiState
+        }.collectAsStateWithLifecycle()
+        var showAddDialog by remember { mutableStateOf(false) }
+        val tokens = MaterialTheme.nuvio
+
+        SettingsSection(title = "IPTV sources", isTablet = isTablet) {
+            SettingsGroup(isTablet = isTablet) {
+                if (state.iptvSources.isEmpty()) {
+                    Text(
+                        text = "No IPTV sources yet. Add an M3U playlist, an Xtream Codes login or a Stalker portal.",
+                        style = MaterialTheme.typography.bodyMedium,
+                        color = tokens.colors.textMuted,
+                        modifier = Modifier.padding(horizontal = 16.dp, vertical = 14.dp),
+                    )
+                }
+                state.iptvSources.forEachIndexed { index, source ->
+                    if (index > 0) SettingsGroupDivider(isTablet = isTablet)
+                    val channelCount = state.allChannels.count { it.iptvSourceId == source.id }
+                    SettingsNavigationRow(
+                        title = source.name,
+                        description = sourceStatus(
+                            source = source,
+                            error = state.iptvErrors[source.id],
+                            channelCount = channelCount,
+                            loading = state.isLoadingIptv,
+                        ),
+                        icon = Icons.Rounded.LiveTv,
+                        isTablet = isTablet,
+                        onClick = { LiveTvRepository.toggleIptvSource(source.id) },
+                        trailingContent = {
+                            Switch(
+                                checked = source.isEnabled,
+                                onCheckedChange = { LiveTvRepository.toggleIptvSource(source.id) },
+                                colors = SwitchDefaults.colors(
+                                    checkedThumbColor = tokens.colors.onAccent,
+                                    checkedTrackColor = tokens.colors.accent,
+                                    uncheckedThumbColor = tokens.colors.textMuted,
+                                    uncheckedTrackColor = tokens.colors.borderDefault,
+                                ),
+                            )
+                            IconButton(onClick = { LiveTvRepository.removeIptvSource(source.id) }) {
+                                Icon(
+                                    imageVector = Icons.Rounded.Delete,
+                                    contentDescription = "Remove source",
+                                    tint = tokens.colors.textMuted,
+                                    modifier = Modifier.size(20.dp),
+                                )
+                            }
+                        },
+                    )
+                }
+            }
+        }
+
+        Spacer(modifier = Modifier.height(NuvioTokens.Space.s16))
+        SettingsSection(title = "Manage", isTablet = isTablet) {
+            SettingsGroup(isTablet = isTablet) {
+                SettingsNavigationRow(
+                    title = "Add IPTV source",
+                    description = "M3U playlist, Xtream Codes or Stalker portal",
+                    icon = Icons.Rounded.Add,
+                    isTablet = isTablet,
+                    onClick = { showAddDialog = true },
+                )
+                SettingsGroupDivider(isTablet = isTablet)
+                SettingsNavigationRow(
+                    title = "Reload sources",
+                    description = "Download the channel lists and guides again",
+                    icon = Icons.Rounded.Refresh,
+                    enabled = state.iptvSources.any { it.isEnabled },
+                    isTablet = isTablet,
+                    onClick = { LiveTvRepository.reloadIptvSources() },
+                )
+            }
+        }
+
+        if (showAddDialog) {
+            IptvSourceDialog(
+                onDismiss = { showAddDialog = false },
+                onAdd = { source ->
+                    LiveTvRepository.addIptvSource(source)
+                    showAddDialog = false
+                },
+            )
+        }
+    }
+}
+
+private fun sourceStatus(source: IptvSource, error: String?, channelCount: Int, loading: Boolean): String =
+    listOfNotNull(
+        source.kindLabel,
+        when {
+            !source.isEnabled -> "Off"
+            error != null -> error
+            loading && channelCount == 0 -> "Loading..."
+            else -> "$channelCount channels"
+        },
+    ).joinToString(" · ")
