+/** Nuvio fork: Live TV channel list kept on disk so the screen is full the moment it opens. */
+internal object ForkLiveTvChannelCache {
+    private const val KEY = "channels_cache_v1"
+    private val json = Json { ignoreUnknownKeys = true; encodeDefaults = true }
+
+    @Serializable
+    private data class Row(
+        val id: String,
+        val type: String,
+        val name: String,
+        val poster: String? = null,
+        val logo: String? = null,
+        val genres: List<String> = emptyList(),
+        val description: String? = null,
+        val addonName: String,
+        val manifestUrl: String,
+        val addonLogo: String? = null,
+        val catalogId: String,
+        val catalogName: String,
+    )
+
+    fun load(): List<LiveTvChannel> {
+        val raw = LiveTvStorage.loadString(KEY)?.takeIf { it.isNotBlank() } ?: return emptyList()
+        return runCatching {
+            json.decodeFromString<List<Row>>(raw).map {
+                LiveTvChannel(
+                    id = it.id, type = it.type, name = it.name, poster = it.poster, logo = it.logo,
+                    genres = it.genres, description = it.description, addonName = it.addonName,
+                    manifestUrl = it.manifestUrl, addonLogo = it.addonLogo,
+                    catalogId = it.catalogId, catalogName = it.catalogName,
+                )
+            }
+        }.getOrDefault(emptyList())
+    }
+
+    fun save(channels: List<LiveTvChannel>) {
+        if (channels.isEmpty()) return
+        runCatching {
+            val rows = channels.map {
+                Row(
+                    id = it.id, type = it.type, name = it.name, poster = it.poster, logo = it.logo,
+                    genres = it.genres, description = it.description?.take(160), addonName = it.addonName,
+                    manifestUrl = it.manifestUrl, addonLogo = it.addonLogo,
+                    catalogId = it.catalogId, catalogName = it.catalogName,
+                )
+            }
+            LiveTvStorage.saveString(KEY, json.encodeToString(rows))
+        }
+    }
+}
+
+data class LiveReminder(
+    val channelKey: String,
+    val channelName: String,
+    val programTitle: String,
+    val startEpochMs: Long,
+    val fireAtEpochMs: Long,
+)
+
+data class LiveReminderState(
+    val reminders: List<LiveReminder> = emptyList(),
+    /** Reminders whose time has come; the screen shows them until dismissed. */
+    val due: List<LiveReminder> = emptyList(),
+)
+
+/** Nuvio fork: "Remind me" for upcoming guide programmes. Stored on disk, checked every 20 s. */
+object ForkLiveReminders {
+    private const val KEY = "live_reminders"
+    val LEAD_MINUTES = 5
+
+    private val scope = CoroutineScope(SupervisorJob() + Dispatchers.Default)
+    private val _state = MutableStateFlow(LiveReminderState())
+    val state: StateFlow<LiveReminderState> = _state.asStateFlow()
+    private var started = false
+
+    fun ensureStarted() {
+        if (started) return
+        started = true
+        _state.update { it.copy(reminders = load()) }
+        scope.launch {
+            while (true) {
+                tick()
+                delay(20_000)
+            }
+        }
+    }
+
+    fun isReminded(channel: LiveTvChannel, program: EpgProgram): Boolean =
+        _state.value.reminders.any { it.channelKey == channel.stableKey() && it.startEpochMs == program.startEpochMs }
+
+    fun toggle(channel: LiveTvChannel, program: EpgProgram) {
+        val now = LiveTvEpgRepository.nowEpochMs()
+        val current = _state.value.reminders
+        val key = channel.stableKey()
+        val existing = current.firstOrNull { it.channelKey == key && it.startEpochMs == program.startEpochMs }
+        val updated = if (existing != null) {
+            current - existing
+        } else {
+            current + LiveReminder(
+                channelKey = key,
+                channelName = channel.name,
+                programTitle = program.title,
+                startEpochMs = program.startEpochMs,
+                fireAtEpochMs = (program.startEpochMs - LEAD_MINUTES * 60_000L).coerceAtLeast(now + 3_000L),
+            )
+        }
+        save(updated)
+        _state.update { it.copy(reminders = updated) }
+    }
+
+    fun dismiss(reminder: LiveReminder) {
+        _state.update { it.copy(due = it.due - reminder) }
+    }
+
+    private fun tick() {
+        val now = LiveTvEpgRepository.nowEpochMs()
+        val current = _state.value.reminders
+        val fired = current.filter { it.fireAtEpochMs <= now }
+        if (fired.isEmpty()) return
+        val remaining = current - fired.toSet()
+        save(remaining)
+        _state.update { it.copy(reminders = remaining, due = (it.due + fired).distinct()) }
+    }
+
+    private fun clean(text: String) = text.replace('\t', ' ').replace('\n', ' ')
+
+    private fun save(list: List<LiveReminder>) {
+        LiveTvStorage.saveString(
+            KEY,
+            list.joinToString("\n") {
+                listOf(clean(it.channelKey), clean(it.channelName), clean(it.programTitle), it.startEpochMs, it.fireAtEpochMs).joinToString("\t")
+            },
+        )
+    }
+
+    private fun load(): List<LiveReminder> =
+        LiveTvStorage.loadString(KEY)?.lineSequence()?.mapNotNull { line ->
+            val p = line.split('\t')
+            if (p.size != 5) return@mapNotNull null
+            val start = p[3].toLongOrNull() ?: return@mapNotNull null
+            val fire = p[4].toLongOrNull() ?: return@mapNotNull null
+            LiveReminder(p[0], p[1], p[2], start, fire)
+        }?.toList().orEmpty()
+}
