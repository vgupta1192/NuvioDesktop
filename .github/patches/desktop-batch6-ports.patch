+
+/*
+ * Nuvio fork: episode navigator tools (sort order and "go to episode"), ported from NuvioTV and
+ * NuvioMobile. They change only what the episode row shows, never the watched state.
+ */
+
+internal enum class EpisodeSortOrder(val label: String) {
+    FirstToLast("First to last"),
+    LastToFirst("Last to first"),
+    HighestRated("Highest rated"),
+    NewestAired("Newest aired"),
+    UnwatchedFirst("Unwatched first"),
+}
+
+internal fun List<MetaVideo>.sortedForNavigator(
+    order: EpisodeSortOrder,
+    isWatched: (MetaVideo) -> Boolean,
+    ratingOf: (MetaVideo) -> Double?,
+): List<MetaVideo> = when (order) {
+    EpisodeSortOrder.FirstToLast -> this
+    EpisodeSortOrder.LastToFirst -> asReversed()
+    EpisodeSortOrder.HighestRated -> sortedByDescending { ratingOf(it) ?: -1.0 }
+    EpisodeSortOrder.NewestAired -> sortedByDescending { it.released.orEmpty() }
+    EpisodeSortOrder.UnwatchedFirst -> sortedBy { isWatched(it) }
+}
+
+@Composable
+internal fun ForkEpisodeNavigatorBar(
+    episodes: List<MetaVideo>,
+    sortOrder: EpisodeSortOrder,
+    onSortChange: (EpisodeSortOrder) -> Unit,
+    onGoTo: (MetaVideo) -> Unit,
+    modifier: Modifier = Modifier,
+) {
+    var menuOpen by remember { mutableStateOf(false) }
+    var goToOpen by remember { mutableStateOf(false) }
+    Row(
+        modifier = modifier,
+        horizontalArrangement = Arrangement.spacedBy(16.dp),
+        verticalAlignment = Alignment.CenterVertically,
+    ) {
+        Box {
+            Text(
+                text = "Sort: ${sortOrder.label}",
+                style = MaterialTheme.typography.labelLarge,
+                color = MaterialTheme.colorScheme.primary,
+                modifier = Modifier.clickable { menuOpen = true },
+            )
+            DropdownMenu(expanded = menuOpen, onDismissRequest = { menuOpen = false }) {
+                EpisodeSortOrder.entries.forEach { order ->
+                    DropdownMenuItem(
+                        text = { Text(order.label) },
+                        onClick = {
+                            menuOpen = false
+                            onSortChange(order)
+                        },
+                    )
+                }
+            }
+        }
+        if (episodes.size > 1) {
+            Text(
+                text = "Go to episode",
+                style = MaterialTheme.typography.labelLarge,
+                color = MaterialTheme.colorScheme.primary,
+                modifier = Modifier.clickable { goToOpen = true },
+            )
+        }
+    }
+    if (goToOpen) {
+        val ordered = remember(episodes) { episodes.sortedBy { it.episode ?: Int.MAX_VALUE } }
+        var hovered by remember { mutableStateOf<String?>(null) }
+        Dialog(onDismissRequest = { goToOpen = false }) {
+            Surface(shape = RoundedCornerShape(16.dp), color = MaterialTheme.colorScheme.surface) {
+                Column(modifier = Modifier.padding(16.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
+                    Text("Go to episode", style = MaterialTheme.typography.titleMedium)
+                    Text(
+                        text = hovered.orEmpty(),
+                        style = MaterialTheme.typography.bodySmall,
+                        color = MaterialTheme.colorScheme.onSurfaceVariant,
+                        maxLines = 1,
+                    )
+                    LazyVerticalGrid(
+                        columns = GridCells.Adaptive(52.dp),
+                        horizontalArrangement = Arrangement.spacedBy(8.dp),
+                        verticalArrangement = Arrangement.spacedBy(8.dp),
+                        modifier = Modifier.heightIn(max = 340.dp).fillMaxWidth(),
+                    ) {
+                        items(ordered, key = { it.id }) { video ->
+                            Text(
+                                text = (video.episode ?: 0).toString(),
+                                textAlign = TextAlign.Center,
+                                style = MaterialTheme.typography.labelLarge,
+                                modifier = Modifier
+                                    .clip(RoundedCornerShape(8.dp))
+                                    .clickable {
+                                        goToOpen = false
+                                        onGoTo(video)
+                                    }
+                                    .padding(vertical = 10.dp),
+                            )
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
