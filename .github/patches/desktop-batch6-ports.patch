+package com.nuvio.app.features.home
+
+import com.nuvio.app.features.catalog.CatalogTarget
+import com.nuvio.app.features.settings.ForkPrefs
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+
+/** Nuvio fork: disk cache for addon home rows so Home paints instantly on launch. */
+internal object ForkHomeCache {
+    private const val KEY = "cache/home_rows_v1"
+    private const val MAX_ITEMS = 30
+    private val json = Json { ignoreUnknownKeys = true; encodeDefaults = true }
+
+    @Serializable
+    private data class Item(
+        val id: String, val type: String, val name: String,
+        val poster: String? = null, val banner: String? = null, val logo: String? = null,
+        val shape: String? = null, val description: String? = null,
+        val releaseInfo: String? = null, val imdbRating: String? = null,
+        val genres: List<String> = emptyList(), val landscape: String? = null,
+        val runtime: String? = null,
+    )
+
+    @Serializable
+    private data class Row(
+        val cacheKey: String, val key: String, val title: String, val subtitle: String,
+        val addonName: String, val manifestUrl: String, val contentType: String,
+        val catalogId: String, val genre: String? = null, val pagination: Boolean = false,
+        val total: Int = 0, val hasMore: Boolean = false, val items: List<Item> = emptyList(),
+    )
+
+    @Serializable
+    private data class Blob(val rows: List<Row> = emptyList())
+
+    fun save(sections: Map<String, HomeCatalogSection>) {
+        runCatching {
+            val rows = sections.mapNotNull { (cacheKey, s) ->
+                val t = s.target as? CatalogTarget.Addon ?: return@mapNotNull null
+                if (s.items.isEmpty()) return@mapNotNull null
+                Row(
+                    cacheKey, s.key, s.title, s.subtitle, s.addonName, t.manifestUrl,
+                    t.contentType, t.catalogId, t.genre, t.supportsPagination,
+                    s.availableItemCount, s.hasMore,
+                    s.items.take(if (ForkPrefs.lowRam.value.value) 12 else MAX_ITEMS).map {
+                        Item(
+                            it.id, it.type, it.name, it.poster, it.banner, it.logo,
+                            it.posterShape.name, it.description, it.releaseInfo, it.imdbRating,
+                            it.genres, it.landscapePoster, it.runtime,
+                        )
+                    },
+                )
+            }
+            if (rows.isNotEmpty()) ForkPrefs.writeRaw(KEY, json.encodeToString(Blob(rows)))
+        }
+    }
+
+    fun load(allowedKeys: Set<String>): Map<String, HomeCatalogSection> = runCatching {
+        val raw = ForkPrefs.readRaw(KEY) ?: return emptyMap()
+        val out = linkedMapOf<String, HomeCatalogSection>()
+        json.decodeFromString<Blob>(raw).rows.forEach { r ->
+            if (r.cacheKey !in allowedKeys) return@forEach
+            out[r.cacheKey] = HomeCatalogSection(
+                key = r.key, title = r.title, subtitle = r.subtitle, addonName = r.addonName,
+                target = CatalogTarget.Addon(r.manifestUrl, r.contentType, r.catalogId, r.genre, r.pagination),
+                items = r.items.map {
+                    MetaPreview(
+                        id = it.id, type = it.type, name = it.name, poster = it.poster,
+                        banner = it.banner, logo = it.logo,
+                        posterShape = runCatching { PosterShape.valueOf(it.shape ?: "Poster") }
+                            .getOrDefault(PosterShape.Poster),
+                        description = it.description, releaseInfo = it.releaseInfo,
+                        imdbRating = it.imdbRating, genres = it.genres,
+                        landscapePoster = it.landscape, runtime = it.runtime,
+                    )
+                },
+                availableItemCount = r.total, hasMore = r.hasMore,
+            )
+        }
+        out
+    }.getOrDefault(emptyMap())
+}
