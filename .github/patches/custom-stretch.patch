+// Custom Stretch needs mpv_command_ret; resolved on first use so an older libmpv still loads.
+using mpv_command_ret_fn = int (*)(mpv_handle *, const char **, mpv_node *);
+using mpv_free_node_contents_fn = void (*)(mpv_node *);
+
+bool resolveScreenshotApi(mpv_command_ret_fn &commandRet, mpv_free_node_contents_fn &freeNode) {
+    static std::once_flag once;
+    static mpv_command_ret_fn resolvedCommandRet = nullptr;
+    static mpv_free_node_contents_fn resolvedFreeNode = nullptr;
+    std::call_once(once, []() {
+        HMODULE library = mpvApi().library;
+        if (!library) return;
+        resolvedCommandRet = reinterpret_cast<mpv_command_ret_fn>(GetProcAddress(library, "mpv_command_ret"));
+        resolvedFreeNode = reinterpret_cast<mpv_free_node_contents_fn>(GetProcAddress(library, "mpv_free_node_contents"));
+    });
+    commandRet = resolvedCommandRet;
+    freeNode = resolvedFreeNode;
+    return commandRet && freeNode;
+}
