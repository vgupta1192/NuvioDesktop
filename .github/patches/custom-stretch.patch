+    std::string crop = nuvioVideoCrop(width, height, left, top, right, bottom);
+    mpv_set_property_string(p->mpv, "video-crop", crop.c_str());
+    return JNI_TRUE;
+}
+
+JNIEXPORT jbyteArray JNICALL NP(sampleVideoLuma)(JNIEnv *env, jobject, jlong handle, jint maxDimension) {
+    Player *p = asPlayer(handle);
+    if (!p || !p->mpv) return nullptr;
+    int64_t sourceWidth = nuvioInt64Property(p->mpv, "video-params/w");
+    int64_t sourceHeight = nuvioInt64Property(p->mpv, "video-params/h");
+    const char *args[] = {"screenshot-raw", "video", nullptr};
+    mpv_node result;
+    if (mpv_command_ret(p->mpv, args, &result) < 0) return nullptr;
+    std::vector<uint8_t> luma;
+    bool ok = nuvioLumaFromScreenshot(result, sourceWidth, sourceHeight, maxDimension, luma);
+    mpv_free_node_contents(&result);
+    if (!ok) return nullptr;
+    jbyteArray array = env->NewByteArray(static_cast<jsize>(luma.size()));
+    if (array) env->SetByteArrayRegion(array, 0, static_cast<jsize>(luma.size()), reinterpret_cast<const jbyte *>(luma.data()));
+    return array;
+}
