+    /** Custom Stretch picture area (null = stretch the whole frame). */
+    fun setCustomStretchContent(rect: VideoContentRect?) {
+        customStretchTransform = rect?.toMpvStretchTransform() ?: MpvStretchTransform.Identity
+        if (rememberedResizeMode != PlayerResizeMode.CustomStretch) return
+        handle.takeIf { it != 0L }?.let { applyVideoTransform(it, customStretchTransform) }
+    }
+
+    private fun applyVideoTransform(current: Long, transform: MpvStretchTransform) {
+        runCatching {
+            NativePlayerBridge.setVideoTransform(current, transform.scaleX, transform.scaleY, transform.panX, transform.panY)
+        }
+    }
+
+    /** Picture area of the current decoded frame, or null when there is no usable frame. */
+    fun sampleCustomStretchContent(): VideoContentRect? {
+        val current = handle.takeIf { it != 0L } ?: return null
+        val raw = runCatching {
+            NativePlayerBridge.sampleVideoLuma(current, BlackBarTracker.SAMPLE_MAX_DIMENSION)
+        }.getOrNull() ?: return null
+        if (raw.size <= 4) return null
+        val width = (raw[0].toInt() and 0xFF) or ((raw[1].toInt() and 0xFF) shl 8)
+        val height = (raw[2].toInt() and 0xFF) or ((raw[3].toInt() and 0xFF) shl 8)
+        if (width <= 0 || height <= 0 || raw.size < 4 + width * height) return null
+        return LumaFrame(raw.copyOfRange(4, 4 + width * height), width, height).detectContent()
+    }
