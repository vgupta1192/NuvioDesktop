@@ -0,0 +1,256 @@
+package com.nuvio.app.features.player
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.rememberUpdatedState
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.isActive
+import kotlin.math.abs
+import kotlin.math.max
+import kotlin.math.min
+
+/**
+ * Custom Stretch: find the black bars that are baked into the video frame (letterbox,
+ * pillarbox or both) and stretch only the picture area over the whole screen.
+ *
+ * Plain "Stretch" scales the decoded frame to the screen, so bars inside the file stay
+ * visible. Custom Stretch samples frames, measures the area that holds picture and maps
+ * that area to the full player size. Nothing inside the picture area is cropped: the
+ * detected area only grows (union of all samples), so a dark scene can never make the
+ * picture smaller.
+ */
+
+/** Picture area inside the decoded frame, as fractions (0..1) of the frame size. */
+data class VideoContentRect(
+    val left: Float,
+    val top: Float,
+    val right: Float,
+    val bottom: Float,
+) {
+    val width: Float get() = right - left
+    val height: Float get() = bottom - top
+
+    fun union(other: VideoContentRect): VideoContentRect = VideoContentRect(
+        left = min(left, other.left),
+        top = min(top, other.top),
+        right = max(right, other.right),
+        bottom = max(bottom, other.bottom),
+    )
+
+    fun isCloseTo(other: VideoContentRect, tolerance: Float = 0.004f): Boolean =
+        abs(left - other.left) <= tolerance &&
+            abs(top - other.top) <= tolerance &&
+            abs(right - other.right) <= tolerance &&
+            abs(bottom - other.bottom) <= tolerance
+
+    companion object {
+        val Full = VideoContentRect(0f, 0f, 1f, 1f)
+    }
+}
+
+/**
+ * mpv geometry for a picture area, used with `keepaspect=no`: `video-scale-x/y` enlarge the
+ * frame so the picture area covers the window and `video-pan-x/y` move the picture area to the
+ * window center. mpv clips the result to the window, so subtitles stay on screen.
+ */
+data class MpvStretchTransform(
+    val scaleX: Double,
+    val scaleY: Double,
+    val panX: Double,
+    val panY: Double,
+) {
+    companion object {
+        val Identity = MpvStretchTransform(1.0, 1.0, 0.0, 0.0)
+    }
+}
+
+/**
+ * Map a picture area measured on the rendered output (what is on screen while [transform] is
+ * active with `keepaspect=no`) back to frame fractions, clipped to the frame.
+ */
+fun VideoContentRect.mapFromScreen(transform: MpvStretchTransform): VideoContentRect {
+    fun frameX(x: Float) = ((x - 0.5) / transform.scaleX + 0.5 - transform.panX).toFloat().coerceIn(0f, 1f)
+    fun frameY(y: Float) = ((y - 0.5) / transform.scaleY + 0.5 - transform.panY).toFloat().coerceIn(0f, 1f)
+    return VideoContentRect(frameX(left), frameY(top), frameX(right), frameY(bottom))
+}
+
+/** Bars of letterboxed and pillarboxed video are centered. Use the thicker bar on both sides. */
+fun VideoContentRect.symmetric(): VideoContentRect {
+    val horizontal = max(left, 1f - right)
+    val vertical = max(top, 1f - bottom)
+    return VideoContentRect(horizontal, vertical, 1f - horizontal, 1f - vertical)
+}
+
+/** A downscaled luma (0..255) picture of one video frame. */
+class LumaFrame(val luma: ByteArray, val width: Int, val height: Int) {
+    fun detectContent(): VideoContentRect? = BlackBarDetector.detect(luma, width, height)
+}
+
+fun VideoContentRect.toMpvStretchTransform(): MpvStretchTransform {
+    if (width <= 0f || height <= 0f) return MpvStretchTransform.Identity
+    return MpvStretchTransform(
+        scaleX = 1.0 / width,
+        scaleY = 1.0 / height,
+        panX = 0.5 - (left + right) / 2.0,
+        panY = 0.5 - (top + bottom) / 2.0,
+    )
+}
+
+object BlackBarDetector {
+    /** Luma (0..255) above this value counts as picture. Limited-range black is 16. */
+    private const val LUMA_LIMIT = 30
+
+    /** A row or column holds picture when this fraction of its pixels is above [LUMA_LIMIT]. */
+    private const val LINE_CONTENT_FRACTION = 0.02f
+
+    /** Bars thinner than this fraction of the frame are ignored (no visible gain, avoids jitter). */
+    private const val MIN_BAR_FRACTION = 0.006f
+
+    /** A sample whose picture is smaller than this is a dark scene or a logo, not the picture area. */
+    private const val MIN_CONTENT_WIDTH = 0.45f
+    private const val MIN_CONTENT_HEIGHT = 0.35f
+
+    /**
+     * Measure the picture area in one luma sample ([width] x [height], row stride [stride]).
+     * Returns null when the sample is too dark to tell (black frame, fade, dark scene).
+     */
+    fun detect(luma: ByteArray, width: Int, height: Int, stride: Int = width): VideoContentRect? {
+        if (width < 8 || height < 8 || luma.size < stride * (height - 1) + width) return null
+
+        val rowThreshold = max(2, (width * LINE_CONTENT_FRACTION).toInt())
+        var top = -1
+        var bottom = -1
+        for (y in 0 until height) {
+            if (countBright(luma, y * stride, 1, width) >= rowThreshold) {
+                if (top < 0) top = y
+                bottom = y
+            }
+        }
+        if (top < 0) return null
+
+        val rows = bottom - top + 1
+        val columnThreshold = max(2, (rows * LINE_CONTENT_FRACTION).toInt())
+        var left = -1
+        var right = -1
+        for (x in 0 until width) {
+            if (countBright(luma, top * stride + x, stride, rows) >= columnThreshold) {
+                if (left < 0) left = x
+                right = x
+            }
+        }
+        if (left < 0) return null
+
+        var rect = VideoContentRect(
+            left = left.toFloat() / width,
+            top = top.toFloat() / height,
+            right = (right + 1).toFloat() / width,
+            bottom = (bottom + 1).toFloat() / height,
+        )
+        rect = rect.copy(
+            left = if (rect.left < MIN_BAR_FRACTION) 0f else rect.left,
+            top = if (rect.top < MIN_BAR_FRACTION) 0f else rect.top,
+            right = if (1f - rect.right < MIN_BAR_FRACTION) 1f else rect.right,
+            bottom = if (1f - rect.bottom < MIN_BAR_FRACTION) 1f else rect.bottom,
+        )
+        if (rect.width < MIN_CONTENT_WIDTH || rect.height < MIN_CONTENT_HEIGHT) return null
+        return rect
+    }
+
+    /** Luma of packed 0xAARRGGBB pixels (Android Bitmap), BT.601 weights. */
+    fun lumaFromArgb(pixels: IntArray, width: Int, height: Int): ByteArray {
+        val out = ByteArray(width * height)
+        for (i in 0 until min(pixels.size, out.size)) {
+            val c = pixels[i]
+            val r = (c shr 16) and 0xFF
+            val g = (c shr 8) and 0xFF
+            val b = c and 0xFF
+            out[i] = ((r * 77 + g * 150 + b * 29) shr 8).toByte()
+        }
+        return out
+    }
+
+    private fun countBright(luma: ByteArray, start: Int, step: Int, count: Int): Int {
+        var bright = 0
+        var index = start
+        repeat(count) {
+            if ((luma[index].toInt() and 0xFF) > LUMA_LIMIT) bright++
+            index += step
+        }
+        return bright
+    }
+}
+
+/**
+ * Collects samples for one title and decides when the stretch geometry changes.
+ * The picture area is the union of all valid samples, so it only grows.
+ */
+class BlackBarTracker {
+    private var union: VideoContentRect? = null
+    private var validSamples = 0
+    private var committed: VideoContentRect? = null
+
+    /** Sample faster until the first few valid samples are in. */
+    val isCalibrating: Boolean get() = validSamples < CALIBRATION_SAMPLES
+
+    val current: VideoContentRect? get() = committed
+
+    fun reset() {
+        union = null
+        validSamples = 0
+        committed = null
+    }
+
+    /** Feed one sample. Returns the new picture area when it changed, else null. */
+    fun offer(sample: VideoContentRect?): VideoContentRect? {
+        if (sample == null) return null
+        validSamples++
+        val merged = union?.union(sample) ?: sample
+        union = merged
+        if (validSamples < CALIBRATION_SAMPLES) return null
+        val previous = committed
+        if (previous != null && previous.isCloseTo(merged)) return null
+        committed = merged
+        return merged
+    }
+
+    companion object {
+        const val CALIBRATION_SAMPLES = 3
+        const val CALIBRATION_INTERVAL_MS = 1_200L
+        const val STEADY_INTERVAL_MS = 8_000L
+        const val FIRST_SAMPLE_DELAY_MS = 800L
+
+        /** Longest side of the sampled frame. Enough to place bar edges within ~0.3%. */
+        const val SAMPLE_MAX_DIMENSION = 320
+    }
+}
+
+/**
+ * Runs the Custom Stretch sampling loop while [enabled]. [sample] returns the picture area of
+ * the current frame (null when it cannot tell). [onContentRect] receives null when sampling
+ * starts (plain stretch of the whole frame) and then every new picture area.
+ * The loop restarts, with a fresh tracker, when [sourceKey] changes.
+ */
+@Composable
+fun CustomStretchSamplingEffect(
+    enabled: Boolean,
+    sourceKey: Any?,
+    sample: suspend () -> VideoContentRect?,
+    onContentRect: (VideoContentRect?) -> Unit,
+) {
+    val latestSample = rememberUpdatedState(sample)
+    val latestOnContentRect = rememberUpdatedState(onContentRect)
+    LaunchedEffect(enabled, sourceKey) {
+        latestOnContentRect.value(null)
+        if (!enabled) return@LaunchedEffect
+        val tracker = BlackBarTracker()
+        delay(BlackBarTracker.FIRST_SAMPLE_DELAY_MS)
+        while (isActive) {
+            val rect = runCatching { latestSample.value() }.getOrNull()
+            tracker.offer(rect)?.let { latestOnContentRect.value(it) }
+            delay(
+                if (tracker.isCalibrating) BlackBarTracker.CALIBRATION_INTERVAL_MS
+                else BlackBarTracker.STEADY_INTERVAL_MS,
+            )
+        }
+    }
+}
