+bool resolveScreenshotApi(mpv_command_ret_fn &commandRet, mpv_free_node_contents_fn &freeNode) {
+    static std::once_flag once;
+    static mpv_command_ret_fn resolvedCommandRet = nullptr;
+    static mpv_free_node_contents_fn resolvedFreeNode = nullptr;
+    std::call_once(once, []() {
