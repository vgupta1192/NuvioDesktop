+// Custom Stretch: mpv video-crop value for a picture area given as frame fractions, in source
+// pixels. mpv ignores video-zoom/scale/pan with keepaspect=no, so the black bars are cropped
+// and keepaspect=no stretches the rest. Edges are rounded outward so no picture is lost.
+// Returns "" (no crop) for the whole frame.
+static std::string nuvioVideoCrop(int64_t width, int64_t height, double left, double top, double right, double bottom) {
+    if (width <= 0 || height <= 0) return "";
+    int64_t x0 = std::max<int64_t>(0, std::min<int64_t>(width - 1, static_cast<int64_t>(std::floor(left * width))));
+    int64_t y0 = std::max<int64_t>(0, std::min<int64_t>(height - 1, static_cast<int64_t>(std::floor(top * height))));
+    int64_t x1 = std::max<int64_t>(x0 + 1, std::min<int64_t>(width, static_cast<int64_t>(std::ceil(right * width))));
+    int64_t y1 = std::max<int64_t>(y0 + 1, std::min<int64_t>(height, static_cast<int64_t>(std::ceil(bottom * height))));
+    if (x0 == 0 && y0 == 0 && x1 == width && y1 == height) return "";
+    return std::to_string(x1 - x0) + "x" + std::to_string(y1 - y0) + "+" + std::to_string(x0) + "+" + std::to_string(y0);
+}
+
+// Custom Stretch: downscale a screenshot-raw result (bgr0) to luma for black bar detection.
+// Output layout: width and height as little-endian uint16, a flag byte (1 when the screenshot is
+// only the video-crop region, i.e. smaller than the source), then width * height luma bytes.
+static bool nuvioLumaFromScreenshot(const mpv_node &result, int64_t sourceWidth, int64_t sourceHeight,
+                                    int maxDimension, std::vector<uint8_t> &out) {
+    if (result.format != MPV_FORMAT_NODE_MAP || !result.u.list || maxDimension <= 0) return false;
+    int64_t width = 0, height = 0, stride = 0;
+    const char *format = "bgr0";
+    const uint8_t *pixels = nullptr;
+    size_t pixelBytes = 0;
+    const mpv_node_list *list = result.u.list;
+    for (int i = 0; i < list->num; i++) {
+        const char *key = list->keys ? list->keys[i] : nullptr;
+        if (!key) continue;
+        const mpv_node &value = list->values[i];
+        if (std::strcmp(key, "w") == 0 && value.format == MPV_FORMAT_INT64) width = value.u.int64;
+        else if (std::strcmp(key, "h") == 0 && value.format == MPV_FORMAT_INT64) height = value.u.int64;
+        else if (std::strcmp(key, "stride") == 0 && value.format == MPV_FORMAT_INT64) stride = value.u.int64;
+        else if (std::strcmp(key, "format") == 0 && value.format == MPV_FORMAT_STRING && value.u.string) format = value.u.string;
+        else if (std::strcmp(key, "data") == 0 && value.format == MPV_FORMAT_BYTE_ARRAY && value.u.ba) {
+            pixels = static_cast<const uint8_t *>(value.u.ba->data);
+            pixelBytes = value.u.ba->size;
+        }
+    }
+    if (std::strcmp(format, "bgr0") != 0 || width <= 0 || height <= 0 || stride < width * 4 || !pixels ||
+        pixelBytes < static_cast<size_t>(stride * height)) {
+        return false;
+    }
+    bool cropped = sourceWidth > 0 && sourceHeight > 0 && (width != sourceWidth || height != sourceHeight);
+    double scale = std::min(1.0, static_cast<double>(maxDimension) / static_cast<double>(std::max(width, height)));
+    int outWidth = std::max(8, static_cast<int>(std::lround(static_cast<double>(width) * scale)));
+    int outHeight = std::max(8, static_cast<int>(std::lround(static_cast<double>(height) * scale)));
+    out.assign(5 + static_cast<size_t>(outWidth) * outHeight, 0);
+    out[0] = static_cast<uint8_t>(outWidth & 0xFF);
+    out[1] = static_cast<uint8_t>((outWidth >> 8) & 0xFF);
+    out[2] = static_cast<uint8_t>(outHeight & 0xFF);
+    out[3] = static_cast<uint8_t>((outHeight >> 8) & 0xFF);
+    out[4] = cropped ? 1 : 0;
+    for (int y = 0; y < outHeight; y++) {
+        int64_t sourceY = std::min<int64_t>(height - 1, (y * height + height / 2) / outHeight);
+        const uint8_t *row = pixels + sourceY * stride;
+        for (int x = 0; x < outWidth; x++) {
+            int64_t sourceX = std::min<int64_t>(width - 1, (x * width + width / 2) / outWidth);
+            const uint8_t *pixel = row + sourceX * 4;
+            out[5 + static_cast<size_t>(y) * outWidth + x] =
+                static_cast<uint8_t>((pixel[2] * 77 + pixel[1] * 150 + pixel[0] * 29) >> 8);
+        }
+    }
+    return true;
+}
