+JNIEXPORT jboolean JNICALL NP(setVideoCrop)(JNIEnv *, jobject, jlong handle, jdouble left, jdouble top,
+                                            jdouble right, jdouble bottom) {
+    Player *p = asPlayer(handle);
+    if (!p || !p->mpv) return JNI_FALSE;
+    int64_t width = nuvioInt64Property(p->mpv, "video-params/w");
+    int64_t height = nuvioInt64Property(p->mpv, "video-params/h");
