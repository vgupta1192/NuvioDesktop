+            java.nio.file.Files.createDirectories(dir)
+            dir.resolve(if (anime) "anime.glsl" else "sharpen.glsl")
+        }.getOrNull() ?: return
+        runCatching { java.nio.file.Files.writeString(target, shader) } ?: return
+        // Re-set through empty so mpv reloads an overwritten file.
+        setLocked("glsl-shaders", "")
