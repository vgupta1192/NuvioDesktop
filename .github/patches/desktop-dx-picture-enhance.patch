diff --git a/composeApp/src/desktopMain/resources/player-ui/dx-enhance.glsl b/composeApp/src/desktopMain/resources/player-ui/dx-enhance.glsl
new file mode 100644
index 00000000..bb759ce6
--- /dev/null
+++ b/composeApp/src/desktopMain/resources/player-ui/dx-enhance.glsl
@@ -0,0 +1,17 @@
+//!HOOK LUMA
+//!BIND HOOKED
+//!DESC dx.bi picture enhance (line thin + unsharp mask)
+// Ported from the fork's dx.bi picture enhancement: an unsharp mask, plus (Anime preset)
+// pulling line pixels toward their darkest neighbour so lines read thinner and darker.
+vec4 hook() {
+  vec2 pt = HOOKED_pt;
+  vec4 c = HOOKED_tex(HOOKED_pos);
+  vec4 n = HOOKED_tex(HOOKED_pos + vec2(0.0, -pt.y));
+  vec4 s = HOOKED_tex(HOOKED_pos + vec2(0.0, pt.y));
+  vec4 e = HOOKED_tex(HOOKED_pos + vec2(pt.x, 0.0));
+  vec4 w = HOOKED_tex(HOOKED_pos - vec2(pt.x, 0.0));
+  vec4 mn = min(n, min(s, min(e, w)));
+  vec4 blur = (n + s + e + w) * 0.25;
+  vec4 thin = mix(c, min(c, mn), %THIN%);
+  return vec4(thin.rgb + (thin.rgb - blur.rgb) * %SHARPEN%, c.a);
+}
