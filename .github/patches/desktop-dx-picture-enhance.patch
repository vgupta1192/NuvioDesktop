+    private fun applyEnhanceShaderLocked(mode: Int) {
+        val current = handle
+        if (current == 0L) return
+        if (mode <= 0) {
+            setLocked("glsl-shaders", "")
+            return
+        }
+        val anime = mode >= 2
+        val shader = runCatching {
+            val template = NativePlayerBridge::class.java
