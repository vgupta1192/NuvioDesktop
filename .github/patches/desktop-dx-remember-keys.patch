@@ -0,0 +1,66 @@
+package com.nuvio.app.features.player
+
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+
+/**
+ * dx.bi port: remember the playback speed across sessions and let the number keys 0-9 jump to
+ * that fraction of the title. (The desktop player already remembers volume by itself.)
+ * The desktop engine installs [Storage]; elsewhere everything stays default and inert.
+ */
+object DxRemember {
+    interface Storage {
+        fun getBoolean(key: String): Boolean?
+        fun putBoolean(key: String, value: Boolean)
+        fun getFloat(key: String): Float?
+        fun putFloat(key: String, value: Float)
+    }
+
+    private val _rememberSpeed = MutableStateFlow(true)
+    val rememberSpeed: StateFlow<Boolean> = _rememberSpeed.asStateFlow()
+
+    private val _numberKeys = MutableStateFlow(true)
+    val numberKeys: StateFlow<Boolean> = _numberKeys.asStateFlow()
+
+    var storage: Storage? = null
+        private set
+    var available: Boolean = false
+        private set
+
+    /** Last playback speed chosen by the viewer; applied at the start of the next playback. */
+    var savedSpeed: Float = 1f
+        private set
+
+    fun install(storage: Storage) {
+        this.storage = storage
+        available = true
+        _rememberSpeed.value = storage.getBoolean("remember_speed") ?: true
+        _numberKeys.value = storage.getBoolean("number_keys") ?: true
+        savedSpeed = (storage.getFloat("last_speed") ?: 1f).coerceIn(0.25f, 4f)
+    }
+
+    /** Set by the desktop engine; asks it to resend the controls JSON when a toggle flips. */
+    var onChanged: (() -> Unit)? = null
+
+    fun setRememberSpeed(on: Boolean) {
+        _rememberSpeed.value = on
+        storage?.putBoolean("remember_speed", on)
+        onChanged?.invoke()
+    }
+
+    fun setNumberKeys(on: Boolean) {
+        _numberKeys.value = on
+        storage?.putBoolean("number_keys", on)
+        onChanged?.invoke()
+    }
+
+    fun noteSpeed(speed: Float) {
+        if (!_rememberSpeed.value || speed <= 0f) return
+        savedSpeed = speed.coerceIn(0.25f, 4f)
+        storage?.putFloat("last_speed", savedSpeed)
+    }
+
+    /** What a fresh player should start at (1x when remembering is off). */
+    fun speedToApply(): Float = if (_rememberSpeed.value) savedSpeed else 1f
+}
