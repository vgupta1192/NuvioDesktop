+package com.nuvio.app.features.settings
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.nuvio.app.features.player.DxRemember
+
+/** dx.bi port: remember speed across sessions and number-key jumps. Desktop only. */
+@Composable
+internal fun DxRememberSettingsSection(isTablet: Boolean) {
+    if (!DxRemember.available) return
+    val rememberSpeed by DxRemember.rememberSpeed.collectAsStateWithLifecycle()
+    val numberKeys by DxRemember.numberKeys.collectAsStateWithLifecycle()
+    SettingsSection(title = "Keyboard & memory", isTablet = isTablet) {
+        SettingsGroup(isTablet = isTablet) {
+            SettingsSwitchRow(
+                title = "Remember playback speed",
+                description = "Starts the next video at the speed you used last.",
+                checked = rememberSpeed,
+                isTablet = isTablet,
+                onCheckedChange = DxRemember::setRememberSpeed,
+            )
+            SettingsGroupDivider(isTablet = isTablet)
+            SettingsSwitchRow(
+                title = "Number keys 0-9 jump",
+                description = "Press 0-9 while watching to jump to that fraction of the video.",
+                checked = numberKeys,
+                isTablet = isTablet,
+                onCheckedChange = DxRemember::setNumberKeys,
+            )
+        }
+    }
+}
