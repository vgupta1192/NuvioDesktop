+    /** Takes the fresh list only when it holds something new and does not lose links. Returns the new link count. */
+    private fun mergeRefreshedGroup(context: AutoRefreshContext, fresh: AddonStreamGroup): Int {
+        if (fresh.streams.isEmpty()) return 0
+        var added = 0
+        _uiState.update { current ->
+            added = 0
+            if (current.requestToken != context.token) return@update current
+            val old = current.groups.firstOrNull { it.addonId == fresh.addonId }
+            val presented = context.present(fresh)
+            val oldByKey = old?.streams.orEmpty().associateBy { it.refreshKey() }
+            val newKeys = presented.streams.map { it.refreshKey() }.toSet()
+            val oldKeys = oldByKey.keys
+            if (old != null && !(newKeys.size >= oldKeys.size && newKeys != oldKeys)) return@update current
+            added = newKeys.count { it !in oldKeys }
+            // Links that were already there keep their badges and cache status.
+            val merged = presented.copy(
+                streams = presented.streams.map { oldByKey[it.refreshKey()] ?: it },
+                isLoading = false,
+                error = null,
+            )
+            val groups = if (old == null) {
+                current.groups + merged
+            } else {
+                current.groups.map { if (it.addonId == fresh.addonId) merged else it }
+            }
+            current.copy(
+                groups = StreamAutoPlaySelector.orderAddonStreams(
+                    groups = groups,
+                    installedOrder = context.installedOrder,
+                    preferredGroupIds = context.preferredGroupIds,
+                ),
+                activeAddonIds = current.activeAddonIds + merged.addonId,
+            )
         }
+        return added
