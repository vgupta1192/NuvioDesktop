+
+    private suspend fun autoRefreshLoop(context: AutoRefreshContext) {
+        while (true) {
+            delay(AUTO_REFRESH_INTERVAL_MS)
+            val state = _uiState.value
+            if (state.requestToken != context.token) return
+            val idle = !state.isAnyLoading && !state.isDirectAutoPlayFlow && !state.showDirectAutoPlayOverlay &&
+                state.autoPlayStream == null
+            if (!idle) {
+                if (state.autoRefreshPhase != 0) _uiState.update { it.copy(autoRefreshPhase = 0) }
+                continue
+            }
+            _uiState.update { it.copy(autoRefreshPhase = 1) }
+            var roundOk = false
+            var roundAdded = 0
+            try {
+                roundOk = withTimeoutOrNull(AUTO_REFRESH_TIMEOUT_MS) {
+                    val fetched = coroutineScope {
+                        val addonJobs = context.addons.map { addon ->
+                            async {
+                                runCatchingUnlessCancelled {
+                                    val payload = fetchAddonResponseText(
+                                        url = buildAddonResourceUrl(
+                                            manifestUrl = addon.manifest.transportUrl,
+                                            resource = "stream",
+                                            type = context.type,
+                                            id = context.videoId,
+                                        ),
+                                        forceRefresh = true,
+                                    )
+                                    AddonStreamGroup(
+                                        addonName = addon.addonName,
+                                        addonId = addon.addonId,
+                                        streams = StreamParser.parse(
+                                            payload = payload,
+                                            addonName = addon.addonName,
+                                            addonId = addon.addonId,
+                                            addonLogo = addon.manifest.logoUrl,
+                                        ),
+                                    )
+                                }.getOrNull()
+                            }
+                        }
+                        val serverJobs = context.serverLoaders.map { load ->
+                            async { runCatchingUnlessCancelled { load() }.getOrNull() }
+                        }
+                        (addonJobs + serverJobs).awaitAll()
+                    }
+                    fetched.filterNotNull().forEach { roundAdded += mergeRefreshedGroup(context, it) }
+                    true
+                } == true
+            } catch (error: CancellationException) {
+                throw error
+            } catch (_: Throwable) {
+                // A failed refresh keeps the list as it is; the next round tries again.
+            }
+            val finishedAt = Clock.System.now().toEpochMilliseconds()
+            _uiState.update { current ->
+                if (current.requestToken != context.token) {
+                    current
+                } else {
+                    val rounds = current.autoRefreshRounds + 1
+                    current.copy(
+                        autoRefreshPhase = 2,
+                        autoRefreshRounds = rounds,
+                        autoRefreshDryRounds = if (roundAdded > 0) 0 else current.autoRefreshDryRounds + 1,
+                        // Never more than the list holds.
+                        autoRefreshAdded = (current.autoRefreshAdded + roundAdded)
+                            .coerceAtMost(current.groups.sumOf { it.streams.size }),
