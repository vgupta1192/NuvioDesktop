+package com.nuvio.app.features.player.audiosync
+
+/**
+ * Desktop port note: mobile keeps detected speech as a growing [androidMain SpeechTimeline];
+ * here the audio arrives in one-shot sampled windows (see [SpeechAutoSyncEngine]), so only the
+ * speech grid constant and the segment container are needed.
+ */
+
+/** Speech probability grid step: one frame covers [FRAME_DURATION_MS] of media time. */
+internal object SpeechTimeline {
+    const val FRAME_DURATION_MS = 32.0
+}
+
+/** A stretch of the speech timeline: probabilities from [fromFrame] on, NaN where unknown. */
+internal class SpeechSegment(val fromFrame: Int, val probabilities: FloatArray) {
+    val toFrame: Int get() = fromFrame + probabilities.size
+
+    val knownFrames: Int get() = probabilities.count { !it.isNaN() }
+}
