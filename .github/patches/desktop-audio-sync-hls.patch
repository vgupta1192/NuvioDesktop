+package com.nuvio.app.features.player.audiosync
+
+import kotlin.math.abs
+
+/**
+ * Aligns a subtitle's cue timeline against speech intervals sampled from the stream: finds the
+ * constant shift S so that (cue time + S) best overlaps the dialogue heard in the samples.
+ * Binned activity correlation, coarse over the whole window then refined; confidence needs a
+ * clear winner and enough speech to judge.
+ */
+internal object HlsSubtitleAudioAligner {
+    private const val BIN_MS = 100L
+    private const val MAX_SHIFT_MS = 60_000L
+    private const val COARSE_STEP_MS = 200L
+    private const val FINE_RADIUS_MS = 300L
+    private const val FINE_STEP_MS = 25L
+
+    /** Minimum fraction of sampled speech that must sit inside cues at the winning shift. */
+    private const val MIN_SCORE = 0.30
+    /** The winner must beat the runner-up by this much (grid noise otherwise). */
+    private const val MIN_MARGIN = 0.08
+    /** Not enough evidence under this much sampled speech. */
+    private const val MIN_TOTAL_SPEECH_MS = 8_000L
+
+    data class Estimate(val shiftMs: Long, val score: Double, val margin: Double, val confident: Boolean)
+
+    /**
+     * [speechIntervals] are media-time [start, end) pairs from the sampled windows;
+     * [cueStartsMs]/[cueEndsMs] the subtitle's cue intervals (subtitle time).
+     */
+    fun estimate(
+        speechIntervals: List<Pair<Long, Long>>,
+        cueStartsMs: LongArray,
+        cueEndsMs: LongArray,
+    ): Estimate? {
+        val totalSpeech = speechIntervals.sumOf { (a, b) -> b - a }
+        if (totalSpeech < MIN_TOTAL_SPEECH_MS || cueStartsMs.isEmpty()) return null
+        val speechBins = toBins(speechIntervals)
+
+        var best = -1.0
+        var bestShift = 0L
+        var runnerUp = -1.0
+        var shift = -MAX_SHIFT_MS
+        while (shift <= MAX_SHIFT_MS) {
+            val score = scoreAt(speechBins, cueStartsMs, cueEndsMs, shift)
+            if (score > best) {
+                runnerUp = best
+                best = score
+                bestShift = shift
+            } else if (score > runnerUp) {
+                runnerUp = score
+            }
+            shift += COARSE_STEP_MS
+        }
+        // Refine around the coarse winner; keep the coarse runner-up for the margin unless the
+        // refinement produced a neighbour of the winner (then it is the same peak, not a rival).
+        var fineBest = best
+        var fineShift = bestShift
+        var fine = bestShift - FINE_RADIUS_MS
+        while (fine <= bestShift + FINE_RADIUS_MS) {
+            if (abs(fine - bestShift) > COARSE_STEP_MS) {
+                val score = scoreAt(speechBins, cueStartsMs, cueEndsMs, fine)
+                if (score > fineBest) {
+                    fineBest = score
+                    fineShift = fine
+                }
+            }
+            fine += FINE_STEP_MS
+        }
+        val finalScore = maxOf(best, fineBest)
+        val finalShift = if (fineBest > best) fineShift else bestShift
+        // Margin over the best rival peak: the coarse winner when the refinement moved the peak,
+        // otherwise the coarse runner-up (the refinement only touched the winning neighbourhood).
+        val finalMargin = maxOf(0.0, if (fineBest > best) best else runnerUp)
+
+        val confident = finalScore >= MIN_SCORE && finalMargin >= MIN_MARGIN
+        return Estimate(finalShift, finalScore, finalMargin, confident)
+    }
+
+    /** Fraction of sampled speech covered by cues shifted by [shiftMs]. */
+    private fun scoreAt(
+        speechBins: List<Pair<Long, Long>>,
+        cueStartsMs: LongArray,
+        cueEndsMs: LongArray,
+        shiftMs: Long,
+    ): Double {
+        var covered = 0L
+        var total = 0L
+        for ((a, b) in speechBins) {
+            total += b - a
+            var cursor = a
+            // Cue intervals are sorted; binary search the first cue that can cover `cursor`.
+            var index = cueStartsMs.binarySearch(cursor - shiftMs).let { if (it < 0) -it - 2 else it }
+            if (index < 0) index = 0
+            while (index < cueStartsMs.size) {
+                val cueStart = cueStartsMs[index] + shiftMs
+                val cueEnd = cueEndsMs[index] + shiftMs
+                if (cueEnd <= cursor) {
+                    index++
+                    continue
+                }
+                if (cueStart >= b) break
+                val overlapStart = maxOf(cursor, cueStart)
+                val overlapEnd = minOf(b, cueEnd)
+                if (overlapEnd > overlapStart) covered += overlapEnd - overlapStart
+                cursor = overlapEnd
+                if (cursor >= b) break
+                index++
+            }
+        }
+        if (total == 0L) return 0.0
+        return covered.toDouble() / total
+    }
+
+    /** Merges overlapping intervals and sorts them, so the scorer can sweep linearly. */
+    private fun toBins(intervals: List<Pair<Long, Long>>): List<Pair<Long, Long>> {
+        val sorted = intervals.sortedBy { it.first }
+        val merged = ArrayList<Pair<Long, Long>>()
+        for ((a, b) in sorted) {
+            val last = merged.lastOrNull()
+            if (last != null && a <= last.second) {
+                merged[merged.size - 1] = last.first to maxOf(last.second, b)
+            } else {
+                merged += a to b
+            }
+        }
+        return merged
+    }
+}
