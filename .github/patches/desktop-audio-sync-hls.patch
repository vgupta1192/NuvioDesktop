@@ -0,0 +1,116 @@
+package com.nuvio.app.features.player.audiosync
+
+/**
+ * Minimal HLS reader for the desktop audio-sync fallback: enough of M3U8 to find the audio
+ * segments of a VOD — master playlists (variant + audio rendition selection), media playlists
+ * (#EXTINF durations, discontinuities) and nothing else.
+ */
+internal object HlsMediaPlaylist {
+    private val TAG = Regex("^#([A-Z0-9-]+)(:(.*))?$")
+
+    data class Segment(val url: String, val startMs: Long, val durationSec: Double)
+
+    data class Playlist(
+        val segments: List<Segment>,
+        val isVod: Boolean,
+        val durationMs: Long,
+    )
+
+    fun interface Fetcher {
+        /** GET [url] with [headers], returns the response body. Throws on failure. */
+        suspend fun get(url: String, headers: Map<String, String>): String
+    }
+
+    fun isMaster(body: String): Boolean = body.lineSequence().any { it.startsWith("#EXT-X-STREAM-INF") }
+
+    /**
+     * Follows master playlists to a media playlist: an audio rendition when the variants name
+     * one, otherwise the lowest-bandwidth variant (cheapest to download, audio is what we read).
+     */
+    suspend fun resolve(url: String, headers: Map<String, String>, fetcher: Fetcher): Playlist? {
+        var current = url
+        var currentHeaders = headers
+        repeat(3) {
+            val body = try {
+                fetcher.get(current, currentHeaders)
+            } catch (_: Exception) {
+                return null
+            }
+            if (!isMaster(body)) return parse(current, body)
+            val rendition = audioRenditionUri(body)?.let { resolveUrl(current, it) }
+            val variant = lowestBandwidthVariantUri(body)?.let { resolveUrl(current, it) }
+            val next = rendition ?: variant ?: return null
+            current = next
+        }
+        return null
+    }
+
+    fun parse(baseUrl: String, body: String): Playlist? {
+        var isVod = false
+        var startMs = 0L
+        var pendingDuration = -1.0
+        val segments = ArrayList<Segment>()
+        for (raw in body.lineSequence()) {
+            val line = raw.trim()
+            if (line.isEmpty()) continue
+            val match = TAG.find(line) ?: continue
+            when (match.groupValues[1]) {
+                "EXT-X-ENDLIST" -> isVod = true
+                "EXTINF" -> {
+                    pendingDuration = match.groupValues[3].substringBefore(',').trim().toDoubleOrNull() ?: -1.0
+                }
+                "EXT-X-MAP" -> {
+                    // init segment: not audio content, ignore (fMP4 audio plays without it in mpv
+                    // only when segments are self-contained; if the dump fails the spot is skipped)
+                }
+                else -> {}
+            }
+            if (line.startsWith("#")) continue
+            val duration = pendingDuration
+            if (duration < 0.0) continue
+            segments += Segment(resolveUrl(baseUrl, line), startMs, duration)
+            startMs += (duration * 1000.0).toLong()
+            pendingDuration = -1.0
+        }
+        if (segments.isEmpty()) return null
+        return Playlist(segments, isVod, startMs)
+    }
+
+    /** URI of an #EXT-X-MEDIA TYPE=AUDIO entry, if the master names one. */
+    private fun audioRenditionUri(body: String): String? {
+        var pendingUri: String? = null
+        for (raw in body.lineSequence()) {
+            val line = raw.trim()
+            if (line.startsWith("#EXT-X-MEDIA:") && line.contains("TYPE=AUDIO")) {
+                pendingUri = Regex("URI=\"([^\"]+)\"").find(line)?.groupValues?.get(1)
+            }
+        }
+        return pendingUri
+    }
+
+    private fun lowestBandwidthVariantUri(body: String): String? {
+        var best: Pair<Int, String>? = null
+        var pending = -1
+        for (raw in body.lineSequence()) {
+            val line = raw.trim()
+            if (line.startsWith("#EXT-X-STREAM-INF")) {
+                pending = Regex("BANDWIDTH=(\\d+)").find(line)?.groupValues?.get(1)?.toIntOrNull() ?: Int.MAX_VALUE
+            } else if (!line.startsWith("#") && line.isNotBlank() && pending >= 0) {
+                if (best == null || pending < best.first) best = pending to line
+                pending = -1
+            }
+        }
+        return best?.second
+    }
+
+    fun resolveUrl(baseUrl: String, ref: String): String {
+        if (ref.startsWith("http://") || ref.startsWith("https://")) return ref
+        val prefix = baseUrl.substringBeforeLast('/') + "/"
+        return if (ref.startsWith("/")) {
+            val pathEnd = Regex("^([a-z]+://[^/]+)/").find(baseUrl)?.groupValues?.get(1)
+            (pathEnd ?: prefix) + ref
+        } else {
+            prefix + ref
+        }
+    }
+}
