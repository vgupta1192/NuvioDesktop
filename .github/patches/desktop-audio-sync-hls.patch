+++ b/composeApp/src/desktopMain/kotlin/com/nuvio/app/features/player/audiosync/HlsAudioSyncFallback.kt
@@ -0,0 +1,127 @@
+package com.nuvio.app.features.player.audiosync
+
+import com.nuvio.app.features.player.SubtitleSyncCue
+import com.nuvio.app.features.player.autosync.AutoSyncRetimedCue
+import com.nuvio.app.features.player.autosync.AutoSyncSubtitleCueParser
+import com.nuvio.app.features.player.autosync.AutoSyncTimelineRetimeResult
+import java.io.File
+
+/**
+ * Desktop AutoSync audio fallback for HLS: when the cue-reference analysis (V2) finds no
+ * reference, sample the stream's own audio at dialogue-heavy windows (decoded via headless-mpv
+ * [dumpAudioWav]), detect speech, and correlate it with the subtitle's cue activity. Produces
+ * the constant-shift retime result the same attach path V2 uses, or null when the evidence is
+ * too thin to trust.
+ */
+internal object HlsAudioSyncFallback {
+    private const val SPOT_MS = 90_000L
+    private const val SPOT_COUNT = 4
+    private const val SKIP_START_MS = 3 * 60_000L
+    private const val SKIP_END_MS = 6 * 60_000L
+    private const val WINDOW_STEP_MS = 30_000L
+    private const val MIN_SPOT_SEPARATION_MS = 150_000L
+
+    data class Result(val shiftMs: Long, val score: Double, val margin: Double)
+
+    suspend fun run(
+        streamUrl: String,
+        headers: Map<String, String>,
+        subtitleBody: String?,
+        subtitleUrl: String,
+        fetcher: HlsMediaPlaylist.Fetcher = HlsMediaPlaylist.Fetcher { url, hdrs ->
+            fetchText(url, hdrs)
+        },
+        tmpDir: File = File(System.getProperty("java.io.tmpdir"), "nuvio-audiosync"),
+    ): Result? {
+        if (subtitleBody.isNullOrBlank()) return null
+        val cues = AutoSyncSubtitleCueParser.parse(subtitleBody, subtitleUrl)
+        if (cues.size < 6) return null
+        val playlist = HlsMediaPlaylist.resolve(streamUrl, headers, fetcher) ?: return null
+
+        val windows = chooseWindows(cues, playlist.durationMs)
+        if (windows.isEmpty()) return null
+        val spots = HlsAudioSpotSampler.sample(playlist, windows, SPOT_MS, headers, tmpDir)
+        if (spots.isEmpty()) return null
+        val intervals = spots.flatMap { it.intervals }
+        val estimate = HlsSubtitleAudioAligner.estimate(
+            speechIntervals = intervals,
+            cueStartsMs = cues.map { it.startTimeMs }.toLongArray(),
+            cueEndsMs = cues.map { it.endTimeMs }.toLongArray(),
+        ) ?: return null
+        if (!estimate.confident) return null
+        return Result(estimate.shiftMs, estimate.score, estimate.margin)
+    }
+
+    /** Dialogue-dense, well-spread windows; mirrors the mobile spot planner's intent simply. */
+    internal fun chooseWindows(cues: List<SubtitleSyncCue>, durationMs: Long): List<Long> {
+        val from = SKIP_START_MS
+        val to = durationMs - SKIP_END_MS - SPOT_MS
+        if (to <= from) return emptyList()
+        var cursor = from
+        val scored = ArrayList<Pair<Long, Int>>()
+        while (cursor <= to) {
+            val end = cursor + SPOT_MS
+            val count = cues.count { it.startTimeMs >= cursor - 10_000L && it.startTimeMs < end + 10_000L }
+            scored += cursor to count
+            cursor += WINDOW_STEP_MS
+        }
+        val picked = ArrayList<Long>()
+        for ((start, _) in scored.sortedByDescending { it.second }) {
+            if (picked.size >= SPOT_COUNT) break
+            if (picked.all { existing -> kotlin.math.abs(existing - start) >= MIN_SPOT_SEPARATION_MS }) {
+                picked += start
+            }
+        }
+        return picked.sorted()
+    }
+
+    /**
+     * Constant-shift timeline in the shape [PlayerAutoSyncBridge.attachRetimedSubtitle] consumes:
+     * every cue maps original -> original + [shiftMs].
+     */
+    fun constantShiftTimeline(cues: List<SubtitleSyncCue>, shiftMs: Long, score: Double): AutoSyncTimelineRetimeResult {
+        val retimed = cues.map { cue ->
+            AutoSyncRetimedCue(
+                originalStartTimeMs = cue.startTimeMs,
+                originalEndTimeMs = cue.endTimeMs,
+                startTimeMs = cue.startTimeMs + shiftMs,
+                endTimeMs = cue.endTimeMs + shiftMs,
+            )
+        }
+        return AutoSyncTimelineRetimeResult(
+            cues = retimed,
+            groups = emptyList(),
+            targetCoverage = 1.0,
+            referenceCoverage = 1.0,
+            skippedTargetCues = 0,
+            skippedReferenceCues = 0,
+            longestTargetSkipRun = 0,
+            averageGroupCost = 0.0,
+            oneToOneGroups = retimed.size,
+            oneToTwoGroups = 0,
+            twoToOneGroups = 0,
+            oneToThreeGroups = 0,
+            threeToOneGroups = 0,
+            twoToTwoGroups = 0,
+            confident = true,
+            alignmentSource = "audio-hls",
+            alignmentScale = 1.0,
+            alignmentInterceptMs = shiftMs.toDouble(),
+            activityScore = score,
+        )
+    }
+
+    private fun fetchText(url: String, headers: Map<String, String>): String {
+        val connection = java.net.URL(url).openConnection() as java.net.HttpURLConnection
+        return try {
+            connection.connectTimeout = 15_000
+            connection.readTimeout = 20_000
+            connection.instanceFollowRedirects = true
+            for ((k, v) in headers) connection.setRequestProperty(k, v)
+            if (connection.responseCode !in 200..299) throw java.io.IOException("HTTP ${connection.responseCode}")
+            connection.inputStream.bufferedReader().use { it.readText() }
+        } finally {
+            connection.disconnect()
+        }
+    }
+}
