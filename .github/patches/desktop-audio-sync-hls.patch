@@ -0,0 +1,81 @@
+package com.nuvio.app.features.player.audiosync
+
+import kotlin.math.abs
+import kotlin.math.sqrt
+
+/**
+ * Energy voice-activity detector for the desktop audio-sync fallback. Mobile uses Silero; the
+ * desktop fallback only needs "where is dialogue" over 90-second windows, which an adaptive
+ * RMS threshold with hysteresis and hangover does well enough while staying dependency-free.
+ * Input: mono 16 kHz PCM. Output: speech intervals in milliseconds relative to the dump start.
+ */
+internal object RmsVad {
+    const val SAMPLE_RATE = 16_000
+    const val FRAME_MS = 32L
+    const val FRAME_SAMPLES = (SAMPLE_RATE * FRAME_MS / 1000L).toInt() // 512
+
+    /** Speech must exceed this ratio over the noise floor to count as active. */
+    private const val ENTER_FACTOR = 3.0f
+    /** Active frames stay on until energy falls under this ratio for [HANGOVER_FRAMES]. */
+    private const val EXIT_FACTOR = 1.6f
+    private const val HANGOVER_FRAMES = 25 // 0.8 s
+    private const val MIN_SPEECH_FRAMES = 6 // ~190 ms blips dropped
+    private const val MERGE_GAP_FRAMES = 9 // gaps under ~290 ms bridged
+
+    /** Returns [startMs, endMs) pairs relative to the dump start. */
+    fun detect(pcm: FloatArray): List<Pair<Long, Long>> {
+        if (pcm.size < FRAME_SAMPLES) return emptyList()
+        val frames = pcm.size / FRAME_SAMPLES
+        val rms = DoubleArray(frames)
+        for (f in 0 until frames) {
+            var acc = 0.0
+            val base = f * FRAME_SAMPLES
+            for (i in 0 until FRAME_SAMPLES) {
+                val v = pcm[base + i]
+                acc += (v * v).toDouble()
+            }
+            rms[f] = sqrt(acc / FRAME_SAMPLES)
+        }
+        val sorted = rms.copyOf().also { it.sort() }
+        val floor = sorted[(frames * 0.2).toInt().coerceAtMost(frames - 1)].coerceAtLeast(1e-5)
+        val enter = (floor * ENTER_FACTOR).coerceAtLeast(floor + 0.004f)
+        val exit = (floor * EXIT_FACTOR).coerceAtLeast(floor + 0.002f)
+
+        val active = BooleanArray(frames)
+        var hangover = 0
+        for (f in 0 until frames) {
+            if (rms[f] >= enter) {
+                active[f] = true
+                hangover = HANGOVER_FRAMES
+            } else if (hangover > 0 && rms[f] >= exit) {
+                active[f] = true
+                hangover--
+            } else {
+                hangover = 0
+            }
+        }
+        // Collect runs, drop blips, merge small gaps.
+        val runs = ArrayList<IntArray>()
+        var start = -1
+        for (f in 0..frames) {
+            val on = f < frames && active[f]
+            if (on && start < 0) start = f
+            if (!on && start >= 0) {
+                if (f - start >= MIN_SPEECH_FRAMES) runs += intArrayOf(start, f)
+                start = -1
+            }
+        }
+        val merged = ArrayList<IntArray>()
+        for (run in runs) {
+            val last = merged.lastOrNull()
+            if (last != null && run[0] - last[1] <= MERGE_GAP_FRAMES) {
+                last[1] = run[1]
+            } else {
+                merged += run
+            }
+        }
+        return merged.map { (a, b) ->
+            (a * FRAME_MS) to (b * FRAME_MS)
+        }
+    }
+}
diff --git a/composeApp/src/desktopMain/kotlin/com/nuvio/app/features/player/audiosync/SpeechAutoSyncEngine.kt b/composeApp/src/desktopMain/kotlin/com/nuvio/app/features/player/audiosync/SpeechAutoSyncEngine.kt
new file mode 100644
index 000000000..a2496cd6c
--- /dev/null
+++ b/composeApp/src/desktopMain/kotlin/com/nuvio/app/features/player/audiosync/SpeechAutoSyncEngine.kt
@@ -0,0 +1,395 @@
+package com.nuvio.app.features.player.audiosync
+
+import com.nuvio.app.features.player.SubtitleSyncCue
+import com.nuvio.app.features.player.autosync.AutoSyncSubtitleCueParser
+import com.nuvio.app.features.player.autosync.AutoSyncSubtitleHttp
+import java.io.File
+import kotlin.math.abs
+import kotlin.math.roundToLong
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.currentCoroutineContext
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.ensureActive
+import kotlinx.coroutines.withContext
+
+/**
+ * Desktop AutoSync engine, ported from NuvioMobile's speech-based flow: the selected subtitle's
+ * cue timeline says where people talk, so audio is sampled at dialogue-dense spots
+ * ([DialogueSpotPlanner]), decoded with the child-process mpv dump ([AudioDumpProcess] via
+ * [HlsAudioSpotSampler] for HLS, direct seeks for files), turned into a speech grid by [RmsVad],
+ * and correlated against the cues ([SubtitleAudioAligner], FFT over 32 ms frames with the
+ * common frame-rate scales). When the chosen subtitle never fits, the other subtitles in its
+ * language are scored on the same evidence and a better-fitting file wins
+ * ([SubtitleSpeechCandidates]) — the mobile "SWITCHING subtitle X -> Y via speech detection"
+ * behaviour.
+ *
+ * One instance runs per AutoSync request; the caller owns cancellation and the player attach.
+ */
+internal object SpeechAutoSyncEngine {
+    private const val SPOT_COUNT = 6
+
+    /** Why the last run returned null (bubble + log detail); cleared at each run. */
+    @Volatile
+    var lastFailure: String? = null
+
+    /** What the last run actually did, for the mobile-style statistics readout. */
+    data class RunStats(
+        val spotsSampled: Int,
+        val spotsFailed: Int,
+        val spotsPlanned: Int,
+        val listenedSec: Long,
+        val sampledBytes: Long,
+        val elapsedSec: Long,
+        val alternativesTested: Int = 0,
+        val alternativesRuledOut: Int = 0,
+    )
+
+    @Volatile
+    var lastStats: RunStats? = null
+
+    internal const val SPOT_MS = 45_000L
+
+    /** An untimed direct dump of a 45 s window takes seconds when healthy; 90 s catches pathologies. */
+    private const val DIRECT_SPOT_DUMP_TIMEOUT_SEC = 90L
+    private const val MAX_ALTERNATIVES = 6
+    private const val MAX_SUBTITLE_BODY_BYTES = 8 * 1024 * 1024
+
+    /** Playlists are kilobytes; anything bigger is not a playlist (never read it). */
+    private const val MAX_PLAYLIST_BODY_BYTES = 8 * 1024 * 1024
+
+    private val log = co.touchlab.kermit.Logger.withTag("NuvioAutoSync")
+
+    /** An alternative add-on subtitle the engine may switch to. */
+    data class Alternative(
+        val url: String,
+        val language: String,
+        val name: String,
+        val headers: Map<String, String>,
+    )
+
+    data class Request(
+        val streamUrl: String,
+        val streamHeaders: Map<String, String>,
+        val selectedUrl: String,
+        val selectedHeaders: Map<String, String>,
+        /** Body of the selected subtitle, already downloaded by the caller. */
+        val selectedBody: String,
+        /** Alternatives in the selected subtitle's language (selected itself excluded). */
+        val alternatives: List<Alternative>,
+        /** Live playback position in ms, when the player exposes it. */
+        val playPositionMs: (() -> Long?)? = null,
+        /** Starts/stops recording the playing stream's data; false when unsupported. */
+        val streamRecorder: ((path: String?) -> Boolean)? = null,
+    )
+
+    /** A confirmed speech alignment for [subtitleUrl] (the selected one, or a switched-to file). */
+    data class Locked(
+        val subtitleUrl: String,
+        val label: String,
+        val scale: Double,
+        val shiftMs: Double,
+        val peak: Double,
+        val switched: Boolean,
+        val cues: List<SubtitleSyncCue>,
+    )
+
+    /**
+     * Runs the alignment. Returns null when the evidence is too thin to trust for any subtitle;
+     * [onProgress] receives short working texts for the bubble.
+     */
+    suspend fun run(
+        request: Request,
+        onProgress: (String) -> Unit = {},
+    ): Locked? {
+        lastFailure = null
+        lastStats = null
+        val runStartMs = System.currentTimeMillis()
+        val selectedCues = AutoSyncSubtitleCueParser.parse(request.selectedBody, request.selectedUrl)
+        val selectedTrack = SubtitleSpeechTrack.fromCues(
+            selectedCues.map { Triple(it.startTimeMs, it.endTimeMs, it.text) },
+        )
+        if (selectedTrack.size == 0) {
+            lastFailure = "the subtitle has no usable cues"
+            return null
+        }
+
+        val tmpDir = File(System.getProperty("java.io.tmpdir"), "nuvio-audiosync")
+        val playlist = withContext(Dispatchers.IO) {
+            HlsMediaPlaylist.resolve(request.streamUrl, request.streamHeaders) { url, hdrs ->
+                fetchText(url, hdrs)
+            }
+        }
+        if (playlist == null) log.i { "speech sync: not an HLS playlist (sampling direct from the stream URL)" }
+        // Subtitle end ~ film end (credits have no dialogue); only the spot planner uses this.
+        val fallbackDurationMs = (selectedTrack.endsMs.maxOrNull() ?: 0L).let { it + it / 10 } + SPOT_MS
+        val durationMs = playlist?.durationMs?.takeIf { it > 0 } ?: fallbackDurationMs
+        val windows = DialogueSpotPlanner.plan(listOf(selectedTrack), durationMs, SPOT_COUNT, SPOT_MS)
+        log.i {
+            "speech sync: ${selectedTrack.size} dialogue cues, ${durationMs / 1_000}s media, sampling ${windows.size} spots"
+        }
+        SyncLog.i(
+            "speech sync: ${selectedTrack.size} dialogue cues, ${durationMs / 1_000}s media, " +
+                "sampling ${windows.size} spots ${if (playlist != null) "(HLS)" else "(direct)"}",
+        )
+        val spots = ArrayList<HlsAudioSpotSampler.Spot>()
+        var spotsFailed = 0
+
+        fun recordStats(tested: Int = 0, ruledOut: Int = 0) {
+            lastStats = RunStats(
+                spotsSampled = spots.size,
+                spotsFailed = spotsFailed,
+                spotsPlanned = windows.size,
+                listenedSec = spots.size * (SPOT_MS / 1000),
+                sampledBytes = spots.sumOf { it.bytes },
+                elapsedSec = (System.currentTimeMillis() - runStartMs) / 1000,
+                alternativesTested = tested,
+                alternativesRuledOut = ruledOut,
+            )
+        }
+
+        fun panelLines(tested: Int? = null, empty: Boolean = false): String {
+            val mb = spots.sumOf { it.bytes } / (1024L * 1024L)
+            val lines = mutableListOf(
+                if (empty) {
+                    "Listened 0s of audio yet"
+                } else {
+                    "Listened ${spots.size * (SPOT_MS / 1000)}s of audio ($mb MB)"
+                },
+            )
+            lines += if (empty) {
+                "Across the film: sampling ${windows.size} dialogue spots"
+            } else {
+                "Across the film: ${spots.size} ok · $spotsFailed failed of ${windows.size} dialogue spots in ${(System.currentTimeMillis() - runStartMs) / 1000}s"
+            }
+            if (tested != null) lines += "Other subtitles: testing $tested"
+            return lines.joinToString("\n")
+        }
+        onProgress("Listening for dialogue…\n" + panelLines(empty = true))
+
+        // With the ao=pcm dump fixed, an untimed direct dump finishes a whole window in
+        // seconds (measured 2.2 s for 45 s of audio), so all planned windows are affordable.
+        val queue = ArrayDeque(windows)
+        while (queue.isNotEmpty()) {
+            currentCoroutineContext().ensureActive()
+            val window = queue.removeFirst()
+            val spotStartMs = System.currentTimeMillis()
+            val spot = withContext(Dispatchers.IO) {
+                if (playlist != null) {
+                    HlsAudioSpotSampler.sampleOne(playlist, window, SPOT_MS, request.streamHeaders, tmpDir)
+                } else {
+                    sampleDirectWindow(request.streamUrl, request.streamHeaders, window, tmpDir)
+                }
+            }
+            val spotSecs = (System.currentTimeMillis() - spotStartMs) / 1000.0
+            if (spot == null) {
+                log.w { "speech sync: spot at ${window / 1_000}s failed to sample" }
+                SyncLog.w("speech sync: spot ${spots.size + 1}/${windows.size} at ${window / 1_000}s failed after ${spotSecs}s")
+                spotsFailed++
+                recordStats()
+                onProgress("Listening for dialogue…\n" + panelLines())
+            } else {
+                spots += spot
+                log.i { "speech sync: spot at ${window / 1_000}s sampled, ${spot.speechMs / 1_000}s of speech" }
+                SyncLog.i(
+                    "speech sync: spot ${spots.size}/${windows.size} at ${window / 1_000}s ok, " +
+                        "${spot.speechMs / 1_000}s of speech (${spotSecs}s)",
+                )
+                recordStats()
+                onProgress("Listening for dialogue… (${spots.size} ok · $spotsFailed failed)\n" + panelLines())
+            }
+            if (spots.size >= 2) {
+                lockedFor(request, selectedCues, selectedTrack, spots, onProgress)?.let { return it }
+            }
+        }
+        if (spots.isEmpty()) {
+            recordStats()
+            lastFailure = "no audio could be sampled from this stream"
+            log.w { "speech sync: no audio could be sampled (HLS playlist=${playlist != null})" }
+            SyncLog.w("speech sync: no audio could be sampled")
+            return null
+        }
+
+        // The chosen subtitle never fit: download the alternatives and score them on the
+        // same evidence.
+        val alternatives = request.alternatives.take(MAX_ALTERNATIVES)
+        if (alternatives.isNotEmpty()) {
+            recordStats(alternatives.size)
+            onProgress("Testing ${alternatives.size} other subtitles…\n" + panelLines(alternatives.size))
+            SyncLog.i("speech sync: selected subtitle never locked; testing ${alternatives.size} alternatives")
+            log.i { "speech sync: selected subtitle never locked on ${spots.size} spots; testing ${alternatives.size} alternatives" }
+            val segments = buildSegments(spots)
+            val prepared = SubtitleAudioAligner.prepare(
+                segments = segments,
+                minShiftMs = -SubtitleSpeechCandidates.MAX_SHIFT_MS,
+                maxShiftMs = SubtitleSpeechCandidates.MAX_SHIFT_MS,
+            )
+            val candidates = if (prepared == null) {
+                emptyList()
+            } else {
+                alternatives.mapNotNull { alternative ->
+                    currentCoroutineContext().ensureActive()
+                    val body = withContext(Dispatchers.IO) {
+                        runCatching {
+                            AutoSyncSubtitleHttp.get(alternative.url, alternative.headers, MAX_SUBTITLE_BODY_BYTES).body
+                        }.getOrNull()
+                    } ?: return@mapNotNull null
+                    val cues = AutoSyncSubtitleCueParser.parse(body, alternative.url)
+                    SubtitleSpeechCandidates.CandidateFile(alternative.url, alternative.name, alternative.headers, cues)
+                }
+            }
+            if (prepared != null && candidates.isNotEmpty()) {
+                val winner = SubtitleSpeechCandidates.pickBest(prepared, segments, candidates, durationMs)
+                recordStats(alternatives.size, if (winner == null) candidates.size else candidates.size - 1)
+                if (winner != null) {
+                    SyncLog.i(
+                        "SWITCHING subtitle ${request.selectedUrl} -> ${winner.url} via speech detection: " +
+                            "scale=${winner.estimate.scale} shift=${winner.estimate.shiftMs.roundToLong()}ms",
+                    )
+                    return Locked(
+                        subtitleUrl = winner.url,
+                        label = winner.name.ifBlank { "another subtitle" },
+                        scale = winner.estimate.scale,
+                        shiftMs = winner.estimate.shiftMs,
+                        peak = winner.estimate.peak,
+                        switched = true,
+                        cues = candidates.first { it.url == winner.url }.cues,
+                    )
+                }
+            }
+        }
+        recordStats(alternatives.size, alternatives.size)
+        lastFailure = "no confident match on ${spots.size} sampled spots"
+        SyncLog.w("speech sync: no subtitle matched the audio (spots=${spots.size})")
+            log.w { "speech sync: no subtitle matched the audio (spots=${spots.size})" }
+        return null
+    }
+
+    /** Lock attempt on the evidence sampled so far; null keeps sampling. */
+    private fun lockedFor(
+        request: Request,
+        selectedCues: List<SubtitleSyncCue>,
+        selectedTrack: SubtitleSpeechTrack,
+        spots: List<HlsAudioSpotSampler.Spot>,
+        onProgress: (String) -> Unit,
+    ): Locked? {
+        val segments = buildSegments(spots)
+        val prepared = SubtitleAudioAligner.prepare(
+            segments = segments,
+            minShiftMs = -SubtitleSpeechCandidates.MAX_SHIFT_MS,
+            maxShiftMs = SubtitleSpeechCandidates.MAX_SHIFT_MS,
+        ) ?: return null
+        val estimate = prepared.estimate(selectedTrack) ?: return null
+        val knownFrames = segments.sumOf { it.knownFrames }
+        if (!SubtitleSpeechCandidates.isLockable(estimate, segments, knownFrames, selectedTrack)) return null
+        SyncLog.i(
+            "subtitle ${request.selectedUrl} locked by speech detection: scale=${estimate.scale} " +
+                "shift=${estimate.shiftMs.roundToLong()}ms peak=%.2f".format(estimate.peak),
+        )
+        onProgress("Found the sync point")
+        return Locked(
+            subtitleUrl = request.selectedUrl,
+            label = "",
+            scale = estimate.scale,
+            shiftMs = estimate.shiftMs,
+            peak = estimate.peak,
+            switched = false,
+            cues = selectedCues,
+        )
+    }
+
+    /** One sampled window as a run of the 32 ms speech grid; unknown frames stay NaN. */
+    private fun buildSegments(spots: List<HlsAudioSpotSampler.Spot>): List<SpeechSegment> {
+        val frameMs = SpeechTimeline.FRAME_DURATION_MS
+        return spots.mapNotNull { spot ->
+            val from = (spot.startMs / frameMs).toInt()
+            val count = (SPOT_MS / frameMs).toInt()
+            val grid = FloatArray(count) // 0.0 = known silence, NaN only outside the dump
+            for ((a, b) in spot.intervals) {
+                val startFrame = ((a - spot.startMs) / frameMs).toInt().coerceIn(0, count)
+                val endFrame = ((b - spot.startMs) / frameMs).toInt().coerceIn(startFrame, count)
+                for (frame in startFrame until endFrame) grid[frame] = 1.0f
+            }
+            SpeechSegment(from, grid)
+        }
+    }
+
+    /** Samples one window of a direct (non-HLS) URL by seeking the headless-mpv dump. */
+    private fun sampleDirectWindow(
+        streamUrl: String,
+        headers: Map<String, String>,
+        startMs: Long,
+        tmpDir: File,
+    ): HlsAudioSpotSampler.Spot? {
+        tmpDir.mkdirs()
+        val wav = File(tmpDir, "nuvio-as-${startMs}.wav")
+        try {
+            wav.delete()
+            val headerLines = headers.map { (k, v) -> "$k: $v" }.toTypedArray()
+            val dumped = runCatching {
+                synchronized(NativeDumpGate) {
+                    AudioDumpProcess.dumpAudioWav(
+                        url = streamUrl,
+                        headerLines = headerLines,
+                        outPath = wav.absolutePath,
+                        startSec = startMs / 1000.0,
+                        endSec = (startMs + SPOT_MS) / 1000.0,
+                        timeoutSec = DIRECT_SPOT_DUMP_TIMEOUT_SEC,
+                    )
+                }
+            }.getOrDefault(false)
+            if (!dumped || !wav.exists() || wav.length() < 800L) return null
+            val pcm = HlsAudioSpotSampler.readWavPcm(wav) ?: return null
+            val intervals = RmsVad.detect(pcm).map { (a, b) -> (a + startMs) to (b + startMs) }
+            val speechMs = intervals.sumOf { (a, b) -> b - a }
+            if (speechMs <= 0) return null
+            return HlsAudioSpotSampler.Spot(startMs, intervals, speechMs, wav.length())
+        } finally {
+            wav.delete()
+            File(wav.path + ".log").delete()
+        }
+    }
+
+    private fun fetchText(url: String, headers: Map<String, String>): String {
+        val connection = java.net.URL(url).openConnection() as java.net.HttpURLConnection
+        return try {
+            connection.connectTimeout = 15_000
+            connection.readTimeout = 20_000
+            connection.instanceFollowRedirects = true
+            for ((k, v) in headers) connection.setRequestProperty(k, v)
+            if (connection.responseCode !in 200..299) throw java.io.IOException("HTTP ${connection.responseCode}")
+            // Only playlist-ish bodies belong here. A direct media file (most Stream Master
+            // links) would otherwise be downloaded WHOLE into a String - the Java-heap OOM on
+            // movie-length links. resolve() treats the throw as "not HLS" and the engine
+            // samples the stream URL directly with the mpv dump instead.
+            val contentType = (connection.contentType ?: "").substringBefore(';').trim().lowercase()
+            if (contentType.startsWith("video/") || contentType.startsWith("audio/") ||
+                contentType == "application/octet-stream"
+            ) {
+                throw java.io.IOException("binary body ($contentType) - not a playlist")
+            }
+            val declared = connection.contentLengthLong
+            if (declared > MAX_PLAYLIST_BODY_BYTES) {
+                throw java.io.IOException("playlist body too large ($declared bytes)")
+            }
+            val output = java.io.ByteArrayOutputStream(
+                (declared.takeIf { it > 0 }?.toInt() ?: 64 * 1024).coerceAtMost(MAX_PLAYLIST_BODY_BYTES),
+            )
+            connection.inputStream.use { input ->
+                val buffer = ByteArray(64 * 1024)
+                var total = 0
+                while (true) {
+                    val n = input.read(buffer)
+                    if (n < 0) break
+                    total += n
+                    if (total > MAX_PLAYLIST_BODY_BYTES) {
+                        throw java.io.IOException("playlist body exceeds ${MAX_PLAYLIST_BODY_BYTES / 1024} KiB")
+                    }
+                    output.write(buffer, 0, n)
+                }
+            }
+            output.toString("UTF-8")
+        } finally {
+            connection.disconnect()
+        }
+    }
+}
