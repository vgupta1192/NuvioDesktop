@@ -0,0 +1,183 @@
+package com.nuvio.app.features.player.audiosync
+
+import kotlin.math.abs
+
+/**
+ * The other subtitles in the chosen subtitle's language, scored against one prepared transform of
+ * the sampled speech so a file that fits the audio can replace one that never will (another cut,
+ * another frame rate, a badly timed rip). Desktop port of NuvioMobile's SubtitleCandidatePool
+ * speech path: the pool scores candidates incrementally while playback listens; here the audio
+ * evidence is complete before scoring starts, so one pass over the files is enough.
+ *
+ * Checks mirror the mobile pool: copies of each other (same timing fingerprint) are dropped, files
+ * whose length cannot span the video at any common frame rate are dropped, and a file wins only
+ * when it meets the same confirmation rules as a normal lock ([isLockable], including the
+ * both-halves check that a chance alignment rarely survives).
+ */
+internal object SubtitleSpeechCandidates {
+    const val MAX_SHIFT_MS = 60_000.0
+
+    private const val MIN_CUES = 20
+    private val FRAMES_PER_SECOND = 1_000.0 / SpeechTimeline.FRAME_DURATION_MS
+    private const val ACCEPT_PROMINENCE = 0.12
+    private const val NON_STANDARD_RATE_PENALTY = 0.04
+    private const val MIN_SPEECH_SECONDS = 12.0
+    private const val MIN_HALF_CUES = 8
+    private const val HALF_AGREEMENT_MS = 400.0
+
+    /** A file for this video covers at least this share of it (end credits have no dialogue). */
+    private const val MIN_LENGTH_COVERAGE = 0.5
+
+    /** A lock needs at least this much known audio (60 s of frames). */
+    private val MIN_KNOWN_FRAMES = (60 * FRAMES_PER_SECOND).toInt()
+
+    data class Winner(
+        val url: String,
+        val name: String,
+        val headers: Map<String, String>,
+        val estimate: SubtitleAudioAligner.Estimate,
+    )
+
+    /** An alternative subtitle downloaded and parsed, ready to be scored. */
+    data class CandidateFile(
+        val url: String,
+        val name: String,
+        val headers: Map<String, String>,
+        val cues: List<com.nuvio.app.features.player.SubtitleSyncCue>,
+    )
+
+    /**
+     * Scores every alternative against [prepared]; returns the one confirmed to fit the audio with
+     * the strongest peak, or null. Candidates are filtered before scoring: identical timing to
+     * another file, or a length no common frame rate can stretch to [durationMs].
+     */
+    fun pickBest(
+        prepared: SubtitleAudioAligner.PreparedSpeech,
+        segments: List<SpeechSegment>,
+        candidates: List<CandidateFile>,
+        durationMs: Long,
+    ): Winner? {
+        val knownFrames = segments.sumOf { it.knownFrames }
+        if (knownFrames < MIN_KNOWN_FRAMES) return null
+        val seenFingerprints = HashSet<Long>()
+        var best: Pair<CandidateFile, SubtitleAudioAligner.Estimate>? = null
+        var ruledOut = 0
+        for (candidate in candidates) {
+            val track = SubtitleSpeechTrack.fromCues(
+                candidate.cues.map { Triple(it.startTimeMs, it.endTimeMs, it.text) },
+            )
+            if (track.size < MIN_CUES || !seenFingerprints.add(fingerprint(track))) {
+                ruledOut++
+                continue
+            }
+            val scales = fittingScales(track, durationMs)
+            if (scales.isEmpty()) {
+                SyncLog.i("candidate ${candidate.url} ruled out: ends at ${track.endsMs.max() / 1_000}s, video ${durationMs / 1_000}s")
+                ruledOut++
+                continue
+            }
+            val estimate = prepared.estimate(track, scales) ?: continue
+            if (isLockable(estimate, segments, knownFrames, track) &&
+                (best == null || estimate.peak > best.second.peak)
+            ) {
+                best = candidate to estimate
+            }
+        }
+        if (ruledOut > 0) SyncLog.i("ruled out $ruledOut candidates before scoring")
+        val (candidate, estimate) = best ?: return null
+        SyncLog.i("candidate ${candidate.url} locked by speech detection: $estimate")
+        return Winner(candidate.url, candidate.name, candidate.headers, estimate)
+    }
+
+    /** Frame-rate ratios whose stretch of the file's last cue still covers the video's length. */
+    private fun fittingScales(track: SubtitleSpeechTrack, durationMs: Long): DoubleArray {
+        if (durationMs <= 0) return SubtitleAudioAligner.CANDIDATE_SCALES
+        val lastEndMs = track.endsMs.max()
+        return SubtitleAudioAligner.CANDIDATE_SCALES.filter { scale ->
+            val mappedEndMs = lastEndMs * scale
+            mappedEndMs <= durationMs + MAX_SHIFT_MS && mappedEndMs >= durationMs * MIN_LENGTH_COVERAGE
+        }.toDoubleArray()
+    }
+
+    /**
+     * The confirmation rules a lock must pass: enough known audio and enough dialogue lines at the
+     * peak, a prominence that beats unrelated peaks, and the same shift on both halves of the
+     * evidence (a chance alignment of unrelated subtitles rarely shows up in both).
+     */
+    fun isLockable(
+        estimate: SubtitleAudioAligner.Estimate,
+        segments: List<SpeechSegment>,
+        knownFrames: Int,
+        track: SubtitleSpeechTrack,
+    ): Boolean {
+        val requiredProminence = if (abs(estimate.scale - 1.0) < 0.002) {
+            ACCEPT_PROMINENCE
+        } else {
+            ACCEPT_PROMINENCE + NON_STANDARD_RATE_PENALTY
+        }
+        return knownFrames >= MIN_KNOWN_FRAMES &&
+            estimate.cueCount >= MIN_CUES &&
+            estimate.speechSeconds >= MIN_SPEECH_SECONDS &&
+            !estimate.atSearchEdge &&
+            estimate.prominence >= requiredProminence &&
+            confirmedByBothHalves(segments, estimate, track)
+    }
+
+    private fun confirmedByBothHalves(
+        segments: List<SpeechSegment>,
+        estimate: SubtitleAudioAligner.Estimate,
+        track: SubtitleSpeechTrack,
+    ): Boolean {
+        val halves = splitByKnownFrames(segments)
+        if (halves.size < 2) return false
+        return halves.all { half ->
+            val result = SubtitleAudioAligner.estimate(
+                segments = half,
+                track = track,
+                scales = doubleArrayOf(estimate.scale),
+                minShiftMs = -MAX_SHIFT_MS,
+                maxShiftMs = MAX_SHIFT_MS,
+            )
+            result != null &&
+                !result.atSearchEdge &&
+                result.cueCount >= MIN_HALF_CUES &&
+                abs(result.shiftMs - estimate.shiftMs) <= HALF_AGREEMENT_MS
+        }
+    }
+
+    /** Splits [segments] in time into two parts holding half of the known frames each. */
+    private fun splitByKnownFrames(segments: List<SpeechSegment>): List<List<SpeechSegment>> {
+        val half = segments.sumOf { it.knownFrames } / 2
+        val first = ArrayList<SpeechSegment>()
+        val second = ArrayList<SpeechSegment>()
+        var seen = 0
+        for (segment in segments) {
+            val known = segment.knownFrames
+            when {
+                seen >= half -> second += segment
+                seen + known <= half -> {
+                    first += segment
+                    seen += known
+                }
+                else -> {
+                    // The segment straddling the half point goes to both halves.
+                    val split = known / 2
+                    first += SpeechSegment(segment.fromFrame, segment.probabilities.copyOfRange(0, split))
+                    second += SpeechSegment(
+                        segment.fromFrame + split,
+                        segment.probabilities.copyOfRange(split, known),
+                    )
+                    seen = half
+                }
+            }
+        }
+        return listOf(first, second)
+    }
+
+    /** Identical timing, whatever the text or encoding, means the same file. */
+    private fun fingerprint(track: SubtitleSpeechTrack): Long {
+        var hash = track.size.toLong()
+        for (i in 0 until track.size) hash = hash * 31 + track.startsMs[i] / 100
+        return hash
+    }
+}
