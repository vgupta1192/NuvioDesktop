+package com.nuvio.app.features.player.audiosync
+
+import com.nuvio.app.features.player.desktop.NativePlayerBridge
+import java.io.File
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicBoolean
+import kotlin.system.exitProcess
+
+/**
+ * The native headless-mpv audio dump (generated subtitles + the speech engine) runs in a
+ * short-lived child JVM process instead of inside the app.
+ *
+ * The dump creates a second libmpv core; inside the app's own process that proved fatal on
+ * macOS - the app died the moment a dump ran next to the playing player (subtitle changes and
+ * playback starts were the two triggers), and a native crash cannot be caught from Kotlin. The
+ * child isolates the whole thing: if libmpv crashes or hangs, the child dies alone or is killed
+ * at the timeout, the dump reports false, and AutoSync/generated subtitles degrade to "no audio
+ * could be sampled" instead of taking the player down.
+ */
+internal object AudioDumpProcess {
+    private const val DEFAULT_TIMEOUT_SEC = 180L
+
+    /**
+     * Same contract as [NativePlayerBridge.dumpAudioWav]; blocking (call off the UI thread).
+     * Deliberately NOT a suspend function: callers hold the [NativeDumpGate] monitor across it,
+     * and Kotlin forbids suspension inside a critical section.
+     */
+    fun dumpAudioWav(
+        url: String,
+        headerLines: Array<String>,
+        outPath: String,
+        startSec: Double,
+        endSec: Double,
+        timeoutSec: Long = DEFAULT_TIMEOUT_SEC,
+        realtime: Boolean = false,
+    ): Boolean {
+        val java = javaLauncher()
+        val classpath = System.getProperty("java.class.path")?.takeIf { it.isNotBlank() }
+            ?: codeSourceClasspath()
+        if (java == null || classpath == null) {
+            logModeOnce(
+                "audio dump: IN-PROCESS fallback (${if (java == null) "no bundled java" else "no classpath"}), " +
+                    "bounded at ${timeoutSec + 10}s per dump",
+            )
+            return boundedInProcessDump(url, headerLines, outPath, startSec, endSec, realtime, timeoutSec)
+        }
+        logModeOnce("audio dump: child jvm (timeout=${timeoutSec}s)")
+        val command = mutableListOf(java, "-Xmx96m", "-Djava.awt.headless=true")
+        System.getProperty("compose.application.resources.dir")?.let { command += "-Dcompose.application.resources.dir=$it" }
+        command += listOf(
+            "-cp",
+            classpath,
+            "com.nuvio.app.features.player.audiosync.AudioDumpMain",
+            url,
+            headerLines.joinToString("\n"),
+            outPath,
+            startSec.toString(),
+            endSec.toString(),
+            realtime.toString(),
+        )
+        val process = try {
+            ProcessBuilder(command).redirectErrorStream(true).start()
+        } catch (_: Exception) {
+            return boundedInProcessDump(url, headerLines, outPath, startSec, endSec, realtime, timeoutSec)
+        }
+        // Drain the child's output so a chatty decoder cannot fill the pipe and stall it, and
+        // keep the tail: on failure it carries the mpv log (why no wav was produced).
+        val outputTail = ArrayDeque<String>()
+        val drain = Thread {
+            try {
+                process.inputStream.bufferedReader().forEachLine { line ->
+                    synchronized(outputTail) {
+                        outputTail.addLast(line)
+                        while (outputTail.size > 40) outputTail.removeFirst()
+                    }
+                }
+            } catch (_: Exception) {
+            }
+        }.apply { isDaemon = true; start() }
+        val finished = try {
+            val done = process.waitFor(timeoutSec, TimeUnit.SECONDS)
+            if (!done) {
+                process.destroyForcibly()
+                false
+            } else {
+                true
+            }
+        } catch (_: InterruptedException) {
+            process.destroyForcibly()
+            false
+        } finally {
+            drain.join(1_000)
+        }
+        val ok = finished && process.exitValue() == 0 &&
+            File(outPath).let { it.isFile && it.length() > 44L }
+        if (!ok) {
+            reportFailure(outPath, synchronized(outputTail) { outputTail.toList() })
+        } else {
+            File("$outPath.log").delete()
+        }
+        return ok
+    }
+
+    /**
+     * In-process dump on a watched thread: no usable child runtime (packaged apps can launch
+     * with java.class.path unset), so run the native dump here rather than losing AutoSync -
+     * but bounded, so a stuck native call cannot outlive its budget. An abandoned thread
+     * leaks until mpv gives up - rare, and better than a hung run.
+     */
+    private fun boundedInProcessDump(
+        url: String,
+        headerLines: Array<String>,
+        outPath: String,
+        startSec: Double,
+        endSec: Double,
+        realtime: Boolean,
+        timeoutSec: Long,
+    ): Boolean {
+        val result = AtomicBoolean(false)
+        val worker = Thread {
+            result.set(
+                runCatching {
+                    NativePlayerBridge.ensureLoaded()
+                    NativePlayerBridge.dumpAudioWav(url, headerLines, outPath, startSec, endSec, realtime)
+                }.getOrDefault(false),
+            )
+        }.apply { isDaemon = true; name = "nuvio-audio-dump"; start() }
+        val joined = try {
+            worker.join((timeoutSec + 10) * 1000)
+            true
+        } catch (_: InterruptedException) {
+            false
+        }
+        if (!joined || worker.isAlive) {
+            SyncLog.w("audio dump: abandoned a stuck in-process dump after ${timeoutSec + 10}s")
+            return false
+        }
+        val ok = result.get()
+        if (!ok) reportFailure(outPath, emptyList())
+        return ok
+    }
+
+    /** The why-no-wav evidence: the child's output tail, else the native tail file. */
+    private fun reportFailure(outPath: String, childTail: List<String>) {
+        if (childTail.isNotEmpty()) {
+            SyncLog.w("audio dump failed; child said: " + childTail.takeLast(12).joinToString(" | ").take(600))
+            return
+        }
+        val logFile = File("$outPath.log")
+        val nativeTail = runCatching { if (logFile.isFile) logFile.readText() else null }.getOrNull()
+        if (!nativeTail.isNullOrBlank()) {
+            SyncLog.w("audio dump failed; mpv said: " + nativeTail.replace('\n', ' ').take(600))
+        }
+        logFile.delete()
+    }
+
+    private fun javaLauncher(): String? {
+        val isWindows = System.getProperty("os.name").orEmpty().lowercase().contains("win")
+        val executable = if (isWindows) "java.exe" else "java"
+        System.getProperty("java.home")?.takeIf { it.isNotBlank() }?.let { home ->
+            File(home, "bin/$executable").takeIf(File::isFile)?.let { return it.absolutePath }
+        }
+        // Packaged layouts hide the runtime anywhere under <bundle>/runtime (Contents/Home on
+        // macOS, flat on Windows); search it from both the app jar's directory and the running
+        // executable's, bounded in depth so a pathological tree cannot spin here.
+        for (root in bundleRoots()) {
+            val runtimeDir = File(root, "runtime")
+            if (!runtimeDir.isDirectory) continue
+            val wanted = "bin/$executable"
+            runtimeDir.walkTopDown()
+                .maxDepth(5)
+                .filter { it.isFile && it.invariantSeparatorsPath.endsWith(wanted) }
+                .firstOrNull()
+                ?.let { return it.absolutePath }
+        }
+        return null
+    }
+
+    private fun bundleRoots(): List<File> {
+        val roots = LinkedHashSet<File>()
+        codeSourceClasspath()?.let { cp -> File(cp).parentFile?.parentFile?.let(roots::add) }
+        runCatching {
+            ProcessHandle.current().info().command().orElse(null)
+        }.getOrNull()?.let { cmd ->
+            File(cmd).parentFile?.parentFile?.let(roots::add)
+        }
+        return roots.toList()
+    }
+
+    /**
+     * Packaged launchers may leave java.class.path unset; the jar (or classes dir) this class
+     * was loaded from is a working classpath for the child.
+     */
+    private fun codeSourceClasspath(): String? = runCatching {
+        AudioDumpProcess::class.java.protectionDomain.codeSource.location.toURI().path
+            ?.takeIf { it.isNotBlank() && File(it).exists() }
+    }.getOrNull()
+
+    private val modeAnnounced = AtomicBoolean(false)
+
+    private fun logModeOnce(line: String) {
+        if (!modeAnnounced.compareAndSet(false, true)) return
+        SyncLog.w(line)
+    }
+}
+
+/** Child entry: dump and exit. A native crash here can never reach the app. */
+object AudioDumpMain {
+    @JvmStatic
+    fun main(args: Array<String>) {
+        val ok = try {
+            require(args.size >= 5)
+            val headers = args[1].split('\n').filter { it.isNotBlank() }.toTypedArray()
+            val realtime = args.getOrNull(5)?.toBooleanStrictOrNull() ?: false
+            NativePlayerBridge.ensureLoaded()
+            NativePlayerBridge.dumpAudioWav(
+                url = args[0],
+                headerLines = headers,
+                outPath = args[2],
+                startSec = args[3].toDouble(),
+                endSec = args[4].toDouble(),
+                realtime = realtime,
+            )
+        } catch (_: Throwable) {
+            false
+        }
+        exitProcess(if (ok) 0 else 3)
+    }
+}
