+package com.nuvio.app.features.player.audiosync
+
+import java.io.File
+import java.io.FileOutputStream
+import java.io.RandomAccessFile
+import java.net.HttpURLConnection
+import java.net.URL
+
+/**
+ * Downloads the audio of chosen media-time windows from an HLS VOD and decodes each window to
+ * 16 kHz mono PCM by handing the concatenated segments to [AudioDumpProcess.dumpAudioWav]
+ * (headless mpv decodes any container the player can, so no platform demuxer is needed).
+ */
+/** Nuvio fork: the headless-mpv dump runs one dump at a time - generated subtitles and the
+ *  speech engine share this gate so their dump processes never race. */
+internal val NativeDumpGate = Any()
+
+internal object HlsAudioSpotSampler {
+    private const val CONNECT_TIMEOUT_MS = 15_000
+    private const val READ_TIMEOUT_MS = 30_000
+    private const val MAX_SPOT_BYTES = 96L * 1024 * 1024
+
+    /** A 45 s spot decodes to ~1.4 MB at the dump's 16 kHz mono s16; this only catches a
+     *  dump that ignored its window and wrote the whole film (never read that into memory). */
+    private const val MAX_WAV_BYTES = 64L * 1024 * 1024
+
+    /** One spot's dump must answer inside this budget or the spot is skipped; the engine
+     *  samples 6 spots, so a stuck stream costs 3 minutes total, not 18. */
+    internal const val SPOT_DUMP_TIMEOUT_SEC = 30L
+
+    /** Speech intervals (media ms) found in one sampled window; [bytes] = media bytes read. */
+    data class Spot(
+        val startMs: Long,
+        val intervals: List<Pair<Long, Long>>,
+        val speechMs: Long,
+        val bytes: Long,
+    )
+
+    fun interface SegmentDownloader {
+        /** GET [url] with [headers], APPENDING to [out]; returns bytes written or -1 on failure. */
+        fun download(url: String, headers: Map<String, String>, out: File): Long
+    }
+
+    /**
+     * Samples one window (media ms [startMs], [spotMs] long) from [playlist]. Returns null when
+     * the download or the decode failed.
+     */
+    fun sampleOne(
+        playlist: HlsMediaPlaylist.Playlist,
+        startMs: Long,
+        spotMs: Long,
+        headers: Map<String, String>,
+        tmpDir: File,
+        downloader: SegmentDownloader = defaultDownloader(),
+    ): Spot? {
+        tmpDir.mkdirs()
+        val endMs = startMs + spotMs
+        val parts = playlist.segments.filter {
+            it.startMs < endMs && it.startMs + it.durationSec * 1000.0 > startMs
+        }
+        if (parts.isEmpty()) return null
+        // The first segment usually starts before [startMs]; the dump covers media time from the
+        // segment start, so the lead-in must be trimmed before the speech intervals map to
+        // [startMs]-relative time.
+        val leadInMs = (startMs - parts.first().startMs).coerceAtLeast(0L)
+        val concat = File(tmpDir, "nuvio-as-$startMs.bin")
+        val wav = File(tmpDir, "nuvio-as-$startMs.wav")
+        try {
+            concat.delete()
+            var total = 0L
+            for (part in parts) {
+                val written = runCatching { downloader.download(part.url, headers, concat) }.getOrDefault(-1L)
+                if (written <= 0L) return null
+                total += written
+                if (total > MAX_SPOT_BYTES) return null
+            }
+            if (concat.length() == 0L) return null
+            val dumped = runCatching {
+                synchronized(NativeDumpGate) {
+                    AudioDumpProcess.dumpAudioWav(
+                        url = concat.absolutePath,
+                        headerLines = arrayOf(),
+                        outPath = wav.absolutePath,
+                        startSec = 0.0,
+                        endSec = spotMs / 1000.0,
+                        timeoutSec = SPOT_DUMP_TIMEOUT_SEC,
+                    )
+                }
+            }.getOrDefault(false)
+            if (!dumped || !wav.exists() || wav.length() < 800L) return null
+            val full = readWavPcm(wav) ?: return null
+            val trimSamples = (leadInMs * RmsVad.SAMPLE_RATE / 1000L).toInt()
+            val pcm = if (trimSamples in 1 until full.size) full.copyOfRange(trimSamples, full.size) else full
+            val intervals = RmsVad.detect(pcm).map { (a, b) -> (a + startMs) to (b + startMs) }
+            val speechMs = intervals.sumOf { (a, b) -> b - a }
+            if (speechMs <= 0) return null
+            return Spot(startMs, intervals, speechMs, concat.length())
+        } finally {
+            concat.delete()
+            wav.delete()
+        }
+    }
+
+    fun defaultDownloader(): SegmentDownloader = SegmentDownloader { url, headers, out ->
+        val connection = URL(url).openConnection() as HttpURLConnection
+        try {
+            connection.connectTimeout = CONNECT_TIMEOUT_MS
+            connection.readTimeout = READ_TIMEOUT_MS
+            connection.instanceFollowRedirects = true
+            for ((k, v) in headers) connection.setRequestProperty(k, v)
+            if (connection.responseCode !in 200..299) return@SegmentDownloader -1L
+            var written = 0L
+            connection.inputStream.use { input ->
+                FileOutputStream(out, true).use { output ->
+                    val buf = ByteArray(64 * 1024)
+                    while (true) {
+                        val n = input.read(buf)
+                        if (n < 0) break
+                        output.write(buf, 0, n)
+                        written += n
+                    }
+                }
+            }
+            written
+        } finally {
+            connection.disconnect()
+        }
+    }
+
+    /** Reads a RIFF WAV as mono float samples in [-1, 1]; s16 and float32 formats supported. */
+    fun readWavPcm(file: File): FloatArray? {
+        return try {
+            RandomAccessFile(file, "r").use { raf ->
+                val length = raf.length()
+                if (length < 44) return null
+                var channels = 1
+                var bits = 16
+                var format = 1
+                var dataPos = -1L
+                var dataLen = 0L
+                raf.seek(12)
+                while (raf.filePointer + 8 <= length && dataPos < 0) {
+                    val id = ByteArray(4).also { raf.readFully(it) }.decodeToString()
+                    val size = readLeInt(raf).toLong() and 0xFFFFFFFFL
+                    when (id) {
+                        "fmt " -> {
+                            val fmt = ByteArray(16.coerceAtMost(size.toInt())).also { raf.readFully(it) }
+                            format = le16(fmt, 0)
+                            channels = le16(fmt, 2)
+                            bits = le16(fmt, 14)
+                            raf.seek(raf.filePointer + (size - 16).coerceAtLeast(0) + (size % 2))
+                        }
+                        "data" -> {
+                            dataPos = raf.filePointer
+                            dataLen = size
+                        }
+                        else -> raf.seek(raf.filePointer + size + (size % 2))
+                    }
+                }
+                if (dataPos < 0 || dataLen <= 0) return null
+                if (dataLen > MAX_WAV_BYTES) return null
+                val bytes = ByteArray(dataLen.coerceAtMost(length - dataPos).toInt())
+                raf.seek(dataPos)
+                raf.readFully(bytes)
+                when {
+                    format == 1 && bits == 16 -> {
+                        val frames = bytes.size / 2 / channels
+                        val out = FloatArray(frames)
+                        var i = 0
+                        for (f in 0 until frames) {
+                            var acc = 0
+                            for (c in 0 until channels) {
+                                acc += le16(bytes, i)
+                                i += 2
+                            }
+                            out[f] = (acc / channels - 32768) / 32768f
+                        }
+                        out
+                    }
+                    format == 3 && bits == 32 -> {
+                        val frames = bytes.size / 4 / channels
+                        val out = FloatArray(frames)
+                        var i = 0
+                        for (f in 0 until frames) {
+                            var acc = 0f
+                            for (c in 0 until channels) {
+                                acc += java.lang.Float.intBitsToFloat(readLeIntAt(bytes, i))
+                                i += 4
+                            }
+                            out[f] = acc / channels
+                        }
+                        out
+                    }
+                    else -> null
+                }
+            }
+        } catch (_: Exception) {
+            null
+        }
+    }
+
+    private fun readLeInt(raf: RandomAccessFile): Int {
+        val b = ByteArray(4).also { raf.readFully(it) }
+        return readLeIntAt(b, 0)
+    }
+
+    private fun readLeIntAt(b: ByteArray, i: Int): Int =
+        (b[i].toInt() and 0xFF) or
+            ((b[i + 1].toInt() and 0xFF) shl 8) or
+            ((b[i + 2].toInt() and 0xFF) shl 16) or
+            ((b[i + 3].toInt() and 0xFF) shl 24)
+
+    private fun le16(b: ByteArray, i: Int): Int = (b[i].toInt() and 0xFF) or ((b[i + 1].toInt() and 0xFF) shl 8)
+}
